{%- layout none -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {{ content_for_header }}

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-gift-card color-scheme-1">
    <main id="MainContent" class="gift-card" role="main">
      <header class="gift-card__header">
        <a href="{{ shop.url }}" class="gift-card__shop">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 400 | image_tag: widths: '150, 200, 300, 400', sizes: '200px', alt: shop.name, class: 'gift-card__logo', loading: 'eager' }}
          {%- else -%}
            <span class="h3">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        <h1 class="gift-card__title">{{ 'gift_cards.issued.subtext' | t }}</h1>
      </header>

      <div class="gift-card__card color-scheme-3">
        <img
          src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
          alt=""
          class="gift-card__image"
          height="{{ 570 | divided_by: 1.5 }}"
          width="570"
          loading="eager"
        >
        <div class="gift-card__price">
          <p class="gift-card__balance h2">{{ gift_card.balance | money }}</p>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- endif -%}
        </div>

        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="caption">{{ 'gift_cards.issued.initial_value' | t: value: formatted_initial_value }}</p>
        {%- endif -%}

        {%- if gift_card.expires_on -%}
          {%- assign gift_card_expiry_date = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="caption">
            {%- if gift_card.expired -%}
              {{ 'gift_cards.issued.expired_on' | t: expiry: gift_card_expiry_date }}
            {%- else -%}
              {{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiry_date }}
            {%- endif -%}
          </p>
        {%- endif -%}

        <div class="gift-card__code-wrapper">
          <p class="caption">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
          <p class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
          <button type="button" class="button button--secondary gift-card__copy" data-copy-code="{{ gift_card.code | format_code }}">
            {{- 'gift_cards.issued.copy_code' | t -}}
          </button>
          <p class="visually-hidden" role="status" data-copy-status></p>
        </div>
      </div>

      <div class="gift-card__qr-wrapper">
        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}"></div>
      </div>

      <div class="gift-card__actions">
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift-card__apple-wallet">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
        <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener" aria-describedby="GiftCardNewWindow">
          {{- 'gift_cards.issued.shop_link' | t -}}
        </a>
        <span id="GiftCardNewWindow" class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
        <button type="button" class="link-button gift-card__print" onclick="window.print();">
          {{- 'gift_cards.issued.print_gift_card' | t -}}
        </button>
      </div>
    </main>

    <script>
      window.addEventListener('load', function () {
        var qr = document.getElementById('QrCode');
        if (qr && window.QRCode) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, correctLevel: QRCode.CorrectLevel.H });
        }
      });
      document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-copy-code]');
        if (!button || !navigator.clipboard) return;
        navigator.clipboard.writeText(button.dataset.copyCode).then(function () {
          var status = document.querySelector('[data-copy-status]');
          if (status) status.textContent = {{ 'gift_cards.issued.copy_code_success' | t | json }};
          button.textContent = {{ 'gift_cards.issued.copy_code_success' | t | json }};
        });
      });
    </script>
  </body>
</html>
