<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% render 'meta-tags' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {% render 'css-variables' %}
    {%- capture settings_classes -%}
      {%- if settings.animations_reveal_on_scroll %} animate-reveal{% endif %} hover-{{ settings.animations_hover_effect }} input-style-{{ settings.input_style }} variant-shape-{{ settings.variant_button_shape }} variant-selected-{{ settings.variant_selected_style }}{% unless settings.variant_show_unavailable %} variant-hide-strike{% endunless -%}
    {%- endcapture -%}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          predictiveSearchLimit: {{ settings.predictive_search_product_limit | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          copied: {{ 'general.share.success_message' | t | json }}
        }
      };
    </script>
  </head>

  <body class="template-{{ request.page_type | handle }} {{ settings_classes | strip }}">
    <a class="skip-to-content visually-hidden-focusable" href="#MainContent">
      {{- 'accessibility.skip_to_text' | t -}}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="visually-hidden" aria-live="polite" role="status" data-global-status></div>
  </body>
</html>
