{% comment %} <footer class="site-footer color-{{ section.settings.color_scheme }}">
  {%- if section.blocks.size > 0 -%}
    <div class="page-width site-footer__blocks">
      {%- for block in section.blocks -%}
        <div class="site-footer__block site-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="site-footer__menu list-unstyled" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a class="link-subtle" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
              {% render 'newsletter-form', form_id: block.id %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="page-width site-footer__utilities">
    {%- if section.settings.show_social -%}
      {% render 'social-icons' %}
    {%- endif -%}

    {%- if section.settings.enable_follow_on_shop and shop.features.follow_on_shop? -%}
      <div class="site-footer__follow-on-shop">
        {{ shop | login_button: action: 'follow' }}
      </div>
    {%- endif -%}

    {% render 'localization-form',
      show_country: section.settings.enable_country_selector,
      show_language: section.settings.enable_language_selector,
      id_prefix: 'FooterLocalization'
    %}
  </div>

  <div class="page-width site-footer__bottom">
    <div class="site-footer__legal">
      <small>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
      {%- if section.settings.show_powered_by -%}<small>{{ powered_by_link }}</small>{%- endif -%}
      {%- if section.settings.show_policies -%}
        <ul class="site-footer__policies list-unstyled" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><small><a class="link-subtle" href="{{ policy.url }}">{{ policy.title | escape }}</a></small></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="site-footer__payment">
        <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
        <ul class="payment-icons list-unstyled" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "info": "Add links in Theme settings > Social media.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "Show Follow on Shop",
      "info": "Requires Shop Pay to be enabled. [Learn more](https://help.shopify.com/manual/online-store/themes/customizing-themes/follow-on-shop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "info": "Add policies in Settings > Policies.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": false
    },
    {
      "type": "header",
      "content": "Country/region and language"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country/region selector",
      "info": "Add countries in Settings > Markets.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "info": "Add languages in Settings > Languages.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a short description of your brand with customers.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Subscribers are added to your customer list with email marketing accepted." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join our list" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to hear about new arrivals and seasonal care guides.</p>" }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}





{%- comment -%}
  Modern footer
  Newsletter, link menus, contact details, social icons with tooltips,
  a light/dark switch and a bottom bar with copyright and legal links.
  No font family, size or weight is set here: headings, text, links and
  buttons inherit your theme's styles for the tags you choose.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign fid = 'ft-' | append: section.id
  assign color_keys = 'bg,text,muted,accent,accent_text,border,input_bg' | split: ','
  assign column_tag = s.column_heading_tag | default: 'h3'

  assign has_toggle = false
  for block in section.blocks
    if block.type == 'social' and block.settings.show_mode_toggle
      assign has_toggle = true
    endif
  endfor

  assign start_dark = false
  if s.default_mode == 'dark'
    assign start_dark = true
  endif
-%}

<style>
  #{{ fid }} {
    --ft-cols: {{ s.columns_desktop }};
    --ft-cols-tab: {{ s.columns_tablet }};
    --ft-gap: {{ s.column_gap }}px;
    --ft-max: {{ s.max_width }}px;
    --ft-pt: {{ s.padding_top }}px;
    --ft-pb: {{ s.padding_bottom }}px;
    --ft-radius: {{ s.input_radius }}px;
    {%- for k in color_keys -%}
      {%- assign key = 'light_' | append: k -%}
      {%- assign c = s[key] -%}
      {%- if c != blank and c.alpha != 0 -%}
        {%- case k -%}
          {%- when 'bg' -%}background-color: {{ c }}; --ft-bg: {{ c }};
          {%- when 'text' -%}color: {{ c }};
          {%- else -%}--ft-{{ k | replace: '_', '-' }}: {{ c }};
        {%- endcase -%}
      {%- endif -%}
    {%- endfor %}
  }
  #{{ fid }}.ft--dark {
    {%- for k in color_keys -%}
      {%- assign key = 'dark_' | append: k -%}
      {%- assign c = s[key] -%}
      {%- if c != blank and c.alpha != 0 -%}
        {%- case k -%}
          {%- when 'bg' -%}background-color: {{ c }}; --ft-bg: {{ c }};
          {%- when 'text' -%}color: {{ c }};
          {%- else -%}--ft-{{ k | replace: '_', '-' }}: {{ c }};
        {%- endcase -%}
      {%- endif -%}
    {%- endfor %}
  }
</style>

<style>
  .ft {
    --ft-muted: color-mix(in srgb, currentColor 65%, transparent);
    --ft-accent: currentColor;
    --ft-accent-text: Canvas;
    --ft-border: color-mix(in srgb, currentColor 15%, transparent);
    --ft-input-bg: transparent;
    --ft-bg: Canvas;
    position: relative;
    transition: background-color .3s ease, color .3s ease;
  }
  .ft--border-top { border-top: 1px solid var(--ft-border); }
  .ft *, .ft *::before, .ft *::after { box-sizing: border-box; }

  .ft__container {
    width: 100%;
    margin-inline: auto;
    padding: var(--ft-pt) 1rem var(--ft-pb);
  }
  .ft__container--boxed { max-width: var(--ft-max); }
  @media (min-width: 750px) { .ft__container { padding-inline: 1.5rem; } }
  @media (min-width: 990px) { .ft__container { padding-inline: 2rem; } }

  .ft__grid {
    display: grid;
    gap: var(--ft-gap);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 750px) {
    .ft__grid { grid-template-columns: repeat(var(--ft-cols-tab), minmax(0, 1fr)); }
  }
  @media (min-width: 990px) {
    .ft__grid { grid-template-columns: repeat(var(--ft-cols), minmax(0, 1fr)); }
  }

  .ft__col { position: relative; min-width: 0; }
  .ft__heading { margin: 0 0 1rem; }
  .ft__text { margin: 0 0 1.5rem; color: var(--ft-muted); }
  .ft__text > *:first-child { margin-top: 0; }
  .ft__text > *:last-child { margin-bottom: 0; }

  .ft a { color: inherit; text-decoration: none; transition: color .2s ease; }
  .ft a:hover, .ft a:focus-visible { color: var(--ft-accent); }
  .ft :focus-visible { outline: 2px solid var(--ft-accent); outline-offset: 2px; }

  .ft__sr {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* Newsletter */
  .ft__form { position: relative; }
  .ft__field { position: relative; }
  .ft__input {
    font: inherit;
    color: inherit;
    width: 100%;
    min-height: 2.75rem;
    padding: .5rem 3.25rem .5rem .875rem;
    border: 1px solid var(--ft-border);
    border-radius: var(--ft-radius);
    background: var(--ft-input-bg);
    -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);
  }
  .ft__input::placeholder { color: var(--ft-muted); opacity: 1; }
  .ft__input:focus-visible { outline: 2px solid var(--ft-accent); outline-offset: 1px; }
  .ft__submit {
    position: absolute;
    right: .3rem;
    top: 50%;
    width: 2.125rem;
    height: 2.125rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    border-radius: 999px;
    background: var(--ft-accent);
    color: var(--ft-accent-text);
    cursor: pointer;
    transform: translateY(-50%);
    transition: transform .2s ease, opacity .2s ease;
  }
  .ft__submit:hover { transform: translateY(-50%) scale(1.05); }
  .ft__msg { margin: .75rem 0 0; color: var(--ft-muted); }
  .ft__msg--error { color: #dc2626; }
  .ft__glow {
    position: absolute;
    right: -1rem;
    top: 0;
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    background: var(--ft-accent);
    opacity: .1;
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }

  /* Links */
  .ft__links { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .ft__links a[aria-current="page"] { color: var(--ft-accent); }

  /* Contact */
  .ft__address { font-style: normal; display: grid; gap: .5rem; }
  .ft__address p { margin: 0; }

  /* Social */
  .ft__social { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .ft__social-link {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ft-border);
    border-radius: 999px;
    background: var(--ft-input-bg);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .ft__social-link:hover, .ft__social-link:focus-visible {
    background: color-mix(in srgb, var(--ft-accent) 10%, transparent);
  }
  .ft__icon { width: 1rem; height: 1rem; flex: none; }

  .ft__social-link[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + .5rem);
    left: 50%;
    padding: .35em .75em;
    border-radius: 6px;
    background: var(--ft-accent);
    color: var(--ft-accent-text);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px) scale(.95);
    transition: opacity .15s ease, transform .15s ease;
    z-index: 5;
  }
  .ft__social-link[data-tip]:hover::after,
  .ft__social-link[data-tip]:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  /* Light / dark switch */
  .ft__mode { display: inline-flex; align-items: center; gap: .5rem; }
  .ft__switch {
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 999px;
    background: var(--ft-border);
    cursor: pointer;
    transition: background-color .2s ease;
  }
  .ft__switch[aria-checked="true"] { background: var(--ft-accent); }
  .ft__thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--ft-bg);
    box-shadow: 0 2px 6px rgba(0, 0, 0, .2);
    transition: transform .2s ease;
  }
  .ft__switch[aria-checked="true"] .ft__thumb { transform: translateX(1.25rem); }

  /* Bottom bar */
  .ft__bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: center;
  }
  .ft__bottom--border { border-top: 1px solid var(--ft-border); }
  @media (min-width: 750px) {
    .ft__bottom { flex-direction: row; text-align: left; }
  }
  .ft__copy { margin: 0; color: var(--ft-muted); }
  .ft__copy a { text-decoration: underline; }
  .ft__legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1rem; }
  .ft__payments { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .ft__payments svg { height: 1.5rem; width: auto; display: block; }

  @media (prefers-reduced-motion: reduce) {
    .ft, .ft * { transition: none !important; }
  }
</style>

<footer
  id="{{ fid }}"
  class="ft{% if s.show_top_border %} ft--border-top{% endif %}{% if start_dark %} ft--dark{% endif %}"
>
  <div class="ft__container{% unless s.full_width %} ft__container--boxed{% endunless %}">
    {%- if section.blocks.size > 0 -%}
      <div class="ft__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="ft__col ft__col--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'newsletter' -%}
                {%- assign nl_tag = b.heading_tag | default: 'h2' -%}
                {%- if b.heading != blank -%}
                  <{{ nl_tag }} class="ft__heading">{{ b.heading | escape }}</{{ nl_tag }}>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <div class="ft__text">{{ b.text }}</div>
                {%- endif -%}
                {%- assign form_id = 'FooterNewsletter-' | append: block.id -%}
                {%- form 'customer', id: form_id, class: 'ft__form' -%}
                  <input type="hidden" name="contact[tags]" value="{{ b.tags | default: 'newsletter' | escape }}">
                  <div class="ft__field">
                    <label class="ft__sr" for="{{ form_id }}-email">{{ b.placeholder | escape }}</label>
                    <input
                      id="{{ form_id }}-email"
                      class="ft__input"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      placeholder="{{ b.placeholder | escape }}"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      required
                      {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
                    >
                    <button type="submit" class="ft__submit" aria-label="{{ b.button_label | escape }}">
                      <svg class="ft__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <p id="{{ form_id }}-error" class="ft__msg ft__msg--error" role="alert">
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </p>
                  {%- elsif form.posted_successfully? -%}
                    <p class="ft__msg" role="status">{{ b.success_message | escape }}</p>
                  {%- endif -%}
                {%- endform -%}
                {%- if b.show_glow -%}<div class="ft__glow" aria-hidden="true"></div>{%- endif -%}

              {%- when 'link_list' -%}
                {%- if b.heading != blank -%}
                  <{{ column_tag }} class="ft__heading">{{ b.heading | escape }}</{{ column_tag }}>
                {%- endif -%}
                {%- if b.menu != blank and b.menu.links.size > 0 -%}
                  <nav aria-label="{{ b.heading | default: b.menu.title | escape }}">
                    <ul class="ft__links">
                      {%- for link in b.menu.links -%}
                        <li>
                          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- if b.heading != blank -%}
                  <{{ column_tag }} class="ft__heading">{{ b.heading | escape }}</{{ column_tag }}>
                {%- endif -%}
                <address class="ft__address">
                  {%- if b.address != blank -%}
                    <p>{{ b.address | escape | newline_to_br }}</p>
                  {%- endif -%}
                  {%- if b.phone != blank -%}
                    {%- assign tel = b.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
                    <p>{% if b.phone_label != blank %}{{ b.phone_label | escape }} {% endif %}<a href="tel:{{ tel }}">{{ b.phone | escape }}</a></p>
                  {%- endif -%}
                  {%- if b.email != blank -%}
                    <p>{% if b.email_label != blank %}{{ b.email_label | escape }} {% endif %}<a href="mailto:{{ b.email | escape }}">{{ b.email | escape }}</a></p>
                  {%- endif -%}
                </address>

              {%- when 'text' -%}
                {%- if b.heading != blank -%}
                  <{{ column_tag }} class="ft__heading">{{ b.heading | escape }}</{{ column_tag }}>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <div class="ft__text">{{ b.text }}</div>
                {%- endif -%}

              {%- when 'social' -%}
                {%- if b.heading != blank -%}
                  <{{ column_tag }} class="ft__heading">{{ b.heading | escape }}</{{ column_tag }}>
                {%- endif -%}
                {%- assign networks = 'facebook,twitter,instagram,linkedin,youtube,tiktok' | split: ',' -%}
                <ul class="ft__social">
                  {%- for net in networks -%}
                    {%- liquid
                      assign url_key = 'url_' | append: net
                      assign theme_key = 'social_' | append: net | append: '_link'
                      assign url = b[url_key]
                      if url == blank and b.use_theme_links
                        assign url = settings[theme_key]
                      endif
                      case net
                        when 'facebook'
                          assign label = 'Facebook'
                        when 'twitter'
                          assign label = 'X (Twitter)'
                        when 'instagram'
                          assign label = 'Instagram'
                        when 'linkedin'
                          assign label = 'LinkedIn'
                        when 'youtube'
                          assign label = 'YouTube'
                        when 'tiktok'
                          assign label = 'TikTok'
                      endcase
                      assign tip = b.tooltip_prefix | append: ' ' | append: label | strip
                    -%}
                    {%- if url != blank -%}
                      <li>
                        <a
                          class="ft__social-link"
                          href="{{ url }}"
                          target="_blank"
                          rel="noopener"
                          aria-label="{{ tip | escape }}"
                          {% if b.show_tooltips %}data-tip="{{ tip | escape }}"{% endif %}
                        >
                          <svg class="ft__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            {%- case net -%}
                              {%- when 'facebook' -%}<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                              {%- when 'twitter' -%}<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
                              {%- when 'instagram' -%}<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                              {%- when 'linkedin' -%}<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
                              {%- when 'youtube' -%}<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>
                              {%- when 'tiktok' -%}<path d="M9 12a4 4 0 1 0 4 4V2a5 5 0 0 0 5 5"/>
                            {%- endcase -%}
                          </svg>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

                {%- if b.show_mode_toggle -%}
                  <footer-mode-switch
                    class="ft__mode"
                    data-footer="{{ fid }}"
                    data-default="{{ s.default_mode }}"
                    data-html-class="{% if s.apply_to_page %}{{ s.html_class | escape }}{% endif %}"
                    data-remember="{{ s.remember_mode }}"
                  >
                    <svg class="ft__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                    <button type="button" class="ft__switch" role="switch" aria-checked="{{ start_dark }}" aria-label="{{ b.toggle_label | escape }}">
                      <span class="ft__thumb"></span>
                    </button>
                    <svg class="ft__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                  </footer-mode-switch>
                {%- endif -%}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.show_bottom_bar -%}
      <div class="ft__bottom{% if s.show_bottom_border %} ft__bottom--border{% endif %}">
        {%- if s.copyright != blank or s.show_powered_by -%}
          <p class="ft__copy">
            {%- assign year = 'now' | date: '%Y' -%}
            {{- s.copyright | escape | replace: '[year]', year | replace: '[shop]', shop.name -}}
            {%- if s.show_powered_by %} {{ powered_by_link }}{% endif -%}
          </p>
        {%- endif -%}

        {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="ft__payments" role="list" aria-label="{{ 'Payment methods' }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.legal_menu != blank and s.legal_menu.links.size > 0 -%}
          <nav aria-label="{{ s.legal_menu.title | escape }}">
            <ul class="ft__legal">
              {%- for link in s.legal_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- elsif s.show_policies and shop.policies.size > 0 -%}
          <nav aria-label="Policies">
            <ul class="ft__legal">
              {%- for policy in shop.policies -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{%- if has_toggle -%}
  <script>
    (function () {
      if (customElements.get('footer-mode-switch')) return;
      var KEY = 'footer-color-mode';

      class FooterModeSwitch extends HTMLElement {
        connectedCallback() {
          this.footer = document.getElementById(this.dataset.footer);
          this.btn = this.querySelector('button');
          if (!this.footer || !this.btn) return;

          this.htmlClass = (this.dataset.htmlClass || '').trim();
          this.remember = this.dataset.remember === 'true';

          var saved = null;
          if (this.remember) {
            try { saved = localStorage.getItem(KEY); } catch (e) {}
          }

          var mode = this.dataset.default;
          var dark;
          if (saved === 'dark' || saved === 'light') {
            dark = saved === 'dark';
          } else if (mode === 'system') {
            dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          } else {
            dark = mode === 'dark';
          }
          this.set(dark, false);

          this.onClick = () => this.set(!this.dark, true);
          this.btn.addEventListener('click', this.onClick);
        }

        disconnectedCallback() {
          if (this.btn && this.onClick) this.btn.removeEventListener('click', this.onClick);
        }

        set(dark, save) {
          this.dark = !!dark;
          this.footer.classList.toggle('ft--dark', this.dark);
          this.btn.setAttribute('aria-checked', String(this.dark));
          if (this.htmlClass) document.documentElement.classList.toggle(this.htmlClass, this.dark);
          if (save && this.remember) {
            try { localStorage.setItem(KEY, this.dark ? 'dark' : 'light'); } catch (e) {}
          }
        }
      }

      customElements.define('footer-mode-switch', FooterModeSwitch);
    })();
  </script>
{%- endif -%}

