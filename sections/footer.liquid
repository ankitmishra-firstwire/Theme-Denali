{%- comment -%}
  Footer (advanced)
  - Flexible rows: every block picks its own width; "Row break" and "Divider" blocks shape rows
  - Large wordmark block: full-width logo image or auto-fitted text (solid / outline / fade)
  - Background image (separate mobile image) or looping video, with overlay
  - Full-width or floating-card layout, rounded corners, dividers
  - Collapsible menus on mobile, contact block, image block, app blocks, back-to-top
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign has_media = false
  if s.bg_type == 'image' and s.bg_image != blank
    assign has_media = true
  elsif s.bg_type == 'video' and s.bg_video != blank
    assign has_media = true
  endif

  assign width_class = 'page-width'
  if s.content_width == 'full'
    assign width_class = 'ftx-full'
  endif

  assign show_follow = false
  if s.enable_follow_on_shop and shop.features.follow_on_shop?
    assign show_follow = true
  endif

  assign show_localization = false
  if s.enable_country_selector or s.enable_language_selector
    assign show_localization = true
  endif

  assign show_utilities = false
  if s.show_social or show_follow or show_localization
    assign show_utilities = true
  endif

  assign year = 'now' | date: '%Y'
  assign shop_link = shop.name | link_to: routes.root_url
-%}

{%- capture icon_plus -%}<svg class="ftx-acc__icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}
{%- capture icon_up -%}<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>{%- endcapture -%}
{%- capture icon_pin -%}<svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>{%- endcapture -%}
{%- capture icon_phone -%}<svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>{%- endcapture -%}
{%- capture icon_mail -%}<svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>{%- endcapture -%}
{%- capture icon_clock -%}<svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{%- endcapture -%}

<ftx-footer
  class="ftx ftx--{{ s.layout_style }} ftx--h-{{ s.heading_size }}{% if s.text_alignment == 'center' %} ftx--center{% endif %}{% if s.show_dividers %} ftx--dividers{% endif %}{% if s.text_color != blank %} ftx--custom-text{% endif %}"
  style="
    --ftx-pt: {{ s.padding_top }}px;
    --ftx-pb: {{ s.padding_bottom }}px;
    --ftx-gap: {{ s.column_gap }}px;
    --ftx-radius: {{ s.corner_radius }}px;
    --ftx-inset: {{ s.inset_margin }}px;
    {%- if s.text_color != blank -%}--ftx-text: {{ s.text_color }};{%- endif -%}
  "
>
  <footer class="ftx-surface color-{{ s.color_scheme }} gradient">
    {%- if has_media -%}
      <div class="ftx-media{% if s.bg_type == 'image' and s.bg_image_mobile != blank %} ftx-media--has-mobile{% endif %}" aria-hidden="true">
        {%- if s.bg_type == 'video' -%}
          {{
            s.bg_video
            | video_tag:
              image_size: '1920x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'ftx-media__item'
          }}
        {%- else -%}
          {%- assign focal = 'object-position: ' | append: s.bg_image.presentation.focal_point -%}
          {{
            s.bg_image
            | image_url: width: 2400
            | image_tag:
              widths: '750,1100,1500,1920,2400',
              sizes: '100vw',
              loading: 'lazy',
              alt: '',
              style: focal,
              class: 'ftx-media__item ftx-media__item--desktop'
          }}
          {%- if s.bg_image_mobile != blank -%}
            {%- assign focal_m = 'object-position: ' | append: s.bg_image_mobile.presentation.focal_point -%}
            {{
              s.bg_image_mobile
              | image_url: width: 1100
              | image_tag:
                widths: '375,550,750,1100',
                sizes: '100vw',
                loading: 'lazy',
                alt: '',
                style: focal_m,
                class: 'ftx-media__item ftx-media__item--mobile'
            }}
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="ftx-overlay" style="background: {{ s.overlay_color }}; opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ftx-main">
        <div class="{{ width_class }}">
          <div class="ftx-grid">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="ftx-block ftx-block--app" {{ block.shopify_attributes }}>{% render block %}</div>

                {%- when 'row_break' -%}
                  <div class="ftx-break" {{ block.shopify_attributes }}></div>

                {%- when 'divider' -%}
                  <div
                    class="ftx-divider{% if block.settings.style == 'line' %} ftx-divider--line{% endif %}"
                    style="--ftx-space: {{ block.settings.spacing }}px;"
                    {{ block.shopify_attributes }}
                  ></div>

                {%- when 'wordmark' -%}
                  {%- liquid
                    assign wm = block.settings
                    assign wm_justify = 'center'
                    if wm.alignment == 'left'
                      assign wm_justify = 'flex-start'
                    elsif wm.alignment == 'right'
                      assign wm_justify = 'flex-end'
                    endif
                  -%}
                  <div
                    class="ftx-wordmark ftx-wordmark--{{ wm.style }}{% if wm.animate %} ftx-wordmark--animate{% endif %}"
                    style="
                      --ftx-wm-size: {{ wm.size }}%;
                      --ftx-wm-justify: {{ wm_justify }};
                      --ftx-wm-opacity: {{ wm.opacity | divided_by: 100.0 }};
                      --ftx-wm-mt: {{ wm.margin_top }}px;
                      --ftx-wm-mb: {{ wm.margin_bottom }}px;
                    "
                    {{ block.shopify_attributes }}
                  >
                    {%- if wm.image != blank -%}
                      <div class="ftx-wordmark__inner ftx-wordmark__inner--img">
                        {%- if wm.link != blank -%}<a href="{{ wm.link }}">{%- endif -%}
                        {{
                          wm.image
                          | image_url: width: 3000
                          | image_tag:
                            widths: '750,1100,1500,2000,2500,3000',
                            sizes: '100vw',
                            loading: 'lazy',
                            alt: shop.name,
                            class: 'ftx-wordmark__img'
                        }}
                        {%- if wm.link != blank -%}</a>{%- endif -%}
                      </div>
                    {%- else -%}
                      {%- assign wm_text = wm.text | default: shop.name -%}
                      <div class="ftx-wordmark__inner">
                        <span class="ftx-wordmark__text" data-ftx-fit="{{ wm.size }}">{{ wm_text | escape }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                {%- else -%}
                  <div
                    class="ftx-block ftx-block--{{ block.type }} ftx-w-{{ block.settings.width }} ftx-m-{{ block.settings.width_mobile }}{% if block.type == 'link_list' and s.collapse_mobile and block.settings.heading != blank %} ftx-block--acc{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- case block.type -%}
                      {%- when 'logo' -%}
                        {%- if block.settings.logo != blank -%}
                          {%- liquid
                            assign logo_style = 'width: ' | append: block.settings.logo_width | append: 'px'
                            assign logo_sizes = block.settings.logo_width | append: 'px'
                          -%}
                          <a href="{{ routes.root_url }}" class="ftx-logo">
                            {{
                              block.settings.logo
                              | image_url: width: 600
                              | image_tag:
                                widths: '150,300,450,600',
                                sizes: logo_sizes,
                                loading: 'lazy',
                                alt: shop.name,
                                style: logo_style,
                                class: 'ftx-logo__img'
                            }}
                          </a>
                        {%- else -%}
                          <a href="{{ routes.root_url }}" class="ftx-logo ftx-logo--text">{{ shop.name | escape }}</a>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte ftx-rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                        {%- if block.settings.show_social -%}
                          <div class="ftx-social">{% render 'social-icons' %}</div>
                        {%- endif -%}

                      {%- when 'link_list' -%}
                        {%- capture menu_html -%}
                          {%- if block.settings.menu != blank -%}
                            <ul class="ftx-menu{% if block.settings.columns == '2' %} ftx-menu--2col{% endif %}" role="list">
                              {%- for link in block.settings.menu.links -%}
                                <li>
                                  <a class="ftx-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                                    {{- link.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        {%- endcapture -%}
                        {%- if block.settings.heading != blank and s.collapse_mobile -%}
                          <details class="ftx-acc" open data-ftx-acc>
                            <summary class="ftx-acc__summary">
                              <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                              {{ icon_plus }}
                            </summary>
                            {{ menu_html }}
                          </details>
                        {%- else -%}
                          {%- if block.settings.heading != blank -%}
                            <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                          {%- endif -%}
                          {{ menu_html }}
                        {%- endif -%}

                      {%- when 'text' -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte ftx-rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                        {%- if block.settings.button_label != blank -%}
                          <a class="ftx-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                            {{- block.settings.button_label | escape -}}
                          </a>
                        {%- endif -%}

                      {%- when 'newsletter' -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte ftx-rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                        <div class="ftx-newsletter">{% render 'newsletter-form', form_id: block.id %}</div>
                        {%- if block.settings.note != blank -%}
                          <p class="ftx-note">{{ block.settings.note }}</p>
                        {%- endif -%}

                      {%- when 'contact' -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        <ul class="ftx-contact" role="list">
                          {%- if block.settings.address != blank -%}
                            <li>
                              {{ icon_pin }}
                              <span>
                                {{ block.settings.address | escape | newline_to_br }}
                                {%- if block.settings.show_map_link -%}
                                  <br><a class="ftx-link" href="https://www.google.com/maps/search/?api=1&query={{ block.settings.address | url_encode }}" target="_blank" rel="noopener">{{ block.settings.map_label | escape }}</a>
                                {%- endif -%}
                              </span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.phone != blank -%}
                            {%- assign tel = block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
                            <li>{{ icon_phone }}<a class="ftx-link" href="tel:{{ tel }}">{{ block.settings.phone | escape }}</a></li>
                          {%- endif -%}
                          {%- if block.settings.email != blank -%}
                            <li>{{ icon_mail }}<a class="ftx-link" href="mailto:{{ block.settings.email | strip }}">{{ block.settings.email | escape }}</a></li>
                          {%- endif -%}
                          {%- if block.settings.hours != blank -%}
                            <li>{{ icon_clock }}<span>{{ block.settings.hours | escape | newline_to_br }}</span></li>
                          {%- endif -%}
                        </ul>

                      {%- when 'image' -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="ftx-heading">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.image != blank -%}
                          {%- if block.settings.link != blank -%}
                            <a class="ftx-image" href="{{ block.settings.link }}" style="--ftx-img-w: {{ block.settings.image_width }}%; --ftx-img-r: {{ block.settings.radius }}px;">
                          {%- else -%}
                            <div class="ftx-image" style="--ftx-img-w: {{ block.settings.image_width }}%; --ftx-img-r: {{ block.settings.radius }}px;">
                          {%- endif -%}
                            {{
                              block.settings.image
                              | image_url: width: 1200
                              | image_tag:
                                widths: '300,450,600,900,1200',
                                sizes: '(min-width: 990px) 33vw, 100vw',
                                loading: 'lazy'
                            }}
                          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
                        {%- endif -%}
                        {%- if block.settings.caption != blank -%}
                          <p class="ftx-note">{{ block.settings.caption }}</p>
                        {%- endif -%}
                    {%- endcase -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if show_utilities -%}
      <div class="ftx-utilities">
        <div class="{{ width_class }} ftx-utilities__inner">
          {%- if s.show_social -%}
            <div class="ftx-social">{% render 'social-icons' %}</div>
          {%- endif -%}
          {%- if show_follow -%}
            <div class="ftx-follow">{{ shop | login_button: action: 'follow' }}</div>
          {%- endif -%}
          {%- if show_localization -%}
            <div class="ftx-localization">
              {% render 'localization-form',
                show_country: s.enable_country_selector,
                show_language: s.enable_language_selector,
                id_prefix: 'FooterLocalization'
              %}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="ftx-bottom">
      <div class="{{ width_class }} ftx-bottom__inner">
        <div class="ftx-legal">
          <small class="ftx-copy">
            {%- if s.copyright_text != blank -%}
              {{ s.copyright_text | replace: '[year]', year | replace: '[shop]', shop_link }}
            {%- else -%}
              &copy; {{ year }}, {{ shop_link }}
            {%- endif -%}
          </small>

          {%- if s.show_powered_by -%}
            <small>{{ powered_by_link }}</small>
          {%- endif -%}

          {%- if s.show_policies -%}
            <ul class="ftx-policies" role="list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><small><a class="ftx-link" href="{{ policy.url }}">{{ policy.title | escape }}</a></small></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="ftx-bottom__end">
          {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <div class="ftx-payment">
              <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
              <ul class="ftx-payment__list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'ftx-payment__icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if s.show_back_to_top -%}
            <button type="button" class="ftx-top" data-ftx-top>
              <span>{{ s.back_to_top_label | escape }}</span>{{ icon_up }}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </footer>
</ftx-footer>

{% stylesheet %}
  .ftx {
    --ftx-muted: color-mix(in srgb, currentColor 72%, transparent);
    --ftx-line: color-mix(in srgb, currentColor 16%, transparent);
    --ftx-g: min(var(--ftx-gap), 28px);
    display: block;
  }
  .ftx--inset { padding: 0 var(--ftx-inset) var(--ftx-inset); }
  .ftx-full { padding-inline: clamp(16px, 4vw, 56px); }

  /* Surface + background media */
  .ftx-surface {
    position: relative; isolation: isolate; overflow: hidden;
    padding-top: calc(var(--ftx-pt) * 0.7);
    padding-bottom: calc(var(--ftx-pb) * 0.7);
  }
  .ftx--custom-text .ftx-surface { color: var(--ftx-text); }
  .ftx--full .ftx-surface { border-radius: var(--ftx-radius) var(--ftx-radius) 0 0; }
  .ftx--inset .ftx-surface { border-radius: var(--ftx-radius); }
  @media (min-width: 750px) {
    .ftx { --ftx-g: var(--ftx-gap); }
    .ftx-surface { padding-top: var(--ftx-pt); padding-bottom: var(--ftx-pb); }
  }
  .ftx-media, .ftx-overlay { position: absolute; inset: 0; pointer-events: none; }
  .ftx-media { z-index: -2; }
  .ftx-overlay { z-index: -1; }
  .ftx-media__item, .ftx-media video, .ftx-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .ftx-media__item--mobile { display: none; }
  @media (max-width: 749px) {
    .ftx-media--has-mobile .ftx-media__item--desktop { display: none; }
    .ftx-media--has-mobile .ftx-media__item--mobile { display: block; }
  }

  /* Rows */
  .ftx-main { padding-bottom: clamp(28px, 4vw, 48px); }
  .ftx-grid { display: flex; flex-wrap: wrap; align-items: flex-start; gap: calc(var(--ftx-g) * 1.1) var(--ftx-g); }
  .ftx-block { flex: 1 1 200px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .ftx-break { flex: 0 0 100%; height: 0; }
  .ftx-divider { flex: 0 0 100%; height: 0; margin-block: calc(var(--ftx-space) - var(--ftx-g) * 0.55); }
  .ftx-divider--line { border-top: 1px solid var(--ftx-line); }
  @media (max-width: 749px) {
    .ftx-block { flex: 0 0 100%; }
    .ftx-m-half { flex: 0 0 calc(50% - var(--ftx-g) / 2); }
    .ftx-break { display: none; }
  }
  @media (min-width: 750px) {
    .ftx-w-25, .ftx-w-33 { flex: 0 0 calc(50% - var(--ftx-g) / 2); }
    .ftx-w-50, .ftx-w-66, .ftx-w-75, .ftx-w-100 { flex: 0 0 100%; }
  }
  @media (min-width: 990px) {
    .ftx-w-25 { flex: 0 0 calc(25% - var(--ftx-g) * 0.75); }
    .ftx-w-33 { flex: 0 0 calc(33.333% - var(--ftx-g) * 0.667); }
    .ftx-w-50 { flex: 0 0 calc(50% - var(--ftx-g) * 0.5); }
    .ftx-w-66 { flex: 0 0 calc(66.666% - var(--ftx-g) * 0.333); }
    .ftx-w-75 { flex: 0 0 calc(75% - var(--ftx-g) * 0.25); }
  }

  .ftx--center .ftx-block { align-items: center; text-align: center; }
  .ftx--center .ftx-menu, .ftx--center .ftx-contact { justify-items: center; }
  .ftx--center .ftx-contact li { justify-content: center; }

  /* Type */
  .ftx-heading {
    margin: 0; font-size: 1em; font-weight: 600; line-height: 1.3; letter-spacing: 0.01em;
    font-family: var(--font-heading-family, inherit); color: inherit;
  }
  .ftx--h-small .ftx-heading { font-size: 0.9em; }
  .ftx--h-large .ftx-heading { font-size: 1.3em; }
  .ftx-rte { color: var(--ftx-muted); max-width: 46ch; }
  .ftx-rte > :first-child { margin-top: 0; }
  .ftx-rte > :last-child { margin-bottom: 0; }
  .ftx-note { margin: 0; font-size: 0.82em; color: var(--ftx-muted); }

  .ftx-link {
    color: var(--ftx-muted); text-decoration: none; padding-bottom: 2px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s ease, color 0.2s ease;
  }
  .ftx-link:hover, .ftx-link:focus-visible, .ftx-link[aria-current] { color: inherit; background-size: 100% 1px; }
  .ftx-surface a:focus-visible, .ftx-surface button:focus-visible, .ftx-acc__summary:focus-visible {
    outline: 2px solid currentColor; outline-offset: 3px; border-radius: 2px;
  }

  /* Blocks */
  .ftx-logo { display: inline-block; color: inherit; text-decoration: none; }
  .ftx-logo__img { display: block; max-width: 100%; height: auto; }
  .ftx-logo--text { font-family: var(--font-heading-family, inherit); font-size: 1.5em; font-weight: 600; }

  .ftx-menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ftx-menu--2col { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }

  .ftx-acc { width: 100%; }
  .ftx-acc__summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: default; }
  .ftx-acc__summary::-webkit-details-marker { display: none; }
  .ftx-acc__icon { display: none; flex: 0 0 auto; transition: transform 0.25s ease; }
  .ftx-acc > .ftx-menu { margin-top: 14px; }
  .ftx--center .ftx-acc__summary { justify-content: center; }
  @media (max-width: 749px) {
    .ftx-block--acc + .ftx-block--acc { margin-top: calc(var(--ftx-g) * -1.1); }
    .ftx-acc { border-bottom: 1px solid var(--ftx-line); }
    .ftx-block--acc + .ftx-block--acc .ftx-acc { border-top: 0; }
    .ftx-block--acc .ftx-acc { border-top: 1px solid var(--ftx-line); }
    .ftx-acc__summary { cursor: pointer; min-height: 52px; }
    .ftx--center .ftx-acc__summary { justify-content: space-between; }
    .ftx-acc__icon { display: block; }
    .ftx-acc[open] .ftx-acc__icon { transform: rotate(45deg); }
    .ftx-acc > .ftx-menu { margin: 2px 0 18px; }
  }

  .ftx-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px;
    border: 1px solid currentColor; border-radius: 999px; color: inherit; text-decoration: none;
    font-size: 0.9em; font-weight: 600; transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ftx-btn:hover { background: color-mix(in srgb, currentColor 12%, transparent); }

  .ftx-newsletter { width: 100%; max-width: 420px; }

  .ftx-contact { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ftx-contact li { display: flex; align-items: flex-start; gap: 10px; color: var(--ftx-muted); line-height: 1.5; }
  .ftx-contact svg { flex: 0 0 18px; margin-top: 2px; color: currentColor; }

  .ftx-image { display: block; width: var(--ftx-img-w); max-width: 100%; border-radius: var(--ftx-img-r); overflow: hidden; }
  .ftx-image img { display: block; width: 100%; height: auto; transition: transform 0.6s ease; }
  a.ftx-image:hover img { transform: scale(1.03); }

  /* Wordmark */
  .ftx-wordmark {
    flex: 0 0 100%; display: flex; justify-content: var(--ftx-wm-justify);
    margin: var(--ftx-wm-mt) 0 var(--ftx-wm-mb); opacity: var(--ftx-wm-opacity); min-width: 0;
  }
  .ftx-wordmark__inner--img { width: var(--ftx-wm-size); }
  .ftx-wordmark__inner--img a { display: block; }
  .ftx-wordmark__img { display: block; width: 100%; height: auto; }
  .ftx-wordmark__text {
    display: inline-block; white-space: nowrap; line-height: 0.82; letter-spacing: -0.035em;
    font-family: var(--font-heading-family, inherit); font-weight: var(--font-heading-weight, 700);
    font-size: clamp(56px, 13vw, 240px); padding-block: 0.06em;
  }
  .ftx-wordmark--outline .ftx-wordmark__text { color: transparent; -webkit-text-stroke: max(1px, 0.012em) currentColor; }
  .ftx-wordmark--fade .ftx-wordmark__inner {
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
  .ftx-js .ftx-wordmark--animate .ftx-wordmark__inner {
    opacity: 0; transform: translateY(18%);
    transition: opacity 0.9s ease, transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ftx-js .ftx-wordmark--animate.is-visible .ftx-wordmark__inner { opacity: 1; transform: none; }

  /* Utilities + bottom bar */
  .ftx-utilities__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 16px 28px; padding-block: 22px;
  }
  .ftx--center .ftx-utilities__inner, .ftx--center .ftx-bottom__inner { justify-content: center; text-align: center; }
  .ftx--dividers .ftx-utilities, .ftx--dividers .ftx-bottom { border-top: 1px solid var(--ftx-line); }
  .ftx-bottom__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 16px 28px; padding-top: 22px;
  }
  .ftx-legal { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; color: var(--ftx-muted); }
  .ftx-copy a { color: inherit; text-decoration: none; }
  .ftx-policies { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .ftx-bottom__end { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .ftx-payment__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ftx-payment__icon { display: block; height: 24px; width: auto; }
  .ftx-top {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; min-height: 40px;
    border: 1px solid var(--ftx-line); border-radius: 999px; background: none; color: inherit;
    font: inherit; font-size: 0.85em; cursor: pointer; transition: border-color 0.2s ease;
  }
  .ftx-top:hover { border-color: currentColor; }
  .ftx-top svg { transition: transform 0.25s ease; }
  .ftx-top:hover svg { transform: translateY(-2px); }

  @media (prefers-reduced-motion: reduce) {
    .ftx *, .ftx *::before, .ftx *::after { transition: none !important; }
    .ftx-js .ftx-wordmark--animate .ftx-wordmark__inner { opacity: 1; transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ftx-footer')) {
    class FtxFooter extends HTMLElement {
      connectedCallback() {
        this.classList.add('ftx-js');
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.mq = window.matchMedia('(max-width: 749px)');
        this.onMq = () => this.syncAccordions();
        this.mq.addEventListener('change', this.onMq);
        this.syncAccordions();

        this.addEventListener('click', (e) => {
          if (e.target.closest('.ftx-acc__summary') && !this.mq.matches) e.preventDefault();
          if (e.target.closest('[data-ftx-top]')) {
            window.scrollTo({ top: 0, behavior: this.reduceMotion ? 'auto' : 'smooth' });
          }
        });
        // Theme editor: open a collapsed menu when its block is selected
        this.addEventListener('shopify:block:select', (e) => {
          const acc = e.target.querySelector && e.target.querySelector('[data-ftx-acc]');
          if (acc) acc.open = true;
        });

        this.setupWordmarks();
        this.setupReveal();
        this.setupVideo();
      }

      disconnectedCallback() {
        if (this.mq) this.mq.removeEventListener('change', this.onMq);
        [this.ro, this.io, this.vio].forEach((o) => o && o.disconnect());
      }

      syncAccordions() {
        this.querySelectorAll('[data-ftx-acc]').forEach((d) => { d.open = !this.mq.matches; });
      }

      setupWordmarks() {
        const items = [...this.querySelectorAll('[data-ftx-fit]')];
        if (!items.length) return;
        const fit = () => items.forEach((el) => {
          const box = el.closest('.ftx-wordmark');
          const target = box.clientWidth * (Number(el.dataset.ftxFit) || 100) / 100;
          el.style.fontSize = '100px';
          const w = el.offsetWidth;
          if (w > 0) el.style.fontSize = ((100 * target) / w).toFixed(2) + 'px';
        });
        fit();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
        let lastWidth = this.clientWidth;
        this.ro = new ResizeObserver(() => {
          if (this.clientWidth === lastWidth) return;
          lastWidth = this.clientWidth;
          fit();
        });
        this.ro.observe(this);
      }

      setupReveal() {
        const els = this.querySelectorAll('.ftx-wordmark--animate');
        if (!els.length) return;
        if (this.reduceMotion || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        this.io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              this.io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });
        els.forEach((el) => this.io.observe(el));
      }

      setupVideo() {
        const video = this.querySelector('.ftx-media video');
        if (!video) return;
        video.muted = true;
        video.playsInline = true;
        if (this.reduceMotion) { video.pause(); return; }
        if ('IntersectionObserver' in window) {
          this.vio = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting) video.play().catch(() => {});
            else video.pause();
          });
          this.vio.observe(this);
        }
      }
    }
    customElements.define('ftx-footer', FtxFooter);
  }
{% endjavascript %}

