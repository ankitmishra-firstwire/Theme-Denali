<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow empty-state">
    <p class="caption">{{ 'templates.404.subtext' | t }}</p>
    <h1 class="empty-state__title">{{ 'templates.404.title' | t }}</h1>
    <p>{{ 'templates.404.message' | t }}</p>
    <div class="empty-state__search">{% render 'search-form', id_prefix: 'NotFound' %}</div>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
