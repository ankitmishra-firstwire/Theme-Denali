    { "type": "range", "id": "column_gap", "label": "Gap between columns", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_max_width", "label": "Card max width", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 320 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 40 },
