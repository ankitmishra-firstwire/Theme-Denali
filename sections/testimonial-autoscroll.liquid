    },
    { "type": "range", "id": "duration_col_1", "label": "Column 1 duration", "min": 5, "max": 80, "step": 1, "unit": "s", "default": 15 },
    { "type": "range", "id": "duration_col_2", "label": "Column 2 duration", "min": 5, "max": 80, "step": 1, "unit": "s", "default": 19 },
    { "type": "range", "id": "duration_col_3", "label": "Column 3 duration", "min": 5, "max": 80, "step": 1, "unit": "s", "default": 17 },
    { "type": "checkbox", "id": "reverse_middle", "label": "Reverse direction of column 2", "default": false },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover / touch", "default": true },
    { "type": "checkbox", "id": "enable_fade", "label": "Fade top and bottom edges", "default": true },
    {
      "type": "range",
      "id": "fade_size",
      "label": "Fade size",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 25
    },

    {
      "type": "header",
      "content": "Responsive"
    },
    { "type": "checkbox", "id": "hide_third_on_tablet", "label": "Hide column 3 on tablet", "default": true },
    { "type": "checkbox", "id": "hide_second_on_mobile", "label": "Hide columns 2 and 3 on mobile", "default": true }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial text",
          "default": "This product streamlined our operations and made our team far more productive."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Author name",
          "default": "Customer Name"
