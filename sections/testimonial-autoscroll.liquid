    { "type": "range", "id": "avatar_size", "label": "Avatar size", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "avatar_radius", "label": "Avatar roundness", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "author_gap", "label": "Space between avatar and name", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 8 },

    {
      "type": "header",
      "content": "Card shadow"
    },
    { "type": "range", "id": "shadow_x", "label": "Shadow horizontal offset", "min": -40, "max": 40, "step": 1, "unit": "px", "default": 0 },
