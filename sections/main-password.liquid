<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__inner page-width page-width--narrow">
    <div class="password__brand">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: widths: '150, 300, 450, 600', sizes: '240px', class: 'password__logo', alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <p class="password__shop-name h2">{{ shop.name | escape }}</p>
      {%- endif -%}
    </div>

    <h1 class="password__title">
      {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ 'templates.password.title' | t }}{%- endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <div class="password__message rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="password__newsletter">
        <h2 class="h4">{{ 'templates.password.newsletter_heading' | t }}</h2>
        {% render 'newsletter-form', form_id: section.id %}
      </div>
    {%- endif -%}

    <div class="password__login">
      <h2 class="h4">{{ 'templates.password.enter_using_password' | t }}</h2>
      {%- form 'storefront_password', id: 'StorefrontPasswordForm', class: 'password__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" id="PasswordError" role="alert">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <label class="field__label" for="Password">{{ 'templates.password.password' | t }}</label>
            <input
              class="field__input"
              type="password"
              name="password"
              id="Password"
              autocomplete="current-password"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
            >
          </div>
          <button type="submit" class="button" name="commit">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="caption password__admin">{{ 'templates.password.admin_link_html' | t }}</p>
    </div>

    <p class="caption password__powered">{{ 'templates.password.powered_by_shopify_html' | t: shopify: powered_by_link }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to “Opening soon”." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
