<product-recommendations
  class="product-recommendations section color-{{ section.settings.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
  data-target-id="ProductRecommendations-{{ section.id }}"
  id="ProductRecommendations-{{ section.id }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <ul class="product-grid product-grid--{{ section.settings.columns_desktop }}-col list-unstyled" role="list">
        {%- for recommendation in recommendations.products -%}
          <li class="product-grid__item">
            {% render 'product-card', product: recommendation %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations are generated automatically from order and product data. You can customize them with the Search & Discovery app."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
