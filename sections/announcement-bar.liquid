{%- if section.settings.text != blank -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a class="announcement-bar__link" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announcement",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
