        { "type": "link_list", "id": "column_menu", "label": "Column menu", "info": "Optional. Build columns from a different menu instead of this item's submenu." },

        { "type": "header", "content": "Links" },
        { "type": "checkbox", "id": "show_links", "label": "Show navigation links", "default": true },
        { "type": "checkbox", "id": "show_headings", "label": "Show second-level items as column headings", "default": true },
        { "type": "range", "id": "columns", "label": "Link columns", "min": 1, "max": 6, "step": 1, "default": 4 },
        { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” link", "default": false },

        { "type": "header", "content": "Featured content" },
        { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 8, "info": "Featured collections layout." },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 8, "info": "Featured products layout." },
        { "type": "range", "id": "media_count", "label": "Items to show", "info": "All items share one row on desktop. 3–5 looks best.", "min": 1, "max": 8, "step": 1, "default": 4 },
        {
          "type": "select",
          "id": "media_position",
          "label": "Content position",
          "options": [
            { "value": "right", "label": "Right of links" },
            { "value": "left", "label": "Left of links" }
          ],
          "default": "right"
        },
        { "type": "range", "id": "media_width", "label": "Content width", "info": "Share of the menu used by cards when links are shown.", "min": 30, "max": 80, "step": 5, "unit": "%", "default": 60 },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image shape",
          "options": [
            { "value": "auto", "label": "Original" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "4 / 5", "label": "Portrait 4:5" },
            { "value": "3 / 4", "label": "Portrait 3:4" },
            { "value": "3 / 2", "label": "Landscape 3:2" },
            { "value": "16 / 9", "label": "Wide 16:9" }
