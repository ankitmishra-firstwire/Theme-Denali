    { "type": "range", "id": "drawer_width", "label": "Drawer width", "min": 280, "max": 480, "step": 10, "unit": "px", "default": 380 },
    { "type": "color", "id": "drawer_bg", "label": "Drawer background", "default": "#ffffff" },
    { "type": "color", "id": "drawer_text", "label": "Drawer text", "default": "#1c1c1c" },
    { "type": "checkbox", "id": "drawer_single_open", "label": "Keep only one submenu open", "default": true },
    { "type": "checkbox", "id": "drawer_show_account", "label": "Show account link", "default": true },
    { "type": "checkbox", "id": "drawer_show_wishlist", "label": "Show wishlist link", "default": false },
    { "type": "richtext", "id": "drawer_footer_text", "label": "Drawer footer text" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 5,
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Message", "default": "Free shipping on orders over $75" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "bg_color", "label": "Background", "default": "#2f5d50" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
      ]
    },
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item title", "info": "Must match a top-level item in your menu, e.g. Shop." },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "dropdown", "label": "Standard dropdown" },
            { "value": "columns", "label": "Multi-column" },
            { "value": "images", "label": "Image cards" },
            { "value": "collections", "label": "Featured collections" },
            { "value": "products", "label": "Featured products" },
            { "value": "promo", "label": "Promotional banner" },
            { "value": "custom", "label": "Custom content" }
          ],
          "default": "columns"
