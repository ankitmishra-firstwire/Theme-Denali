    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "header_height", "label": "Desktop height", "min": 48, "max": 140, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "header_height_mobile", "label": "Mobile height", "min": 44, "max": 100, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "nav_row_height", "label": "Menu row height", "info": "Used by layouts with the menu below the logo.", "min": 36, "max": 80, "step": 2, "unit": "px", "default": 48 },
    {
      "type": "select",
      "id": "nav_align",
      "label": "Menu alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "nav_gap", "label": "Space between menu items", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 28 },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "logo_mobile", "label": "Mobile logo", "info": "Optional. Shown below 990px." },
    { "type": "image_picker", "id": "logo_transparent", "label": "Logo on transparent header", "info": "Optional. Usually a light version of your logo." },
    { "type": "range", "id": "logo_width", "label": "Desktop logo width", "min": 50, "max": 400, "step": 5, "unit": "px", "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "Mobile logo width", "min": 40, "max": 250, "step": 5, "unit": "px", "default": 100 },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu", "info": "Optional. Uses the main menu when empty." },
    {
      "type": "select",
      "id": "menu_trigger",
      "label": "Open menus on",
      "options": [
        { "value": "hover", "label": "Hover" },
        { "value": "click", "label": "Click" }
      ],
      "default": "hover"
    },
    { "type": "range", "id": "open_delay", "label": "Hover open delay", "min": 0, "max": 500, "step": 25, "unit": "ms", "default": 75 },
    { "type": "range", "id": "close_delay", "label": "Hover close delay", "info": "Keeps menus open while the cursor travels to the dropdown.", "min": 0, "max": 1000, "step": 50, "unit": "ms", "default": 250 },
    { "type": "range", "id": "transition_speed", "label": "Animation speed", "min": 100, "max": 800, "step": 50, "unit": "ms", "default": 250 },
    {
      "type": "select",
      "id": "default_animation",
      "label": "Default menu animation",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Fade and slide" },
        { "value": "scale", "label": "Fade and scale" },
        { "value": "none", "label": "None" }
      ],
      "default": "slide"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Menu item hover effect",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "color", "label": "Color change" },
        { "value": "pill", "label": "Background pill" },
        { "value": "none", "label": "None" }
      ],
      "default": "underline"
    },
    { "type": "checkbox", "id": "mega_overlay", "label": "Dim page when a menu is open", "default": true },
    { "type": "range", "id": "dropdown_width", "label": "Dropdown width", "min": 180, "max": 360, "step": 10, "unit": "px", "default": 240 },
    {
      "type": "select",
      "id": "dropdown_align",
      "label": "Dropdown position",
      "options": [
        { "value": "left", "label": "Aligned to item" },
        { "value": "center", "label": "Centered under item" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "nav_font", "label": "Menu font", "default": "assistant_n4" },
    { "type": "range", "id": "nav_size", "label": "Desktop menu size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "nav_size_mobile", "label": "Mobile menu size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    {
      "type": "select",
      "id": "nav_transform",
      "label": "Menu letter case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "nav_tracking", "label": "Letter spacing", "info": "In hundredths of an em.", "min": 0, "max": 20, "step": 1, "default": 0 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text and icons", "default": "#1c1c1c" },
    { "type": "color", "id": "accent_color", "label": "Hover and active", "default": "#2f5d50" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#e7e7e3" },
    { "type": "color", "id": "dropdown_bg", "label": "Dropdown background", "default": "#ffffff" },
    { "type": "color", "id": "dropdown_text", "label": "Dropdown text", "default": "#1c1c1c" },
    { "type": "color", "id": "badge_bg", "label": "Cart count background", "default": "#2f5d50" },
    { "type": "color", "id": "badge_text", "label": "Cart count text", "default": "#ffffff" },

    { "type": "header", "content": "Sticky and transparent" },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Header behavior",
      "options": [
        { "value": "none", "label": "Scrolls with page" },
        { "value": "always", "label": "Sticky" },
        { "value": "scroll_up", "label": "Sticky, hides on scroll down" },
        { "value": "fixed", "label": "Fixed" }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "transparent_mode",
      "label": "Transparent header",
      "options": [
        { "value": "none", "label": "Off" },
        { "value": "home", "label": "Home page only" },
        { "value": "all", "label": "All pages" }
      ],
      "default": "none",
      "info": "Overlays the first section. Turns solid on hover, on scroll and when a menu opens."
    },
    { "type": "color", "id": "transparent_text_color", "label": "Transparent header text", "default": "#ffffff" },

    { "type": "header", "content": "Borders and shadow" },
    { "type": "range", "id": "border_width", "label": "Bottom border", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    {
      "type": "select",
      "id": "shadow",
      "label": "Shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "soft", "label": "Soft" },
        { "value": "medium", "label": "Medium" },
        { "value": "strong", "label": "Strong" }
      ],
      "default": "none"
    },
    { "type": "checkbox", "id": "shadow_on_scroll", "label": "Only show shadow after scrolling", "default": true },

    { "type": "header", "content": "Icons" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "icon_gap", "label": "Space between icons", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_search_mobile", "label": "Show search on mobile", "default": true },
    {
      "type": "select",
      "id": "search_style",
      "label": "Search opens",
      "options": [
        { "value": "panel", "label": "Search bar under header" },
        { "value": "link", "label": "Search page" }
      ],
      "default": "panel"
    },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search products" },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_account_mobile", "label": "Show account on mobile", "default": false },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": false },
    { "type": "checkbox", "id": "show_wishlist_mobile", "label": "Show wishlist on mobile", "default": false },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart", "default": true },

    { "type": "header", "content": "Announcement bar" },
    { "type": "paragraph", "content": "Add Announcement blocks to show messages above the header." },
    { "type": "checkbox", "id": "ann_autoplay", "label": "Rotate messages automatically", "default": true },
    { "type": "range", "id": "ann_speed", "label": "Change message every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "ann_font_size", "label": "Text size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Mobile drawer" },
    {
      "type": "select",
      "id": "drawer_side",
