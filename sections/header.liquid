          "type": "select",
          "id": "align",
          "label": "Custom width alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
        { "type": "range", "id": "gap", "label": "Spacing", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 32 },
        { "type": "color", "id": "bg_color", "label": "Background", "info": "Leave empty to use the header dropdown colors." },
        { "type": "color", "id": "text_color", "label": "Text" },
        { "type": "color", "id": "heading_color", "label": "Headings" },
        { "type": "color", "id": "hover_color", "label": "Link hover" },

        { "type": "header", "content": "Animation" },
        {
