        { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
        { "type": "checkbox", "id": "show_card_text", "label": "Show titles and text", "default": true },
        { "type": "checkbox", "id": "show_buttons", "label": "Show buttons", "default": true },
        { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": true },
        { "type": "checkbox", "id": "show_vendor", "label": "Show product vendor", "default": false },
        { "type": "checkbox", "id": "show_product_count", "label": "Show collection product count", "default": false },

        { "type": "header", "content": "Image card 1" },
        { "type": "paragraph", "content": "Image cards layout uses cards 1–4, shown in one row on desktop. Promotional banner uses card 1 as the banner. Custom content shows card 1’s image." },
