        { "type": "range", "id": "speed", "label": "Speed", "info": "0 uses the header default.", "min": 0, "max": 800, "step": 50, "unit": "ms", "default": 0 },

        { "type": "header", "content": "Mobile" },
        { "type": "checkbox", "id": "mobile_show_media", "label": "Show images in mobile menu", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega header",
      "blocks": [
        { "type": "announcement" },
        { "type": "mega_menu", "settings": { "menu_item": "Shop", "layout": "collections" } }
      ]
    }
  ]
}
{% endschema %}