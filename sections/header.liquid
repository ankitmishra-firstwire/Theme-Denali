        { "type": "text", "id": "title_1", "label": "Heading" },
        { "type": "text", "id": "text_1", "label": "Text" },
        { "type": "text", "id": "button_1", "label": "Button label" },
        { "type": "url", "id": "link_1", "label": "Link" },
        { "type": "header", "content": "Image card 2" },
        { "type": "image_picker", "id": "image_2", "label": "Image" },
        { "type": "text", "id": "title_2", "label": "Heading" },
        { "type": "text", "id": "text_2", "label": "Text" },
        { "type": "text", "id": "button_2", "label": "Button label" },
        { "type": "url", "id": "link_2", "label": "Link" },
        { "type": "header", "content": "Image card 3" },
        { "type": "image_picker", "id": "image_3", "label": "Image" },
        { "type": "text", "id": "title_3", "label": "Heading" },
        { "type": "text", "id": "text_3", "label": "Text" },
        { "type": "text", "id": "button_3", "label": "Button label" },
        { "type": "url", "id": "link_3", "label": "Link" },
        { "type": "header", "content": "Image card 4" },
        { "type": "image_picker", "id": "image_4", "label": "Image" },
        { "type": "text", "id": "title_4", "label": "Heading" },
        { "type": "text", "id": "text_4", "label": "Text" },
        { "type": "text", "id": "button_4", "label": "Button label" },
        { "type": "url", "id": "link_4", "label": "Link" },

        { "type": "header", "content": "Promotional banner" },
        { "type": "range", "id": "promo_height", "label": "Banner height", "min": 200, "max": 560, "step": 20, "unit": "px", "default": 300 },
        { "type": "range", "id": "promo_overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
        {
          "type": "select",
          "id": "promo_text_position",
          "label": "Text position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-left", "label": "Bottom left" }
          ],
          "default": "bottom-left"
        },

        { "type": "header", "content": "Custom content" },
        { "type": "richtext", "id": "custom_text", "label": "Text" },
        { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or other Liquid code." },

        { "type": "header", "content": "Appearance" },
        {
          "type": "select",
          "id": "width_mode",
          "label": "Menu width",
          "options": [
            { "value": "full", "label": "Full screen, content at page width" },
            { "value": "edge", "label": "Full screen, content edge to edge" },
            { "value": "custom", "label": "Custom width" }
          ],
          "default": "full"
