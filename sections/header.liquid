        { "value": "left_center", "label": "Logo left, menu center, icons right" },
        { "value": "center_below", "label": "Logo center, menu below" },
        { "value": "left_below", "label": "Logo left, menu below" },
        { "value": "center_split", "label": "Menu left, logo center, icons right" }
