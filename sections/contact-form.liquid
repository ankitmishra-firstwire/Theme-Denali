<div class="section section--tight color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- assign contact_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: contact_id, class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
          {% render 'icon', icon: 'check' %}{{ 'templates.contact.form.post_success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'templates.contact.form.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ contact_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="form-grid">
        <div class="field">
          <label class="field__label" for="{{ contact_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
          <input class="field__input" autocomplete="name" type="text" id="{{ contact_id }}-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label class="field__label" for="{{ contact_id }}-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          <input
            class="field__input"
            autocomplete="email"
            type="email"
            id="{{ contact_id }}-email"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="{{ contact_id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
        <input class="field__input" type="tel" id="{{ contact_id }}-phone" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-\s\+\(\)]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
      </div>
      <div class="field">
        <label class="field__label" for="{{ contact_id }}-body">{{ 'templates.contact.form.comment' | t }} <span aria-hidden="true">*</span></label>
        <textarea class="field__input" rows="8" id="{{ contact_id }}-body" name="contact[body]" required aria-required="true"{% if form.errors contains 'body' %} aria-invalid="true"{% endif %}>{{ form.body }}</textarea>
      </div>
      <p class="caption">{{ 'templates.contact.form.required' | t }}</p>
      <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
