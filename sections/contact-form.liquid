{%- liquid
  assign s = section.settings
  assign contact_id = 'ContactForm-' | append: section.id

  assign floating = false
  if s.label_style == 'floating'
    assign floating = true
  endif

  assign info_blocks = section.blocks | where: 'type', 'info_item'
  assign map_blocks = section.blocks | where: 'type', 'map'
  assign field_blocks = section.blocks | where: 'type', 'field'

  if s.container_width == 'narrow'
    assign container_class = 'page-width page-width--narrow'
  else
    assign container_class = 'page-width'
  endif

  assign intro_align = 'left'
  if s.layout == 'centered'
    assign intro_align = s.heading_alignment
  endif

  assign req_star = ' <span class="cf-req" aria-hidden="true">*</span>'

  assign button_label = 'templates.contact.form.send' | t
  if s.button_label != blank
    assign button_label = s.button_label | escape
  endif

  assign message_label = 'templates.contact.form.comment' | t
  if s.message_label != blank
    assign message_label = s.message_label | escape
  endif
-%}

{%- style -%}
  #ContactSection-{{ section.id }} {
    --cf-radius: {{ s.corner_radius }}px;
    --cf-gap: {{ s.field_gap }}px;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ContactSection-{{ section.id }} {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture intro_html -%}
  {%- if s.heading != blank or s.description != blank -%}
    <div class="cf-intro cf-align--{{ intro_align }}">
      {%- if s.heading != blank -%}
        <h2 class="section-title cf-title cf-title--{{ s.heading_size }}">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <div class="cf-description rte">{{ s.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture info_html -%}
  {%- if info_blocks.size > 0 -%}
    <ul class="cf-items" role="list">
      {%- for block in info_blocks -%}
        {%- assign b = block.settings -%}
        <li class="cf-item" {{ block.shopify_attributes }}>
          {%- if b.icon != 'none' -%}
            <span class="cf-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                {%- case b.icon -%}
                  {%- when 'email' -%}
                    <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
                  {%- when 'phone' -%}
                    <path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4 1.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>
                  {%- when 'location' -%}
                    <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
                  {%- when 'clock' -%}
                    <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                  {%- when 'chat' -%}
                    <path d="M4 5h16v11H9l-5 4V5Z"/>
                  {%- when 'help' -%}
                    <circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5v.7"/><path d="M12 17h.01"/>
                {%- endcase -%}
              </svg>
            </span>
          {%- endif -%}
          <div class="cf-item__body">
            {%- if b.title != blank -%}
              <p class="cf-item__title">{{ b.title | escape }}</p>
            {%- endif -%}
            {%- if b.text != blank -%}
              <p class="cf-item__text">
                {%- if b.link != blank -%}
                  <a href="{{ b.link | escape }}">{{ b.text | escape | newline_to_br }}</a>
                {%- else -%}
                  {{ b.text | escape | newline_to_br }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- capture map_html -%}
  {%- for block in map_blocks -%}
    {%- if block.settings.address != blank -%}
      <div class="cf-map" style="--cf-map-h: {{ block.settings.height }}px;" {{ block.shopify_attributes }}>
        <iframe
          src="https://maps.google.com/maps?q={{ block.settings.address | url_encode }}&amp;z={{ block.settings.zoom }}&amp;output=embed"
          title="Map: {{ block.settings.address | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture form_html -%}
  <div class="cf-form-wrap{% if s.form_card %} cf-card color-{{ s.card_color_scheme }} gradient{% if s.card_border %} cf-card--border{% endif %}{% endif %}">
    {%- form 'contact', id: contact_id, class: 'cf-form' -%}
      {%- if form.posted_successfully? and s.hide_form_on_success -%}
        <div class="cf-done" role="status" tabindex="-1" data-cf-focus>
          <span class="cf-done__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          </span>
          {%- if s.success_heading != blank -%}
            <h3 class="cf-done__title">{{ s.success_heading | escape }}</h3>
          {%- endif -%}
          <div class="cf-done__text rte">
            {%- if s.success_message != blank -%}
              {{ s.success_message }}
            {%- else -%}
              <p>{{ 'templates.contact.form.post_success' | t }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- if form.posted_successfully? -%}
          <div class="cf-message cf-message--success" role="status" tabindex="-1" data-cf-focus>
            {% render 'icon', icon: 'check' %}
            <div>
              {%- if s.success_message != blank -%}
                {{ s.success_message }}
              {%- else -%}
                <p>{{ 'templates.contact.form.post_success' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- elsif form.errors -%}
          <div class="cf-message cf-message--error" role="alert" tabindex="-1" data-cf-focus>
            <div>
              <p>{{ 'templates.contact.form.error_heading' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ contact_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <div class="cf-grid">
          {%- comment -%} Name {%- endcomment -%}
          <div class="cf-field{% if floating %} cf-field--float{% endif %}">
            <input
              class="cf-input"
              type="text"
              id="{{ contact_id }}-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              {% if floating %}placeholder=" "{% endif %}
              {% if s.name_required %}required aria-required="true"{% endif %}
            >
            <label class="cf-label" for="{{ contact_id }}-name">
              {{- 'templates.contact.form.name' | t -}}
              {%- if s.name_required %}{{ req_star }}{% endif -%}
            </label>
          </div>

          {%- comment -%} Email {%- endcomment -%}
          <div class="cf-field{% if floating %} cf-field--float{% endif %}">
            <input
              class="cf-input"
              type="email"
              id="{{ contact_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              {% if floating %}placeholder=" "{% endif %}
              required
              aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
            <label class="cf-label" for="{{ contact_id }}-email">
              {{- 'templates.contact.form.email' | t }}{{ req_star -}}
            </label>
          </div>

          {%- comment -%} Phone {%- endcomment -%}
          {%- if s.show_phone -%}
            <div class="cf-field{% if s.phone_full_width %} cf-field--full{% endif %}{% if floating %} cf-field--float{% endif %}">
              <input
                class="cf-input"
                type="tel"
                id="{{ contact_id }}-phone"
                name="contact[{{ 'templates.contact.form.phone' | t }}]"
                autocomplete="tel"
                pattern="[0-9\-\s\+\(\)]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                {% if floating %}placeholder=" "{% endif %}
                {% if s.phone_required %}required aria-required="true"{% endif %}
              >
              <label class="cf-label" for="{{ contact_id }}-phone">
                {{- 'templates.contact.form.phone' | t -}}
                {%- if s.phone_required %}{{ req_star }}{% endif -%}
              </label>
            </div>
          {%- endif -%}

          {%- comment -%} Custom fields (blocks) {%- endcomment -%}
          {%- for block in field_blocks -%}
            {%- liquid
              assign b = block.settings
              assign fid = contact_id | append: '-' | append: block.id
              assign flabel = b.label | strip
              if flabel == blank
                assign flabel = 'Field ' | append: forloop.index
              endif
              assign fwidth = ''
              if b.width == 'full'
                assign fwidth = ' cf-field--full'
              endif
              assign opts = b.options | split: ','
            -%}
            {%- case b.field_type -%}
              {%- when 'select' -%}
                <div class="cf-field{{ fwidth }}{% if floating %} cf-field--float cf-field--fixed{% endif %}" {{ block.shopify_attributes }}>
                  <div class="cf-select">
                    <select class="cf-input" id="{{ fid }}" name="contact[{{ flabel | escape }}]"{% if b.required %} required aria-required="true"{% endif %}>
                      <option value="" disabled selected>{{ b.placeholder | default: 'Choose one' | escape }}</option>
                      {%- for opt in opts -%}
                        {%- assign o = opt | strip -%}
                        {%- if o != blank -%}
                          <option value="{{ o | escape }}">{{ o | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                  </div>
                  <label class="cf-label" for="{{ fid }}">{{ flabel | escape }}{% if b.required %}{{ req_star }}{% endif %}</label>
                </div>

              {%- when 'radio' -%}
                <fieldset class="cf-field cf-choice{{ fwidth }}" {{ block.shopify_attributes }}>
                  <legend class="cf-legend">{{ flabel | escape }}{% if b.required %}{{ req_star }}{% endif %}</legend>
                  <div class="cf-pills">
                    {%- for opt in opts -%}
                      {%- assign o = opt | strip -%}
                      {%- if o != blank -%}
                        <label class="cf-pill">
                          <input type="radio" name="contact[{{ flabel | escape }}]" value="{{ o | escape }}"{% if b.required %} required{% endif %}>
                          <span>{{ o | escape }}</span>
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>

              {%- when 'checkbox' -%}
                <div class="cf-field cf-check{{ fwidth }}" {{ block.shopify_attributes }}>
                  <input class="cf-check__input" type="checkbox" id="{{ fid }}" name="contact[{{ flabel | escape }}]" value="Yes"{% if b.required %} required aria-required="true"{% endif %}>
                  <label class="cf-check__label" for="{{ fid }}">{{ flabel | escape }}{% if b.required %}{{ req_star }}{% endif %}</label>
                </div>

              {%- else -%}
                <div class="cf-field{{ fwidth }}{% if floating %} cf-field--float{% endif %}" {{ block.shopify_attributes }}>
                  <input
                    class="cf-input"
                    {% if b.field_type == 'number' %}type="number" inputmode="numeric"{% elsif b.field_type == 'url' %}type="text" inputmode="url" autocapitalize="off" spellcheck="false"{% else %}type="text"{% endif %}
                    id="{{ fid }}"
                    name="contact[{{ flabel | escape }}]"
                    {% if floating %}placeholder=" "{% elsif b.placeholder != blank %}placeholder="{{ b.placeholder | escape }}"{% endif %}
                    {% if b.required %}required aria-required="true"{% endif %}
                  >
                  <label class="cf-label" for="{{ fid }}">{{ flabel | escape }}{% if b.required %}{{ req_star }}{% endif %}</label>
                </div>
            {%- endcase -%}
          {%- endfor -%}

          {%- comment -%} Message {%- endcomment -%}
          <div class="cf-field cf-field--full{% if floating %} cf-field--float{% endif %}">
            <textarea
              class="cf-input"
              rows="{{ s.message_rows }}"
              id="{{ contact_id }}-body"
              name="contact[body]"
              {% if floating %}placeholder=" "{% elsif s.message_placeholder != blank %}placeholder="{{ s.message_placeholder | escape }}"{% endif %}
              required
              aria-required="true"
              {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
            >{{ form.body }}</textarea>
            <label class="cf-label" for="{{ contact_id }}-body">{{ message_label }}{{ req_star }}</label>
          </div>

          {%- comment -%} Consent {%- endcomment -%}
          {%- if s.show_consent and s.consent_text != blank -%}
            <div class="cf-field cf-field--full cf-check">
              <input class="cf-check__input" type="checkbox" id="{{ contact_id }}-consent" name="contact[Consent]" value="Yes"{% if s.consent_required %} required aria-required="true"{% endif %}>
              <label class="cf-check__label" for="{{ contact_id }}-consent">{{ s.consent_text }}</label>
            </div>
          {%- endif -%}

          <div class="cf-actions{% if s.button_full_width %} cf-actions--full{% endif %}">
            <button
              type="submit"
              class="button{% if s.button_style == 'secondary' %} button--secondary{% endif %} cf-submit"
              data-sending-label="{{ s.button_sending_label | escape }}"
            >
              {{- button_label -}}
            </button>
            {%- if s.show_required_note -%}
              <p class="cf-note">{{ 'templates.contact.form.required' | t }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endcapture -%}

<div
  id="ContactSection-{{ section.id }}"
  class="cf cf--{{ s.field_style }}{% if floating %} cf--floating{% endif %} color-{{ s.color_scheme }} gradient"
>
  <div class="{{ container_class }}">
    {%- if s.layout == 'split' -%}
      <div class="cf-layout cf-layout--split cf-layout--info-{{ s.info_position }}">
        <div class="cf-info{% if s.sticky_info %} cf-info--sticky{% endif %}">
          {{ intro_html }}
          {{ info_html }}
          {{ map_html }}
        </div>
        <div class="cf-main">
          {{ form_html }}
        </div>
      </div>
    {%- else -%}
      <div class="cf-layout cf-layout--centered">
        {{ intro_html }}
        {{ info_html }}
        {{ form_html }}
        {{ map_html }}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('{{ contact_id }}');
    if (!form) return;

    var focusTarget = form.querySelector('[data-cf-focus]');
    if (focusTarget) {
      focusTarget.focus({ preventScroll: true });
      focusTarget.scrollIntoView({ block: 'center' });
    }

    var button = form.querySelector('.cf-submit');
    if (!button) return;
    var label = button.textContent;

    form.addEventListener('submit', function () {
      button.disabled = true;
      button.classList.add('is-loading');
      if (button.dataset.sendingLabel) button.textContent = button.dataset.sendingLabel;
    });

    window.addEventListener('pageshow', function () {
      button.disabled = false;
      button.classList.remove('is-loading');
      button.textContent = label;
    });
  })();
</script>

{% stylesheet %}
  .cf {
    --cf-line: rgba(127, 127, 127, 0.35);
    --cf-line-strong: rgba(127, 127, 127, 0.65);
    --cf-soft: rgba(127, 127, 127, 0.08);
    --cf-muted: currentColor;
    --cf-error: #c53b3b;
    --cf-success: #1f8a4c;
  }

  @supports (color: color-mix(in srgb, red 50%, transparent)) {
    .cf {
      --cf-line: color-mix(in srgb, currentColor 20%, transparent);
      --cf-line-strong: color-mix(in srgb, currentColor 45%, transparent);
      --cf-soft: color-mix(in srgb, currentColor 6%, transparent);
      --cf-muted: color-mix(in srgb, currentColor 68%, transparent);
    }
  }

  /* Layout */
  .cf-layout {
    display: grid;
    gap: 40px;
  }

  @media screen and (min-width: 990px) {
    .cf-layout--split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }

    .cf-layout--info-right .cf-info {
      order: 2;
    }

    .cf-info--sticky {
      position: sticky;
      top: 32px;
    }
  }

  /* Intro */
  .cf-intro > * {
    margin: 0;
  }

  .cf-intro > * + * {
    margin-top: 14px;
  }

  .cf .cf-title {
    margin: 0;
    line-height: 1.15;
  }

  .cf .cf-title--small { font-size: clamp(22px, 2.4vw, 28px); }
  .cf .cf-title--medium { font-size: clamp(28px, 3.6vw, 40px); }
  .cf .cf-title--large { font-size: clamp(34px, 5vw, 56px); }

  .cf-description {
    max-width: 560px;
    color: var(--cf-muted);
  }

  .cf-description > :first-child { margin-top: 0; }
  .cf-description > :last-child { margin-bottom: 0; }

  .cf-align--center {
    text-align: center;
  }

  .cf-align--center .cf-description {
    margin-inline: auto;
  }

  /* Contact details */
  .cf-items {
    display: grid;
    gap: 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .cf-layout--centered .cf-items {
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .cf-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .cf-item__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: min(calc(var(--cf-radius) + 2px), 50%);
    background: var(--cf-soft);
  }

  .cf-item__icon svg {
    width: 20px;
    height: 20px;
  }

  .cf-item__body {
    min-width: 0;
    padding-top: 1px;
  }

  .cf-item__title {
    margin: 0 0 2px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--cf-muted);
  }

  .cf-item__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .cf-item__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--cf-line-strong);
    text-underline-offset: 3px;
  }

  .cf-item__text a:hover {
    text-decoration-color: currentColor;
  }

  /* Map */
  .cf-map {
    margin-top: 32px;
    overflow: hidden;
    border: 1px solid var(--cf-line);
    border-radius: calc(var(--cf-radius) * 1.5);
  }

  .cf-layout--centered .cf-map {
    margin-top: 0;
  }

  .cf-map iframe {
    display: block;
    width: 100%;
    height: var(--cf-map-h, 300px);
    border: 0;
  }

  /* Card */
  .cf-card {
    padding: 24px;
    border-radius: calc(var(--cf-radius) * 1.5);
  }

  .cf-card--border {
    border: 1px solid var(--cf-line);
  }

  @media screen and (min-width: 750px) {
    .cf-card {
      padding: 40px;
    }
  }

  .cf-form {
    margin: 0;
  }

  /* Field grid */
  .cf-grid {
    display: grid;
    gap: var(--cf-gap);
  }

  @media screen and (min-width: 750px) {
    .cf-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .cf-field--full,
    .cf-actions {
      grid-column: 1 / -1;
    }
  }

  /* Fields */
  .cf-field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .cf-label,
  .cf-legend {
    order: -1;
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }

  .cf-req {
    color: var(--cf-muted);
  }

  .cf .cf-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 52px;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--cf-line);
    border-radius: var(--cf-radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 16px;
    line-height: 1.25;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .cf textarea.cf-input {
    min-height: 140px;
    line-height: 1.5;
    resize: vertical;
  }

  .cf .cf-input::placeholder {
    color: var(--cf-muted);
    opacity: 0.8;
  }

  .cf .cf-input:hover {
    border-color: var(--cf-line-strong);
  }

  .cf .cf-input:focus {
    outline: none;
    border-color: currentColor;
    box-shadow: 0 0 0 3px var(--cf-soft);
  }

  .cf .cf-input[aria-invalid='true'] {
    border-color: var(--cf-error);
  }

  /* Field styles */
  .cf--filled .cf-input {
    background: var(--cf-soft);
    border-color: transparent;
  }

  .cf--underline .cf-input {
    padding-inline: 0;
    border-width: 0 0 1px;
    border-radius: 0;
  }

  .cf--underline .cf-input:focus {
    box-shadow: 0 1px 0 0 currentColor;
  }

  /* Floating labels */
  .cf--floating .cf-field--float .cf-input {
    min-height: 56px;
    padding-top: 25px;
    padding-bottom: 9px;
  }

  .cf--floating .cf-field--float textarea.cf-input {
    padding-top: 28px;
  }

  .cf--floating .cf-field--float .cf-label {
    position: absolute;
    top: 17px;
    left: 17px;
    right: 17px;
    overflow: hidden;
    font-size: 16px;
    color: var(--cf-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
    transform-origin: 0 0;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .cf--underline.cf--floating .cf-field--float .cf-label {
    left: 0;
    right: 0;
  }

  .cf--floating .cf-field--float .cf-input:focus ~ .cf-label,
  .cf--floating .cf-field--float .cf-input:not(:placeholder-shown) ~ .cf-label,
  .cf--floating .cf-field--fixed .cf-label {
    transform: translateY(-10px) scale(0.75);
  }

  .cf--floating .cf-field--float .cf-input:focus ~ .cf-label {
    color: inherit;
  }

  /* Select */
  .cf-select {
    position: relative;
  }

  .cf-select::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 18px;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .cf--underline .cf-select::after {
    right: 4px;
  }

  .cf .cf-select .cf-input {
    padding-right: 44px;
    cursor: pointer;
  }

  .cf-select option {
    color: #111;
    background: #fff;
  }

  /* Choice pills */
  .cf .cf-choice {
    display: block;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cf-choice .cf-legend {
    margin-bottom: 10px;
    padding: 0;
  }

  .cf-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cf-pill {
    position: relative;
    cursor: pointer;
  }

  .cf-pill input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .cf-pill span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--cf-line);
    border-radius: calc(var(--cf-radius) * 3);
    font-size: 15px;
    line-height: 1.3;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .cf-pill:hover span {
    border-color: var(--cf-line-strong);
  }

  .cf-pill input:checked + span {
    border-color: currentColor;
    background: var(--cf-soft);
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .cf-pill input:focus-visible + span {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Checkboxes */
  .cf .cf-check {
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
  }

  .cf-check__input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    accent-color: currentColor;
    cursor: pointer;
  }

  .cf-check__label {
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
  }

  .cf-check__label a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Actions */
  .cf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-top: 4px;
  }

  .cf-actions--full .cf-submit {
    width: 100%;
  }

  .cf-submit.is-loading {
    opacity: 0.7;
    cursor: progress;
  }

  .cf-note {
    margin: 0;
    font-size: 13px;
    color: var(--cf-muted);
  }

  /* Messages */
  .cf-message {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
    padding: 16px 18px;
    border: 1px solid;
    border-radius: var(--cf-radius);
    font-size: 15px;
    line-height: 1.5;
  }

  .cf-message:focus,
  .cf-done:focus {
    outline: none;
  }

  .cf-message p {
    margin: 0;
  }

  .cf-message svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  .cf-message ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  .cf-message a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cf-message--success {
    border-color: rgba(31, 138, 76, 0.45);
    background: rgba(31, 138, 76, 0.08);
  }

  .cf-message--error {
    border-color: rgba(197, 59, 59, 0.45);
    background: rgba(197, 59, 59, 0.07);
  }

  /* Sent state */
  .cf-done {
    padding: 24px 0;
    text-align: center;
  }

  .cf-done__icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--cf-soft);
    color: var(--cf-success);
  }

  .cf-done__icon svg {
    width: 24px;
    height: 24px;
  }

  .cf-done__title {
    margin: 0 0 8px;
  }

  .cf-done__text {
    max-width: 420px;
    margin-inline: auto;
    color: var(--cf-muted);
  }

  .cf-done__text > :first-child { margin-top: 0; }
  .cf-done__text > :last-child { margin-bottom: 0; }

  @media (prefers-reduced-motion: reduce) {
    .cf *,
    .cf *::after {
      transition: none !important;
    }
  }
{% endstylesheet %}

