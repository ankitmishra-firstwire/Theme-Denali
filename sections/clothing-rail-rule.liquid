        this.angle = { value: 0, target: 0, velocity: 0, raf: 0, last: 0, dragging: false, startX: 0, startAngle: 0 };
        this.mSpin.style.transform = 'rotateY(0deg)';
        this.setSide('front');

        m.hidden = false;
        m.classList.remove('is-shown');
        this.prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        this.mCloseBtn.focus({ preventScroll: true });
        document.addEventListener('keydown', this.onDocKey);

        var from = this.parts[index].turn.getBoundingClientRect();
        if (!this.reduced && from.width > 0 && this.mFigure.animate) {
          var to = this.mFigure.getBoundingClientRect();
          var scale = from.height / to.height;
          var dx = from.left + from.width / 2 - (to.left + to.width / 2);
          var dy = from.top - to.top;
          var liftY = Math.min(90, Math.abs(dy) * 0.25 + 30);
          this.lift(index, true);
          this.openAnim = this.mFigure.animate([
            { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + scale + ')' },
            { transform: 'translate(' + (dx * 0.4) + 'px,' + (dy * 0.4 - liftY) + 'px) scale(' + ((scale + 1) / 2 * 1.03) + ') rotate(' + (dx > 0 ? -2.5 : 2.5) + 'deg)', offset: 0.5 },
            { transform: 'none' }
          ], { duration: 680, easing: 'cubic-bezier(.22,.85,.3,1)' });
        } else {
          this.lift(index, true);
        }
        requestAnimationFrame(function () { m.classList.add('is-shown'); });
        this.scheduleAutoplay();
      }

      dismiss() {
        if (this.openIndex === null || this.closing) return;
        this.closing = true;
        this.modal.classList.remove('is-shown');
        if (this.openAnim) { this.openAnim.cancel(); this.openAnim = null; }
        var self = this;
        var to = this.parts[this.openIndex].turn.getBoundingClientRect();
        if (this.reduced || !to || to.width === 0 || !this.mFigure.animate) { this.finishClose(); return; }
        var from = this.mFigure.getBoundingClientRect();
        var scale = to.height / from.height;
        var dx = to.left + to.width / 2 - (from.left + from.width / 2);
        var dy = to.top - from.top;
        this.closeAnim = this.mFigure.animate([
          { transform: 'none' },
          { transform: 'translate(' + (dx * 0.6) + 'px,' + (dy * 0.6 - 30) + 'px) scale(' + ((scale + 1) / 2) + ')', offset: 0.55 },
          { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + scale + ')' }
        ], { duration: 560, easing: 'cubic-bezier(.45,0,.55,1)', fill: 'forwards' });
        this.closeAnim.onfinish = function () { self.finishClose(); };
      }

      finishClose() {
        var index = this.openIndex;
        if (index === null) return;
        var m = this.modal;
        m.hidden = true;
        m.classList.remove('is-shown');
        if (this.closeAnim) { this.closeAnim.cancel(); this.closeAnim = null; }
        cancelAnimationFrame(this.angle.raf);
        this.angle.raf = 0;
        document.body.style.overflow = this.prevOverflow || '';
        document.removeEventListener('keydown', this.onDocKey);
        this.openIndex = null;
        this.closing = false;
        this.lift(index, false);
        this.garments[index].focus({ preventScroll: true });
        this.impulse(index, (index % 2 ? 1 : -1) * 44);
      }

      onModalKey(event) {
        if (event.key === 'Escape') { event.preventDefault(); this.dismiss(); return; }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { this.turnTo(this.side === 'front' ? 'back' : 'front'); return; }
        if (event.key !== 'Tab') return;
        var controls = Array.prototype.slice.call(this.modal.querySelectorAll('button, a[href]')).filter(function (node) {
          return !node.disabled && !node.hidden && node.offsetParent !== null;
        });
        var first = controls[0];
        var last = controls[controls.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      }
    }

    window.customElements.define('clothing-rail-hero', ClothingRailHero);
  })();
</script>

