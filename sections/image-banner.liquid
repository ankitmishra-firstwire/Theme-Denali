{%- liquid
  assign is_priority = false
  if section.index <= 2
    assign is_priority = true
  endif
-%}
<div class="image-banner image-banner--{{ section.settings.content_position }} color-{{ section.settings.color_scheme }}" style="--banner-min-height: {{ section.settings.min_height }}px; --banner-min-height-mobile: {{ section.settings.min_height_mobile }}px; --banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="image-banner__media">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
          {% render 'image', image: section.settings.image, image_class: 'image-banner__image', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400, 3000', width: 3000, priority: is_priority %}
        </picture>
      {%- else -%}
        {% render 'image', image: section.settings.image, image_class: 'image-banner__image', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400, 3000', width: 3000, priority: is_priority %}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg image-banner__image' }}
    {%- endif -%}
  </div>
  <div class="image-banner__overlay" aria-hidden="true"></div>
  <div class="page-width image-banner__content">
    <div class="image-banner__box">
      {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="image-banner__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="image-banner__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Shown on screens narrower than 750 px." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring the outdoors in" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover plants, pots and care essentials chosen for real homes.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "min_height", "label": "Minimum height on desktop", "min": 300, "max": 900, "step": 50, "unit": "px", "default": 600 },
    { "type": "range", "id": "min_height_mobile", "label": "Minimum height on mobile", "min": 300, "max": 800, "step": 25, "unit": "px", "default": 450 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "info": "Text color is used over the image.", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
