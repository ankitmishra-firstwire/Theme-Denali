      "id": "button_text_color",
      "label": "Button text",
      "default": "#14120f"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 50
    },

    { "type": "header", "content": "Rotating badge" },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "info": "Short text with separators reads best, e.g. NEW IN • SHOP NOW •",
      "default": "New season • Shop the edit • "
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link"
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Position",
      "options": [
        { "value": "top-right", "label": "Top right" },
        { "value": "top-left", "label": "Top left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-right"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Size",
      "min": 80,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 132
    },
    {
      "type": "range",
      "id": "badge_speed",
      "label": "Rotation time",
      "info": "Seconds per turn. Lower is faster.",
      "min": 6,
      "max": 40,
      "step": 1,
      "unit": "s",
      "default": 16
    },
