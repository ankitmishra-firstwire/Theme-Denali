      "default": false
    },
    {
      "type": "font_picker",
      "id": "headline_font",
      "label": "Font",
      "default": "assistant_n4"
    },

    { "type": "header", "content": "Caption (appears when open)" },
    {
      "type": "text",
      "id": "caption_eyebrow",
      "label": "Small text",
      "default": "The new collection"
    },
    {
      "type": "inline_richtext",
      "id": "caption_heading",
      "label": "Heading",
      "info": "Italic words use the accent color.",
      "default": "Crafted to be <em>worn for years</em>"
    },
    {
      "type": "textarea",
      "id": "caption_text",
      "label": "Text",
