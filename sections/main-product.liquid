{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
-%}

<product-info
  class="product section color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-product-form-id="{{ product_form_id }}"
>
  <div class="page-width product__grid product__grid--media-{{ section.settings.media_size }}">
    <div class="product__media-wrapper">
      <media-gallery class="product-media" data-section-id="{{ section.id }}">
        <span class="visually-hidden" id="MediaGalleryLabel-{{ section.id }}">{{ 'products.product.media.gallery_viewer' | t }}</span>
        {%- if product.media.size > 0 -%}
          <ul class="product-media__list list-unstyled" role="list" aria-labelledby="MediaGalleryLabel-{{ section.id }}" data-media-list>
            {%- if featured_media -%}
              {% render 'product-media', media: featured_media, section_id: section.id, priority: true, loop: section.settings.enable_video_looping %}
            {%- endif -%}
            {%- for media in product.media -%}
              {%- unless media.id == featured_media.id -%}
                {% render 'product-media', media: media, section_id: section.id, loop: section.settings.enable_video_looping %}
              {%- endunless -%}
            {%- endfor -%}
          </ul>
          {%- if product.media.size > 1 -%}
            <ul class="product-media__thumbnails list-unstyled" role="list" aria-label="{{ 'products.product.media.thumbnails' | t }}">
              {%- for media in product.media -%}
                <li>
                  <button
                    type="button"
                    class="product-media__thumbnail{% if media.id == featured_media.id %} is-active{% endif %}"
                    data-thumbnail-for="{{ media.id }}"
                    {% if media.id == featured_media.id %}aria-current="true"{% endif %}
                  >
                    {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}
                    {%- if media.media_type != 'image' -%}
                      <span class="product-media__thumbnail-badge">{% render 'icon', icon: 'play' %}</span>
                    {%- endif -%}
                    <span class="visually-hidden">{{ 'products.product.media.load_image' | t: index: forloop.index }}</span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if first_3d_model -%}
            <button
              class="button button--secondary product__xr-button"
              type="button"
              aria-label="{{ 'products.product.xr_button_label' | t }}"
              data-shopify-xr
              data-shopify-model3d-id="{{ first_3d_model.id }}"
              data-shopify-title="{{ product.title | escape }}"
              data-shopify-xr-hidden
            >
              {% render 'icon', icon: 'cube' %}
              {{ 'products.product.xr_button' | t }}
            </button>
            <script type="application/json" id="ProductJSON-{{ product.id }}">
              {{ product.media | where: 'media_type', 'model' | json }}
            </script>
          {%- endif -%}
        {%- else -%}
          <div class="product-media__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </media-gallery>
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'text' -%}
            <p class="product__text{% if block.settings.style == 'caption' %} caption{% endif %}" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </p>

          {%- when 'title' -%}
            <div class="product__title" {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="product__vendor caption">
                  <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                  {{- product.vendor | escape -}}
                </p>
              {%- endif -%}
              <h1>{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="product__price" id="Price-{{ section.id }}" data-update="price" role="status" {{ block.shopify_attributes }}>
              {%- liquid
                assign plan_allocation = product.selected_selling_plan_allocation
              -%}
              {%- if plan_allocation -%}
                <div class="price{% if plan_allocation.compare_at_price > plan_allocation.price %} price--on-sale{% endif %}">
                  <span class="price__current{% if plan_allocation.compare_at_price > plan_allocation.price %} price__current--sale{% endif %}">{{ plan_allocation.price | money }}</span>
                  {%- if plan_allocation.compare_at_price > plan_allocation.price -%}
                    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    <s class="price__compare">{{ plan_allocation.compare_at_price | money }}</s>
                  {%- endif -%}
                  {%- if plan_allocation.unit_price and current_variant.unit_price_measurement -%}
                    {% render 'unit-price', unit_price: plan_allocation.unit_price, measurement: current_variant.unit_price_measurement %}
                  {%- endif -%}
                </div>
              {%- else -%}
                {% render 'price', product: product, variant: current_variant, class: 'price--large' %}
              {%- endif -%}

              {%- if current_variant.compare_at_price > current_variant.price and plan_allocation == blank -%}
                <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
              {%- endif -%}

              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="product__tax caption rte">
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {{ 'products.product.duties_and_taxes_included' | t }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'products.product.taxes_included' | t }}
                  {%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- assign installment_form_id = 'product-form-installment-' | append: section.id -%}
              {%- form 'product', product, id: installment_form_id, class: 'product__installments' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <variant-picker class="variant-picker" data-section-id="{{ section.id }}" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  {%- if block.settings.picker_type == 'dropdown' -%}
                    <div class="field variant-picker__field">
                      <label class="field__label" for="Option-{{ section.id }}-{{ option_index }}">{{ option.name | escape }}</label>
                      <select
                        id="Option-{{ section.id }}-{{ option_index }}"
                        class="field__input select"
                        data-option-index="{{ option_index }}"
                      >
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}"{% if option.selected_value == value %} selected="selected"{% endif %}>
                            {{- value | escape -}}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- else -%}
                    <fieldset class="variant-picker__fieldset">
                      <legend class="variant-picker__legend">
                        {{- option.name | escape }}:
                        <span class="variant-picker__selected" data-selected-value>{{ option.selected_value | escape }}</span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          {%- assign value_id = 'Option-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                          <input
                            type="radio"
                            class="variant-picker__input visually-hidden"
                            id="{{ value_id }}"
                            name="Option-{{ section.id }}-{{ option_index }}"
                            value="{{ value | escape }}"
                            data-option-index="{{ option_index }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label class="variant-picker__label{% if value.swatch.color or value.swatch.image %} variant-picker__label--swatch{% endif %}" for="{{ value_id }}">
                            {%- if value.swatch.image -%}
                              <span class="swatch" style="background-image: url({{ value.swatch.image | image_url: width: 60 }});" aria-hidden="true"></span>
                            {%- elsif value.swatch.color -%}
                              <span class="swatch" style="background-color: {{ value.swatch.color }};" aria-hidden="true"></span>
                            {%- endif -%}
                            <span class="variant-picker__value">{{ value | escape }}</span>
                            <span class="visually-hidden" data-unavailable-label hidden>{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endif -%}
                {%- endfor -%}
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>
              </variant-picker>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div class="product__quantity field" {{ block.shopify_attributes }}>
              <label class="field__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
              <quantity-input class="quantity">
                <button class="quantity__button" name="minus" type="button" data-quantity-minus>
                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                  {% render 'icon', icon: 'minus' %}
                </button>
                <input
                  class="quantity__input"
                  type="number"
                  name="quantity"
                  id="Quantity-{{ section.id }}"
                  data-quantity-input
                  min="{{ current_variant.quantity_rule.min }}"
                  {% if current_variant.quantity_rule.max != null %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                  step="{{ current_variant.quantity_rule.increment }}"
                  value="{{ current_variant.quantity_rule.min }}"
                  form="{{ product_form_id }}"
                >
                <button class="quantity__button" name="plus" type="button" data-quantity-plus>
                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                  {% render 'icon', icon: 'plus' %}
                </button>
              </quantity-input>
              {%- if current_variant.quantity_rule.min > 1 or current_variant.quantity_rule.increment > 1 or current_variant.quantity_rule.max != null -%}
                <p class="caption" id="QuantityRules-{{ section.id }}" data-update="quantity-rules">
                  {%- if current_variant.quantity_rule.increment > 1 -%}{{ 'products.product.quantity.multiples_of' | t: quantity: current_variant.quantity_rule.increment }} {% endif -%}
                  {%- if current_variant.quantity_rule.min > 1 -%}{{ 'products.product.quantity.minimum_of' | t: quantity: current_variant.quantity_rule.min }} {% endif -%}
                  {%- if current_variant.quantity_rule.max != null -%}{{ 'products.product.quantity.maximum_of' | t: quantity: current_variant.quantity_rule.max }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'inventory' -%}
            <p class="product__inventory caption" id="Inventory-{{ section.id }}" data-update="inventory" role="status" {{ block.shopify_attributes }}>
              {%- if current_variant.inventory_management == 'shopify' -%}
                {%- if current_variant.inventory_quantity > 0 -%}
                  {%- if current_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                    <span class="product__inventory-dot product__inventory-dot--low" aria-hidden="true"></span>
                    {%- if block.settings.show_inventory_quantity -%}
                      {{ 'products.product.inventory_low_stock_show_count' | t: quantity: current_variant.inventory_quantity }}
                    {%- else -%}
                      {{ 'products.product.inventory_low_stock' | t }}
                    {%- endif -%}
                  {%- else -%}
                    <span class="product__inventory-dot" aria-hidden="true"></span>
                    {%- if block.settings.show_inventory_quantity -%}
                      {{ 'products.product.inventory_in_stock_show_count' | t: quantity: current_variant.inventory_quantity }}
                    {%- else -%}
                      {{ 'products.product.inventory_in_stock' | t }}
                    {%- endif -%}
                  {%- endif -%}
                {%- elsif current_variant.inventory_policy == 'continue' -%}
                  <span class="product__inventory-dot" aria-hidden="true"></span>
                  {{ 'products.product.inventory_out_of_stock_continue_selling' | t }}
                {%- else -%}
                  <span class="product__inventory-dot product__inventory-dot--out" aria-hidden="true"></span>
                  {{ 'products.product.inventory_out_of_stock' | t }}
                {%- endif -%}
              {%- endif -%}
            </p>

          {%- when 'sku' -%}
            <p class="product__sku caption" id="Sku-{{ section.id }}" data-update="sku" {{ block.shopify_attributes }}>
              {%- if current_variant.sku != blank -%}
                <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>{{ current_variant.sku | escape }}
              {%- endif -%}
            </p>

          {%- when 'buy_buttons' -%}
            <div class="product__buy-buttons" {{ block.shopify_attributes }}>
              <product-form class="product-form" data-section-id="{{ section.id }}">
                <div class="form-message form-message--error" role="alert" data-form-error hidden></div>
                {%- form 'product', product, id: product_form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ current_variant.id }}"
                    data-variant-id
                    {% if current_variant == null %}disabled{% endif %}
                  >

                  {%- if product.selling_plan_groups.size > 0 -%}
                    {% render 'selling-plan-picker', product: product, section_id: section.id %}
                  {%- endif -%}

                  {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
                    {% render 'gift-card-recipient-form', form: form, section_id: section.id %}
                  {%- endif -%}

                  <div class="product-form__buttons" id="BuyButtons-{{ section.id }}" data-update="buy-buttons">
                    <button
                      type="submit"
                      name="add"
                      class="button button--full{% if block.settings.show_dynamic_checkout %} button--secondary{% endif %}"
                      data-add-to-cart
                      {% if current_variant.available == false or current_variant == null %}disabled{% endif %}
                    >
                      <span data-add-to-cart-text>
                        {%- if current_variant == null -%}
                          {{ 'products.product.unavailable' | t }}
                        {%- elsif current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  </div>
                {%- endform -%}
                <div class="form-message form-message--success" role="status" data-form-success hidden>
                  {% render 'icon', icon: 'check' %}
                  <span>{{ 'products.product.added_to_cart' | t }}</span>
                  <a class="link" href="{{ routes.cart_url }}">{{ 'products.product.view_cart' | t }}</a>
                </div>
              </product-form>

              {%- if block.settings.show_pickup_availability -%}
                <div id="Pickup-{{ section.id }}" data-update="pickup">
                  {% render 'pickup-availability', variant: current_variant %}
                </div>
              {%- endif -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
                {% render 'icon', icon: 'caret' %}
              </summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>

          {%- when 'share' -%}
            {%- assign share_path = product.selected_variant.url | default: product.url -%}
            {%- assign share_url = request.origin | append: share_path -%}
            <div {{ block.shopify_attributes }}>
              {% render 'share-buttons',
                share_url: share_url,
                share_title: product.title,
                share_image: product.featured_media.preview_image
              %}
            </div>

          {%- when 'custom_liquid' -%}
            <div class="product__custom-liquid" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

          {%- when 'complementary' -%}
            <product-recommendations
              class="complementary-products"
              data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_list_limit }}&intent=complementary"
              data-target-id="Complementary-{{ section.id }}"
              id="Complementary-{{ section.id }}"
              {{ block.shopify_attributes }}
            >
              {%- if recommendations.performed and recommendations.products_count > 0 -%}
                <h2 class="complementary-products__heading h4">{{ block.settings.heading | escape }}</h2>
                <ul class="complementary-products__list list-unstyled" role="list">
                  {%- for rec in recommendations.products -%}
                    <li class="complementary-products__item">
                      <a href="{{ rec.url }}" class="complementary-products__link">
                        {%- if rec.featured_media -%}
                          {{ rec.featured_media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: '' }}
                        {%- endif -%}
                        <span>
                          <span class="complementary-products__title">{{ rec.title | escape }}</span>
                          {% render 'price', product: rec, show_range: true %}
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </product-recommendations>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</product-info>

{%- if first_3d_model -%}
  <script>
    window.addEventListener('DOMContentLoaded', function () {
      if (!window.Shopify || !window.Shopify.loadFeatures) return;
      window.Shopify.loadFeatures([
        {
          name: 'shopify-xr',
          version: '1.0',
          onLoad: function setupShopifyXr(errors) {
            if (errors) return;
            if (!window.ShopifyXR) {
              document.addEventListener('shopify_xr_initialized', function () { setupShopifyXr(); });
              return;
            }
            document.querySelectorAll('[id^="ProductJSON-"]').forEach(function (modelJSON) {
              window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
              modelJSON.remove();
            });
            window.ShopifyXR.setupXRElements();
          }
        }
      ]);
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Desktop media width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop videos",
      "default": false
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Text block" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "caption", "label": "Caption" }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the price, unit price, tax notice and the Shop Pay Installments banner when available." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Style",
          "options": [
            { "value": "buttons", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "buttons"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "inventory_threshold",
          "label": "Low inventory threshold",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 10
        },
        { "type": "checkbox", "id": "show_inventory_quantity", "label": "Show inventory count", "default": false }
      ]
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "info": "Customers see their preferred payment method, such as Shop Pay or Apple Pay. [Learn more](https://help.shopify.com/manual/online-store/dynamic-checkout)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_pickup_availability",
          "label": "Show pickup availability",
          "info": "Requires local pickup to be enabled for a location.",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "Show recipient form for gift cards",
          "info": "Lets customers send gift cards on a scheduled date with a personal message. [Learn more](https://help.shopify.com/manual/online-store/themes/customizing-themes/add-gift-card-recipient-fields)",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Care instructions" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create advanced customizations."
        }
      ]
    },
    {
      "type": "complementary",
      "name": "Complementary products",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Set up complementary products with the Search & Discovery app. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery/product-recommendations)"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
        {
          "type": "range",
          "id": "product_list_limit",
          "label": "Maximum products to show",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 3
        }
      ]
