{{ 'layered-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'layered-slideshow.js' | asset_url }}" defer></script>

<section
  id="LayeredSlideshow-{{ section.id }}"
  class="layered-slideshow color-{{ section.settings.color_scheme }}"
  aria-roledescription="carousel"
  aria-label="{{ 'sections.slideshow.label' | t }}"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.slide_interval | times: 1000 }}"
  style="
    --ls-height: {{ section.settings.desktop_height }}px;
    --ls-mobile-height: {{ section.settings.mobile_height }}px;
    --ls-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="layered-slideshow__slides">
    {% for block in section.blocks %}
      <div
        class="layered-slideshow__slide{% if forloop.first %} is-active{% endif %}"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ 'sections.slideshow.slide_of' | t: index: forloop.index, total: forloop.length }}"
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="layered-slideshow__background">
          {%- liquid
            assign slide_loading = 'lazy'
            assign slide_priority = 'auto'
            if forloop.first and section.index <= 2
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            endif
            assign slide_focal = 'object-position: ' | append: block.settings.desktop_image.presentation.focal_point | append: ';'
          -%}
          {% if block.settings.desktop_image != blank %}
            <picture>
              {% if block.settings.mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.mobile_image | image_url: width: 550 }} 550w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w, {{ block.settings.mobile_image | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                >
              {% endif %}

              {{
                block.settings.desktop_image
                | image_url: width: 2400
                | image_tag:
                  class: 'layered-slideshow__background-image',
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  style: slide_focal,
                  widths: '750, 1100, 1500, 1800, 2200, 2400',
                  sizes: '100vw',
                  alt: block.settings.desktop_image.alt
              }}
            </picture>
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'layered-slideshow__placeholder' }}
          {% endif %}
        </div>

        <div class="layered-slideshow__overlay"></div>

        <div class="layered-slideshow__container layered-slideshow__container--{{ block.settings.content_position }}">
          <div class="layered-slideshow__content layered-slideshow__content--{{ block.settings.text_alignment }}">
            {% if block.settings.subheading != blank %}
              <p class="layered-slideshow__subheading">
                {{ block.settings.subheading | escape }}
              </p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="layered-slideshow__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="layered-slideshow__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a
                class="layered-slideshow__button"
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {% endif %}
          </div>

          {% if block.settings.layer_image != blank %}
            <div class="layered-slideshow__layer">
              {{
                block.settings.layer_image
                | image_url: width: 1200
                | image_tag:
                  class: 'layered-slideshow__layer-image',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  alt: block.settings.layer_image.alt
              }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="layered-slideshow__controls">
      <button
        type="button"
        class="layered-slideshow__arrow layered-slideshow__arrow--prev"
        aria-label="{{ 'sections.slideshow.previous_slide' | t }}"
        data-prev
      >
        &#10094;
      </button>

      <div class="layered-slideshow__dots" role="group" aria-label="{{ 'sections.slideshow.choose_slide' | t }}">
        {% for block in section.blocks %}
          <button
            type="button"
            class="layered-slideshow__dot{% if forloop.first %} is-active{% endif %}"
            aria-label="{{ 'sections.slideshow.go_to_slide' | t: index: forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            data-slide-to="{{ forloop.index0 }}"
          ></button>
        {% endfor %}
      </div>

      <button
        type="button"
        class="layered-slideshow__arrow layered-slideshow__arrow--next"
        aria-label="{{ 'sections.slideshow.next_slide' | t }}"
        data-next
      >
        &#10095;
      </button>

      {%- if section.settings.autoplay -%}
        <button
          type="button"
          class="layered-slideshow__arrow layered-slideshow__pause"
          aria-label="{{ 'sections.slideshow.pause' | t }}"
          data-label-pause="{{ 'sections.slideshow.pause' | t }}"
          data-label-play="{{ 'sections.slideshow.play' | t }}"
          aria-pressed="false"
          data-pause
        >
          <span aria-hidden="true" data-pause-icon>&#10074;&#10074;</span>
        </button>
      {%- endif -%}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Layered slideshow",
  "tag": "section",
  "class": "section-layered-slideshow",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 350,
      "max": 850,
      "step": 50,
      "unit": "px",
      "default": 650
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 350,
      "max": 750,
      "step": 25,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Automatically change slides",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Time between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop background image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile background image"
        },
        {
          "type": "image_picker",
          "id": "layer_image",
          "label": "Foreground layered image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "New collection"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Discover your style"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Explore our latest collection and find something made for you.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "default": "middle-left",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top center"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-center",
              "label": "Middle center"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom center"
            }
          ]
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Layered slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}