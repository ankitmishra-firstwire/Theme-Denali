          "label": "Image description",
          "info": "For screen readers. Leave empty to use the image's alt text from Files."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parallax strip slider",
      "blocks": [
        { "type": "slide", "settings": { "title": "Fire", "chapter": "Collection 01" } },
