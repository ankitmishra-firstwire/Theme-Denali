{%- comment -%}
  Grid Feature Cards
  Single-file Shopify section: Liquid + CSS + JS + Schema.
  No font family / size / weight is set here, so all text inherits from the theme.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign badge_text = section.settings.badge_text
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
-%}

<style>
  #tf-{{ sid }} {
    --tf-bg: {{ section.settings.bg_color }};
    --tf-heading: {{ section.settings.heading_color }};
    --tf-sub: {{ section.settings.subheading_color }};
    --tf-border: {{ section.settings.border_color }};
    --tf-card-bg: {{ section.settings.card_bg_color }};
    --tf-card-hover-bg: {{ section.settings.card_hover_bg_color }};
    --tf-title: {{ section.settings.title_color }};
    --tf-desc: {{ section.settings.description_color }};
    --tf-icon: {{ section.settings.icon_color }};
    --tf-icon-bg: {{ section.settings.icon_bg_color }};
    --tf-pattern: {{ section.settings.pattern_color }};

    --tf-pt: {{ section.settings.padding_top }}px;
    --tf-pb: {{ section.settings.padding_bottom }}px;
    --tf-max-width: {{ section.settings.container_width }}px;
    --tf-header-width: {{ section.settings.header_width }}px;
    --tf-header-gap: {{ section.settings.header_gap }}px;
    --tf-header-mb: {{ section.settings.header_bottom_space }}px;
    --tf-bw: {{ section.settings.border_width }}px;
    --tf-bstyle: {{ section.settings.border_style }};
    --tf-grid-radius: {{ section.settings.grid_radius }}px;
    --tf-card-pad: {{ section.settings.card_padding }}px;
    --tf-icon-box: {{ section.settings.icon_box_size }}px;
    --tf-icon-size: {{ section.settings.icon_size }}px;
    --tf-icon-stroke: {{ section.settings.icon_stroke }};
    --tf-icon-radius: {{ section.settings.icon_box_radius }}px;
    --tf-title-gap: {{ section.settings.title_top_space }}px;
    --tf-desc-gap: {{ section.settings.description_top_space }}px;
    --tf-pattern-size: {{ section.settings.pattern_size }}px;
    --tf-cols-d: {{ section.settings.columns_desktop }};
    --tf-cols-t: {{ section.settings.columns_tablet }};
    --tf-cols-m: {{ section.settings.columns_mobile }};
    --tf-anim-dur: {{ section.settings.animation_duration }}s;
    --tf-anim-blur: {{ section.settings.animation_blur }}px;
    --tf-anim-shift: {{ section.settings.animation_shift }}px;
    --tf-anim-delay: {{ section.settings.grid_delay }}s;
  }

  #tf-{{ sid }},
  #tf-{{ sid }} *,
  #tf-{{ sid }} *::before,
  #tf-{{ sid }} *::after {
    box-sizing: border-box;
  }

  #tf-{{ sid }} {
    background: var(--tf-bg);
    padding-top: var(--tf-pt);
    padding-bottom: var(--tf-pb);
  }

  #tf-{{ sid }} .tf__container {
    max-width: var(--tf-max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  #tf-{{ sid }} .tf__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: var(--tf-header-width);
    margin: 0 auto var(--tf-header-mb);
    gap: var(--tf-header-gap);
  }

  #tf-{{ sid }} .tf__badge {
    display: inline-block;
    color: {{ section.settings.badge_text_color }};
    background: {{ section.settings.badge_bg_color }};
    border: 1px solid {{ section.settings.badge_border_color }};
    border-radius: {{ section.settings.badge_radius }}px;
    padding: 4px 16px;
  }

  #tf-{{ sid }} .tf__heading {
    margin: 0;
    color: var(--tf-heading);
  }

  #tf-{{ sid }} .tf__subheading {
    margin: 0;
    color: var(--tf-sub);
  }

  /* Grid with dividers between cells and an outer border */
  #tf-{{ sid }} .tf__grid {
    display: grid;
    grid-template-columns: repeat(var(--tf-cols-m), minmax(0, 1fr));
    border-top: var(--tf-bw) var(--tf-bstyle) var(--tf-border);
    border-left: var(--tf-bw) var(--tf-bstyle) var(--tf-border);
    border-radius: var(--tf-grid-radius);
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    #tf-{{ sid }} .tf__grid { grid-template-columns: repeat(var(--tf-cols-t), minmax(0, 1fr)); }
  }

  @media screen and (min-width: 990px) {
    #tf-{{ sid }} .tf__grid { grid-template-columns: repeat(var(--tf-cols-d), minmax(0, 1fr)); }
  }

  #tf-{{ sid }} .tf__card {
    position: relative;
    overflow: hidden;
    padding: var(--tf-card-pad);
    background: var(--tf-card-bg);
    border-right: var(--tf-bw) var(--tf-bstyle) var(--tf-border);
    border-bottom: var(--tf-bw) var(--tf-bstyle) var(--tf-border);
    transition: background-color 0.3s ease;
  }

  #tf-{{ sid }} .tf__card:hover {
    background: var(--tf-card-hover-bg);
  }

  {%- if section.settings.show_pattern %}
  #tf-{{ sid }} .tf__pattern {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100%;
    height: 100%;
    margin-left: -50%;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(farthest-side at top, rgba(0, 0, 0, 0.6), transparent);
    mask-image: radial-gradient(farthest-side at top, rgba(0, 0, 0, 0.6), transparent);
    background-image:
      linear-gradient(to right, var(--tf-pattern) 1px, transparent 1px),
      linear-gradient(to bottom, var(--tf-pattern) 1px, transparent 1px);
    background-size: var(--tf-pattern-size) var(--tf-pattern-size);
    background-position: center top;
  }
  {%- endif %}

  #tf-{{ sid }} .tf__content {
    position: relative;
    z-index: 1;
  }

  #tf-{{ sid }} .tf__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tf-icon-box);
    height: var(--tf-icon-box);
    border-radius: var(--tf-icon-radius);
    background: var(--tf-icon-bg);
    color: var(--tf-icon);
  }

  #tf-{{ sid }} .tf__icon svg,
  #tf-{{ sid }} .tf__icon img {
    width: var(--tf-icon-size);
    height: var(--tf-icon-size);
    display: block;
  }

  #tf-{{ sid }} .tf__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--tf-icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #tf-{{ sid }} .tf__icon img {
    object-fit: contain;
  }

  #tf-{{ sid }} .tf__title {
    margin: var(--tf-title-gap) 0 0;
    color: var(--tf-title);
  }

  #tf-{{ sid }} .tf__desc {
    margin: var(--tf-desc-gap) 0 0;
    color: var(--tf-desc);
  }

  /* Blur-fade entrance (only active once JS has run) */
  #tf-{{ sid }}.tf--ready [data-tf-animate] {
    opacity: 0;
    filter: blur(var(--tf-anim-blur));
    transform: translateY(calc(var(--tf-anim-shift) * -1));
    transition:
      opacity var(--tf-anim-dur) ease,
      filter var(--tf-anim-dur) ease,
      transform var(--tf-anim-dur) ease;
  }

  #tf-{{ sid }}.tf--ready [data-tf-animate="grid"] {
    transition-delay: var(--tf-anim-delay);
  }

  #tf-{{ sid }}.tf--ready [data-tf-animate].tf--in {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #tf-{{ sid }}.tf--ready [data-tf-animate] {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<section
  id="tf-{{ sid }}"
  class="tf"
  data-section-id="{{ sid }}"
  data-section-type="grid-feature-cards"
>
  <div class="tf__container">
    {%- if badge_text != blank or heading != blank or subheading != blank -%}
      <div class="tf__header" data-tf-animate="header">
        {%- if badge_text != blank -%}
          <div class="tf__badge">{{ badge_text | escape }}</div>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="tf__heading">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tf__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tf__grid" data-tf-animate="grid">
        {%- for block in section.blocks -%}
          <div class="tf__card" {{ block.shopify_attributes }}>
            {%- if section.settings.show_pattern -%}
              <div class="tf__pattern" aria-hidden="true"></div>
            {%- endif -%}
            <div class="tf__content">
              {%- if block.settings.image != blank or block.settings.icon != 'none' -%}
                <span class="tf__icon" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 128 | image_tag: loading: 'lazy', widths: '64, 128', alt: '' }}
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'zap' -%}
                        <svg viewBox="0 0 24 24"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                      {%- when 'cpu' -%}
                        <svg viewBox="0 0 24 24"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/></svg>
                      {%- when 'fingerprint' -%}
                        <svg viewBox="0 0 24 24"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></svg>
                      {%- when 'pencil' -%}
                        <svg viewBox="0 0 24 24"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                      {%- when 'settings' -%}
                        <svg viewBox="0 0 24 24"><path d="M14 17H5M19 7h-9"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
                      {%- when 'sparkles' -%}
                        <svg viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="tf__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="tf__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('tf-{{ sid }}');
    if (!root) return;

    var targets = root.querySelectorAll('[data-tf-animate]');
    if (!targets.length) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) return;

    root.classList.add('tf--ready');

    var observer = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('tf--in');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    targets.forEach(function (el) { observer.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Grid Feature Cards",
  "tag": "div",
  "class": "section-grid-feature-cards",
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge_text", "label": "Badge text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Power. Speed. Control." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything you need to build fast, secure, scalable apps." },

    { "type": "header", "content": "Section colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "subheading_color", "label": "Subheading", "default": "#6b6b6b" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#111111" },
    { "type": "color", "id": "badge_bg_color", "label": "Badge background", "default": "#ffffff" },
    { "type": "color", "id": "badge_border_color", "label": "Badge border", "default": "#e5e5e5" },

    { "type": "header", "content": "Card colors" },
    { "type": "color", "id": "border_color", "label": "Grid border and dividers", "default": "#d4d4d4" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_hover_bg_color", "label": "Card hover background", "default": "#f7f7f7" },
    { "type": "color", "id": "title_color", "label": "Card title", "default": "#111111" },
    { "type": "color", "id": "description_color", "label": "Card description", "default": "#6b6b6b" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#111111" },
    { "type": "color", "id": "icon_bg_color", "label": "Icon background", "default": "#00000000" },

    { "type": "header", "content": "Background pattern" },
    { "type": "checkbox", "id": "show_pattern", "label": "Show grid pattern on cards", "default": true },
    { "type": "color", "id": "pattern_color", "label": "Pattern lines", "default": "#00000014" },
    { "type": "range", "id": "pattern_size", "label": "Pattern cell size", "min": 8, "max": 80, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "container_width", "label": "Container max width", "min": 600, "max": 1900, "step": 100, "unit": "px", "default": 1000 },

    { "type": "header", "content": "Header sizes" },
    { "type": "range", "id": "header_width", "label": "Header max width", "min": 240, "max": 900, "step": 10, "unit": "px", "default": 720 },
    { "type": "range", "id": "header_gap", "label": "Space between header items", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "header_bottom_space", "label": "Space below header", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "badge_radius", "label": "Badge corner radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 8 },

    { "type": "header", "content": "Grid layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns on tablet", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns on mobile", "min": 1, "max": 5, "step": 1, "default": 1 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border style",
      "options": [
        { "value": "dashed", "label": "Dashed" },
        { "value": "solid", "label": "Solid" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "dashed"
    },
    { "type": "range", "id": "grid_radius", "label": "Grid corner radius", "min": 0, "max": 48, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Card sizes" },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 8, "max": 96, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_box_size", "label": "Icon box size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_stroke", "label": "Icon line thickness", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "icon_box_radius", "label": "Icon box corner radius", "min": 0, "max": 48, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "title_top_space", "label": "Space above title", "min": 0, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "description_top_space", "label": "Space above description", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 12 },

    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "animation_duration", "label": "Duration", "min": 0.1, "max": 2, "step": 0.1, "unit": "s", "default": 0.8 },
    { "type": "range", "id": "grid_delay", "label": "Grid delay", "min": 0, "max": 2, "step": 0.1, "unit": "s", "default": 0.4 },
    { "type": "range", "id": "animation_blur", "label": "Starting blur", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "animation_shift", "label": "Starting vertical shift", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "zap", "label": "Zap" },
            { "value": "cpu", "label": "Cpu" },
            { "value": "fingerprint", "label": "Fingerprint" },
            { "value": "pencil", "label": "Pencil" },
            { "value": "settings", "label": "Settings" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "zap"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon image (overrides icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Short description of this feature." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Feature Cards",
      "blocks": [
        { "type": "feature", "settings": { "icon": "zap", "title": "Faaast", "description": "It supports an entire helping developers and innovate." } },
        { "type": "feature", "settings": { "icon": "cpu", "title": "Powerful", "description": "It supports an entire helping developers and businesses." } },
        { "type": "feature", "settings": { "icon": "fingerprint", "title": "Security", "description": "It supports an helping developers businesses." } },
        { "type": "feature", "settings": { "icon": "pencil", "title": "Customization", "description": "It supports helping developers and businesses innovate." } },
        { "type": "feature", "settings": { "icon": "settings", "title": "Control", "description": "It supports helping developers and businesses innovate." } },
        { "type": "feature", "settings": { "icon": "sparkles", "title": "Built for AI", "description": "It supports helping developers and businesses innovate." } }
      ]
    }
  ]
}
{% endschema %}