{{ 'product-hotspots.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-hotspots.js' | asset_url }}" defer></script>

<section
  id="ProductHotspots-{{ section.id }}"
  class="product-hotspots"
  data-product-hotspots
>
  <div class="product-hotspots__container page-width">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="product-hotspots__header">
        {% if section.settings.heading != blank %}
          <h2 class="product-hotspots__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="product-hotspots__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-hotspots__stage">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'product-hotspots__image',
            widths: '550, 750, 1100, 1500, 2000',
            sizes: '(min-width: 990px) 100vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'product-hotspots__placeholder' }}
      {% endif %}

      {% for block in section.blocks %}
        {% assign hotspot_product = block.settings.product %}

        {% if hotspot_product != blank %}
          <div
            class="product-hotspots__point"
            style="--hotspot-x: {{ block.settings.horizontal_position }}%; --hotspot-y: {{ block.settings.vertical_position }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              class="product-hotspots__trigger"
              type="button"
              aria-expanded="false"
              aria-label="View {{ hotspot_product.title | escape }}"
              aria-controls="HotspotCard-{{ section.id }}-{{ block.id }}"
              data-hotspot-trigger
            >
              <span class="product-hotspots__pulse"></span>
              <span class="visually-hidden">
                View {{ hotspot_product.title | escape }}
              </span>
            </button>

            <div
              id="HotspotCard-{{ section.id }}-{{ block.id }}"
              class="product-hotspots__card"
              data-hotspot-card
              hidden
            >
              {% if hotspot_product.featured_image != blank %}
                <a
                  href="{{ hotspot_product.url }}"
                  class="product-hotspots__product-image-link"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {{
                    hotspot_product.featured_image
                    | image_url: width: 240
                    | image_tag:
                      class: 'product-hotspots__product-image',
                      loading: 'lazy',
                      widths: '120, 180, 240',
                      sizes: '120px'
                  }}
                </a>
              {% endif %}

              <div class="product-hotspots__product-info">
                <a
                  href="{{ hotspot_product.url }}"
                  class="product-hotspots__product-title"
                >
                  {{ hotspot_product.title | escape }}
                </a>

                <div class="product-hotspots__price">
                  {% if hotspot_product.compare_at_price > hotspot_product.price %}
                    <span class="product-hotspots__sale-price">
                      {{ hotspot_product.price | money }}
                    </span>
                    <s class="product-hotspots__compare-price">
                      {{ hotspot_product.compare_at_price | money }}
                    </s>
                  {% else %}
                    {{ hotspot_product.price | money }}
                  {% endif %}
                </div>

                <a
                  href="{{ hotspot_product.url }}"
                  class="product-hotspots__view-link"
                >
                  {{ section.settings.link_label | escape }}
                </a>
              </div>

              <button
                type="button"
                class="product-hotspots__close"
                aria-label="Close product details"
                data-hotspot-close
              >
                &times;
              </button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product hotspots",
  "tag": "section",
  "class": "section-product-hotspots",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the products featured in this image.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Product link label",
      "default": "View product"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical_position",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product hotspots",
      "blocks": [
        {
          "type": "hotspot"
        }
      ]
    }
  ]
}
{% endschema %}