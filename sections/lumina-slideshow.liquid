{%- comment -%}
  Lumina slideshow
  ---------------------------------------------------------------------------
  Shopify port of the React "lumina-interactive-list" component:
  full-width image slideshow with a WebGL "glass" transition, animated
  titles (six reveal styles), a numbered counter and a progress-line
  navigation that fills while each slide plays.

  - Glass transition uses three.js r128 (loaded from cdnjs only when the
    section scrolls into view). GSAP is not needed: text animations use the
    browser's built-in Web Animations API.
  - If WebGL, three.js or an image's cross-origin access is unavailable, the
    slideshow falls back to a smooth crossfade. Content always stays visible.
  - Typography: no font-family, font-style or font-weight is set. Titles use
    your theme's heading font, everything else the body font.
  - Respects prefers-reduced-motion, pauses when off screen, on hover,
    on keyboard focus and when the browser tab is hidden.

  File: sections/lumina-slideshow.liquid
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign slide_count = section.blocks.size

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_rgba = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  assign overlay_clear = section.settings.overlay_color | color_modify: 'alpha', 0
  case section.settings.overlay_style
    when 'solid'
      assign overlay_bg = overlay_rgba
    when 'gradient-bottom'
      assign overlay_bg = 'linear-gradient(to top, ' | append: overlay_rgba | append: ' 0%, ' | append: overlay_clear | append: ' 70%)'
    when 'gradient-left'
      assign overlay_bg = 'linear-gradient(to right, ' | append: overlay_rgba | append: ' 0%, ' | append: overlay_clear | append: ' 75%)'
    else
      assign overlay_bg = 'none'
  endcase

  assign desc_alpha = section.settings.description_opacity | divided_by: 100.0
  assign desc_color = section.settings.text_color | color_modify: 'alpha', desc_alpha
  assign nav_dim = section.settings.nav_color | color_modify: 'alpha', 0.5
  assign nav_line = section.settings.nav_color | color_modify: 'alpha', 0.25

  assign title_lh = section.settings.title_line_height | divided_by: 100.0
  assign title_ls = section.settings.title_letter_spacing | divided_by: 100.0
  assign intensity = section.settings.effect_intensity | divided_by: 100.0
  assign interval_ms = section.settings.slide_duration | times: 1000

  assign has_nav = false
  if section.settings.show_navigation and slide_count > 1
    assign has_nav = true
  endif
-%}

{% style %}
  .lumina--{{ sid }} {
    --lumina-h: {{ section.settings.height_desktop }};
    --lumina-h-m: {{ section.settings.height_mobile }};
    --lumina-pad-x-d: {{ section.settings.padding_x }}px;
    --lumina-pad-x-m: {{ section.settings.padding_x_mobile }}px;
    --lumina-pad-y-d: {{ section.settings.padding_y }}px;
    --lumina-pad-y-m: {{ section.settings.padding_y_mobile }}px;
    --lumina-content-w: {{ section.settings.content_width }}px;
    --lumina-gap: {{ section.settings.content_spacing }}px;

    --lumina-title-fs-d: {{ section.settings.title_size }}px;
    --lumina-title-fs-m: {{ section.settings.title_size_mobile }}px;
    --lumina-title-lh: {{ title_lh }};
    --lumina-title-ls: {{ title_ls }}em;
    --lumina-desc-fs-d: {{ section.settings.description_size }}px;
    --lumina-desc-fs-m: {{ section.settings.description_size_mobile }}px;
    --lumina-nav-fs: {{ section.settings.nav_size }}px;
    --lumina-btn-fs: {{ section.settings.button_size }}px;
    --lumina-btn-radius: {{ section.settings.button_radius }}px;

    --lumina-bg: {{ section.settings.background }};
    --lumina-text: {{ section.settings.text_color }};
    --lumina-desc: {{ desc_color }};
    --lumina-nav: {{ section.settings.nav_color }};
    --lumina-nav-dim: {{ nav_dim }};
    --lumina-line: {{ nav_line }};
    --lumina-progress: {{ section.settings.progress_color }};
    --lumina-btn-bg: {{ section.settings.button_background }};
    --lumina-btn-text: {{ section.settings.button_text }};
    --lumina-overlay: {{ overlay_bg }};
  }
{% endstyle %}

{%- if slide_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="lumina-empty">Add a slide to start building your slideshow.</div>
  {%- endif -%}
{%- else -%}
<lumina-slider
  class="lumina lumina--{{ sid }}{% if has_nav %} lumina--has-nav{% endif %}"
  data-position="{{ section.settings.content_position }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ interval_ms }}"
  data-transition="{{ section.settings.transition_duration }}"
  data-effect="{{ section.settings.effect }}"
  data-glass-preset="{{ section.settings.glass_preset }}"
  data-intensity="{{ intensity }}"
  data-text-animation="{{ section.settings.text_animation }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessible_label | escape }}"
>
  {%- comment -%} ===== Images (crossfade fallback + texture sources for WebGL) ===== {%- endcomment -%}
  <div class="lumina__media">
    {%- for block in section.blocks -%}
      {%- liquid
        assign img = block.settings.image
        assign img_m = block.settings.mobile_image
        assign tex = ''
        assign tex_m = ''
        if img != blank
          assign tex = img | image_url: width: 2000
        elsif block.settings.image_url != blank
          assign tex = block.settings.image_url
        endif
        if img_m != blank
          assign tex_m = img_m | image_url: width: 1200
        endif
        assign alt = block.settings.image_alt | default: img.alt | default: block.settings.title
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        else
          assign loading = 'lazy'
          assign priority = 'auto'
        endif
      -%}
      <div class="lumina__slide-media{% if forloop.first %} is-active{% endif %}" data-texture="{{ tex }}" data-texture-mobile="{{ tex_m }}">
        {%- if img != blank -%}
          {%- assign focal = 'object-position: ' | append: img.presentation.focal_point -%}
          <picture>
            {%- if img_m != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w, {{ img_m | image_url: width: 1500 }} 1500w"
                sizes="100vw"
              >
            {%- endif -%}
            {{ img | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2500, 3000', sizes: '100vw', class: 'lumina__img', loading: loading, fetchpriority: priority, alt: alt, style: focal }}
          </picture>
        {%- elsif block.settings.image_url != blank -%}
          <img class="lumina__img" src="{{ block.settings.image_url }}" alt="{{ alt | escape }}" loading="{{ loading }}" fetchpriority="{{ priority }}">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'lumina__img lumina__img--placeholder' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
    <canvas class="lumina__canvas" aria-hidden="true"></canvas>
    <div class="lumina__overlay"></div>
  </div>

  {%- comment -%} ===== Counter + pause button ===== {%- endcomment -%}
  {%- if slide_count > 1 -%}
    {%- if section.settings.show_counter or section.settings.autoplay -%}
      <div class="lumina__topbar">
        {%- if section.settings.show_counter -%}
          <div class="lumina__counter" aria-hidden="true">
            <span data-counter-current>01</span>
            <span class="lumina__counter-sep"></span>
            <span>{% if slide_count < 10 %}0{% endif %}{{ slide_count }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.autoplay -%}
          <button type="button" class="lumina__pause" data-paused="false" aria-label="Pause slideshow">
            <svg data-icon="pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
            <svg data-icon="play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ===== Slide text ===== {%- endcomment -%}
  <div class="lumina__content" aria-live="off">
    <div class="lumina__panels">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = section.settings.title_tag
          if tag == 'h1' and forloop.first == false
            assign tag = 'h2'
          endif
        -%}
        <div
          class="lumina__panel"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          {{ block.shopify_attributes }}
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if block.settings.title != blank -%}
            <{{ tag }} class="lumina__title">{{ block.settings.title | escape }}</{{ tag }}>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="lumina__desc">{{ block.settings.description | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <div class="lumina__actions">
              <a class="lumina__button lumina__button--{{ section.settings.button_style }}" href="{{ block.settings.button_link | default: '/collections/all' }}">
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===== Slide navigation with progress lines ===== {%- endcomment -%}
  {%- if has_nav -%}
    <div class="lumina__nav" role="group" aria-label="Choose a slide">
      {%- for block in section.blocks -%}
        {%- assign nav_label = block.settings.nav_label | default: block.settings.title | default: 'Slide' -%}
        <button
          type="button"
          class="lumina__nav-item{% if forloop.first %} is-active{% endif %}"
          aria-label="{{ nav_label | escape }}, slide {{ forloop.index }} of {{ forloop.length }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        >
          <span class="lumina__line"><span class="lumina__fill"></span></span>
          <span class="lumina__nav-title">{{ nav_label | escape }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</lumina-slider>
{%- endif -%}

{% stylesheet %}
  /* No font-family, font-style or font-weight is defined in this section.
     Buttons use "font: inherit" only so they pick up the theme font instead
     of the browser's default button font. */

  .lumina-empty {
    padding: 48px 20px;
    text-align: center;
    opacity: 0.7;
  }

  lumina-slider {
    display: block;
  }

  .lumina {
    --lumina-pad-x: var(--lumina-pad-x-m);
    --lumina-pad-y: var(--lumina-pad-y-m);
    --lumina-title-fs: var(--lumina-title-fs-m);
    --lumina-desc-fs: var(--lumina-desc-fs-m);
    --lumina-topbar-space: 52px;
    --lumina-nav-space: 0px;

    position: relative;
    overflow: hidden;
    isolation: isolate;
    height: calc(var(--lumina-h-m) * 1vh);
    height: calc(var(--lumina-h-m) * 1svh);
    min-height: 480px;
    background: var(--lumina-bg);
    color: var(--lumina-text);
  }

  .lumina--has-nav {
    --lumina-nav-space: calc(var(--lumina-nav-fs) * 1.3 + 40px);
  }

  @media screen and (min-width: 750px) {
    .lumina {
      --lumina-pad-x: var(--lumina-pad-x-d);
      --lumina-pad-y: var(--lumina-pad-y-d);
      --lumina-title-fs: var(--lumina-title-fs-d);
      --lumina-desc-fs: var(--lumina-desc-fs-d);
      height: calc(var(--lumina-h) * 1vh);
      height: calc(var(--lumina-h) * 1svh);
      min-height: 520px;
    }
  }

  .lumina__sr {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Media ---------- */
  .lumina__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .lumina__slide-media {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--lumina-fade, 1000ms) ease;
  }

  .lumina__slide-media.is-leaving {
    z-index: 1;
    opacity: 1;
    transition: none;
  }

  .lumina__slide-media.is-active {
    z-index: 2;
    opacity: 1;
  }

  .lumina__slide-media picture,
  .lumina__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lumina__img {
    object-fit: cover;
  }

  .lumina__img--placeholder {
    background: rgba(255, 255, 255, 0.06);
    fill: rgba(255, 255, 255, 0.25);
  }

  .lumina__canvas {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .lumina.is-webgl .lumina__canvas {
    opacity: 1;
  }

  .lumina__overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: var(--lumina-overlay);
    pointer-events: none;
  }

  /* ---------- Text ---------- */
  .lumina__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding:
      calc(var(--lumina-pad-y) + var(--lumina-topbar-space))
      var(--lumina-pad-x)
      calc(var(--lumina-pad-y) + var(--lumina-nav-space));
    text-align: left;
    pointer-events: none;
  }

  .lumina[data-position='bottom-center'] .lumina__content {
    justify-content: center;
    text-align: center;
  }

  .lumina[data-position='middle-left'] .lumina__content {
    align-items: center;
  }

  .lumina[data-position='middle-center'] .lumina__content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .lumina__panels {
    width: 100%;
    max-width: var(--lumina-content-w);
    pointer-events: auto;
  }

  .lumina__panel[hidden] {
    display: none;
  }

  .lumina .lumina__title {
    margin: 0;
    font-size: var(--lumina-title-fs);
    line-height: var(--lumina-title-lh);
    letter-spacing: var(--lumina-title-ls);
    color: var(--lumina-text);
    text-wrap: balance;
  }

  .lumina__word {
    display: inline-block;
    white-space: nowrap;
    perspective: 600px;
  }

  .lumina__char {
    display: inline-block;
  }

  .lumina .lumina__desc {
    margin: var(--lumina-gap) 0 0;
    max-width: 46ch;
    font-size: var(--lumina-desc-fs);
    line-height: 1.5;
    color: var(--lumina-desc);
  }

  .lumina[data-position$='center'] .lumina__desc {
    margin-left: auto;
    margin-right: auto;
  }

  .lumina__actions {
    margin-top: calc(var(--lumina-gap) * 1.5);
  }

  .lumina__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.85em 1.75em;
    font-size: var(--lumina-btn-fs);
    line-height: 1.2;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--lumina-btn-radius);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .lumina__button--solid {
    background: var(--lumina-btn-bg);
    color: var(--lumina-btn-text);
  }

  .lumina__button--solid:hover {
    opacity: 0.85;
  }

  .lumina__button--outline {
    background: transparent;
    color: var(--lumina-text);
    border-color: var(--lumina-text);
  }

  .lumina__button--outline:hover {
    background: var(--lumina-text);
    color: var(--lumina-bg);
  }

  .lumina__button--link {
    min-height: 0;
    padding: 0;
    color: var(--lumina-text);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .lumina__button:focus-visible {
    outline: 2px solid var(--lumina-text);
    outline-offset: 3px;
  }

  /* Hide the first slide's text until its intro animation starts (JS only) */
  .lumina.is-intro-pending .lumina__panel:not([hidden]) .lumina__char,
  .lumina.is-intro-pending .lumina__panel:not([hidden]) .lumina__desc,
  .lumina.is-intro-pending .lumina__panel:not([hidden]) .lumina__actions {
    opacity: 0;
  }

  /* ---------- Counter + pause ---------- */
  .lumina__topbar {
    position: absolute;
    top: var(--lumina-pad-y);
    right: var(--lumina-pad-x);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--lumina-nav);
    font-size: var(--lumina-nav-fs);
    line-height: 1;
  }

  .lumina__counter {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lumina__counter-sep {
    width: 28px;
    height: 1px;
    background: var(--lumina-line);
  }

  .lumina__pause {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    margin: 0;
    color: inherit;
    background: transparent;
    border: 1px solid var(--lumina-line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .lumina__pause:hover {
    border-color: var(--lumina-nav);
  }

  .lumina__pause:focus-visible {
    outline: 2px solid var(--lumina-nav);
    outline-offset: 3px;
  }

  .lumina__pause[hidden] {
    display: none;
  }

  .lumina__pause svg {
    width: 14px;
    height: 14px;
  }

  .lumina__pause [data-icon='play'],
  .lumina__pause[data-paused='true'] [data-icon='pause'] {
    display: none;
  }

  .lumina__pause[data-paused='true'] [data-icon='play'] {
    display: block;
  }

  /* ---------- Navigation ---------- */
  .lumina__nav {
    position: absolute;
    left: var(--lumina-pad-x);
    right: var(--lumina-pad-x);
    bottom: var(--lumina-pad-y);
    z-index: 3;
    display: flex;
    gap: 16px;
    padding: 6px;
    margin: -6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .lumina__nav::-webkit-scrollbar {
    display: none;
  }

  .lumina__nav-item {
    appearance: none;
    flex: 1 0 120px;
    display: block;
    min-width: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--lumina-nav);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    .lumina__nav {
      gap: 24px;
    }

    .lumina__nav-item {
      flex: 1 1 0;
    }
  }

  .lumina__line {
    display: block;
    height: 2px;
    overflow: hidden;
    background: var(--lumina-line);
    border-radius: 2px;
  }

  .lumina__fill {
    display: block;
    height: 100%;
    background: var(--lumina-progress);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }

  .lumina__nav-item.is-active .lumina__fill {
    transition: none;
  }

  .lumina__nav-title {
    display: block;
    margin-top: 10px;
    overflow: hidden;
    font-size: var(--lumina-nav-fs);
    line-height: 1.3;
    color: var(--lumina-nav-dim);
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }

  .lumina__nav-item:hover .lumina__nav-title,
  .lumina__nav-item.is-active .lumina__nav-title {
    color: var(--lumina-nav);
  }

  .lumina__nav-item:focus-visible {
    outline: 2px solid var(--lumina-nav);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lumina__slide-media,
    .lumina__canvas,
    .lumina__fill,
    .lumina__nav-title {
      transition-duration: 0.01ms;
    }
  }
{% endstylesheet %}

{%- comment -%}
  The script sits right after the markup (not in a javascript tag) so the
  slideshow is set up before the first paint and the title never flashes.
{%- endcomment -%}
<script>
  (() => {
    if (customElements.get('lumina-slider')) return;

    const THREE_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canAnimate = typeof Element !== 'undefined' && typeof Element.prototype.animate === 'function';

    /* ---------- three.js loader (shared by every slideshow on the page) ---------- */
    const loadThree = () => {
      if (window.THREE) return Promise.resolve(window.THREE);
      if (!window.__luminaThree) {
        window.__luminaThree = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = THREE_SRC;
          script.async = true;
          script.onload = () => (window.THREE ? resolve(window.THREE) : reject(new Error('three.js did not load')));
          script.onerror = () => {
            window.__luminaThree = null;
            reject(new Error('Could not load ' + THREE_SRC));
          };
          document.head.appendChild(script);
        });
      }
      return window.__luminaThree;
    };

    const webglSupported = () => {
      try {
        const canvas = document.createElement('canvas');
        const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (!gl) return false;
        const lose = gl.getExtension('WEBGL_lose_context');
        if (lose) lose.loseContext();
        return true;
      } catch (e) {
        return false;
      }
    };

    /* ---------- Glass transition (from the original shader) ---------- */
    const GLASS_PRESETS = {
      subtle: { refraction: 0.6, chromatic: 0.5, clarity: 1.3, edgeGlow: 0.7, liquidFlow: 0.8 },
      default: { refraction: 1.0, chromatic: 1.0, clarity: 1.0, edgeGlow: 1.0, liquidFlow: 1.0 },
      crystal: { refraction: 1.5, chromatic: 1.8, clarity: 0.7, edgeGlow: 1.4, liquidFlow: 0.5 },
      liquid: { refraction: 0.8, chromatic: 0.4, clarity: 1.2, edgeGlow: 0.8, liquidFlow: 1.8 }
    };

    const VERTEX_SHADER = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;

    const FRAGMENT_SHADER = `
      uniform sampler2D uTexture1;
      uniform sampler2D uTexture2;
      uniform float uProgress;
      uniform vec2 uResolution;
      uniform vec2 uTexture1Size;
      uniform vec2 uTexture2Size;
      uniform float uIntensity;
      uniform float uRefraction;
      uniform float uChromatic;
      uniform float uClarity;
      uniform float uEdgeGlow;
      uniform float uLiquidFlow;
      varying vec2 vUv;

      vec2 coverUV(vec2 uv, vec2 size) {
        vec2 s = uResolution / size;
        float scale = max(s.x, s.y);
        vec2 scaled = size * scale;
        vec2 offset = (uResolution - scaled) * 0.5;
        return (uv * uResolution - offset) / scaled;
      }

      void main() {
        float progress = uProgress;
        float time = progress * 5.0;
        vec2 uv1 = coverUV(vUv, uTexture1Size);
        vec2 uv2 = coverUV(vUv, uTexture2Size);
        float maxR = length(uResolution) * 0.85;
        float br = progress * maxR;
        vec2 p = vUv * uResolution;
        vec2 c = uResolution * 0.5;
        float d = length(p - c);
        float nd = d / max(br, 0.001);
        float inside = 1.0 - smoothstep(br - 3.0, br + 3.0, d);

        vec4 nextImg = texture2D(uTexture2, uv2);
        vec4 img = nextImg;
        if (inside > 0.0) {
          float ro = 0.08 * uRefraction * uIntensity * pow(smoothstep(0.3 * uClarity, 1.0, nd), 1.5);
          vec2 dir = d > 0.0 ? (p - c) / d : vec2(0.0);
          vec2 duv = uv2 - dir * ro;
          duv += vec2(sin(time + nd * 10.0), cos(time * 0.8 + nd * 8.0)) * 0.015 * uLiquidFlow * nd * inside;
          float ca = 0.02 * uChromatic * uIntensity * pow(smoothstep(0.3, 1.0, nd), 1.2);
          img = vec4(
            texture2D(uTexture2, duv + dir * ca * 1.2).r,
            texture2D(uTexture2, duv + dir * ca * 0.2).g,
            texture2D(uTexture2, duv - dir * ca * 0.8).b,
            1.0
          );
          float rim = smoothstep(0.95, 1.0, nd) * (1.0 - smoothstep(1.0, 1.01, nd));
          img.rgb += rim * 0.08 * uEdgeGlow * uIntensity;
        }
        if (progress > 0.95) img = mix(img, nextImg, (progress - 0.95) / 0.05);
        gl_FragColor = mix(texture2D(uTexture1, uv1), img, inside);
      }
    `;

    class GlassRenderer {
      constructor(canvas, { preset, intensity }) {
        this.canvas = canvas;
        this.preset = GLASS_PRESETS[preset] || GLASS_PRESETS.default;
        this.intensity = intensity;
        this.textures = [];
        this.raf = null;
        this.doneCb = null;
        this.disposed = false;
      }

      async init(urls) {
        const THREE = await loadThree();
        if (this.disposed) throw new Error('Slideshow removed');
        this.THREE = THREE;

        const loader = new THREE.TextureLoader();
        loader.setCrossOrigin('anonymous');
        const load = (url) =>
          new Promise((resolve, reject) => {
            loader.load(
              url,
              (texture) => {
                texture.minFilter = THREE.LinearFilter;
                texture.magFilter = THREE.LinearFilter;
                texture.generateMipmaps = false;
                const image = texture.image;
                texture.userData.size = new THREE.Vector2(image.naturalWidth || image.width, image.naturalHeight || image.height);
                resolve(texture);
              },
              undefined,
              () => reject(new Error('Image could not be used for the glass effect: ' + url))
            );
          });

        this.textures = await Promise.all(urls.map(load));
        if (this.disposed) {
          this.textures.forEach((t) => t.dispose());
          throw new Error('Slideshow removed');
        }

        this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, antialias: false, alpha: false, powerPreference: 'high-performance' });
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.scene = new THREE.Scene();
        this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        const first = this.textures[0];
        this.uniforms = {
          uTexture1: { value: first },
          uTexture2: { value: first },
          uProgress: { value: 0 },
          uResolution: { value: new THREE.Vector2(1, 1) },
          uTexture1Size: { value: first.userData.size },
          uTexture2Size: { value: first.userData.size },
          uIntensity: { value: this.intensity },
          uRefraction: { value: this.preset.refraction },
          uChromatic: { value: this.preset.chromatic },
          uClarity: { value: this.preset.clarity },
          uEdgeGlow: { value: this.preset.edgeGlow },
          uLiquidFlow: { value: this.preset.liquidFlow }
        };
        this.geometry = new THREE.PlaneGeometry(2, 2);
        this.material = new THREE.ShaderMaterial({ uniforms: this.uniforms, vertexShader: VERTEX_SHADER, fragmentShader: FRAGMENT_SHADER });
        this.scene.add(new THREE.Mesh(this.geometry, this.material));
      }

      setSize(width, height) {
        if (!this.renderer || this.disposed || !width || !height) return;
        this.renderer.setSize(width, height, false);
        this.uniforms.uResolution.value.set(width, height);
        this.render();
      }

      show(index) {
        if (!this.renderer || this.disposed) return;
        const texture = this.textures[index];
        const u = this.uniforms;
        u.uTexture1.value = texture;
        u.uTexture2.value = texture;
        u.uTexture1Size.value = texture.userData.size;
        u.uTexture2Size.value = texture.userData.size;
        u.uProgress.value = 0;
        this.render();
      }

      transition(from, to, duration, done) {
        if (this.raf) cancelAnimationFrame(this.raf);
        const u = this.uniforms;
        const a = this.textures[from];
        const b = this.textures[to];
        u.uTexture1.value = a;
        u.uTexture1Size.value = a.userData.size;
        u.uTexture2.value = b;
        u.uTexture2Size.value = b.userData.size;
        u.uProgress.value = 0;
        this.doneCb = done;

        const start = performance.now();
        const step = (now) => {
          if (this.disposed) return;
          const t = Math.min((now - start) / duration, 1);
          // power2.inOut
          u.uProgress.value = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          this.render();
          if (t < 1) {
            this.raf = requestAnimationFrame(step);
          } else {
            this.raf = null;
            this.show(to);
            const cb = this.doneCb;
            this.doneCb = null;
            if (cb) cb();
          }
        };
        this.raf = requestAnimationFrame(step);
      }

      render() {
        if (this.renderer && !this.disposed) this.renderer.render(this.scene, this.camera);
      }

      dispose() {
        if (this.disposed) return;
        this.disposed = true;
        if (this.raf) cancelAnimationFrame(this.raf);
        this.raf = null;
        this.textures.forEach((t) => t.dispose());
        if (this.material) this.material.dispose();
        if (this.geometry) this.geometry.dispose();
        if (this.renderer) {
          this.renderer.dispose();
          this.renderer.forceContextLoss();
        }
        const cb = this.doneCb;
        this.doneCb = null;
        if (cb) cb();
      }
    }

    /* ---------- Title animations (match the original GSAP versions) ---------- */
    const EASE = {
      power3Out: 'cubic-bezier(0.215, 0.61, 0.355, 1)',
      power2Out: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
      power2In: 'cubic-bezier(0.55, 0.085, 0.68, 0.53)',
      back17: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
      back15: 'cubic-bezier(0.34, 1.45, 0.64, 1)'
    };

    const VARIANTS = {
      rise: { from: { opacity: 0, transform: 'translateY(20px)' }, to: { opacity: 1, transform: 'translateY(0)' }, duration: 800, stagger: 30, easing: EASE.power3Out },
      drop: { from: { opacity: 0, transform: 'translateY(-20px)' }, to: { opacity: 1, transform: 'translateY(0)' }, duration: 800, stagger: 30, easing: EASE.back17 },
      blur: { from: { opacity: 0, transform: 'scale(1.5)', filter: 'blur(10px)' }, to: { opacity: 1, transform: 'scale(1)', filter: 'blur(0px)' }, duration: 1000, random: 500, easing: EASE.power2Out },
      scale: { from: { opacity: 0, transform: 'scale(0)' }, to: { opacity: 1, transform: 'scale(1)' }, duration: 600, stagger: 50, easing: EASE.back15 },
      flip: { from: { opacity: 0, transform: 'rotateX(90deg)' }, to: { opacity: 1, transform: 'rotateX(0deg)' }, duration: 800, stagger: 40, easing: EASE.power2Out },
      slide: { from: { opacity: 0, transform: 'translateX(30px)' }, to: { opacity: 1, transform: 'translateX(0)' }, duration: 800, stagger: 30, easing: EASE.power3Out }
    };
    const ORDER = ['rise', 'drop', 'blur', 'scale', 'flip', 'slide'];

    const cancelAnims = (el) => {
      if (el.getAnimations) el.getAnimations().forEach((a) => a.cancel());
    };
    const pad = (n) => String(n).padStart(2, '0');

    /* ---------- Slideshow element ---------- */
    class LuminaSlider extends HTMLElement {
      constructor() {
        super();
        this.pauses = new Set();
        this.timers = new Set();
        this.raf = null;
        this.bound = false;
      }

      later(fn, ms) {
        const id = setTimeout(() => {
          this.timers.delete(id);
          fn();
        }, ms);
        this.timers.add(id);
        return id;
      }

      connectedCallback() {
        this.panels = Array.from(this.querySelectorAll('.lumina__panel'));
        this.count = this.panels.length;
        if (!this.count) return;

        this.disconnected = false;
        this.slidesMedia = Array.from(this.querySelectorAll('.lumina__slide-media'));
        this.mediaWrap = this.querySelector('.lumina__media');
        this.canvas = this.querySelector('.lumina__canvas');
        this.navList = this.querySelector('.lumina__nav');
        this.navItems = Array.from(this.querySelectorAll('.lumina__nav-item'));
        this.fills = this.navItems.map((item) => item.querySelector('.lumina__fill'));
        this.counterEl = this.querySelector('[data-counter-current]');
        this.pauseBtn = this.querySelector('.lumina__pause');
        this.contentWrap = this.querySelector('.lumina__content');

        const visible = this.panels.findIndex((p) => !p.hidden);
        this.current = visible < 0 ? 0 : visible;
        this.busy = false;
        this.elapsed = 0;
        this.pending = null;
        this.pendingUpgrade = false;
        this.gl = null;
        this.glReady = false;
        this.glTried = false;

        this.reduced = reduceMotion.matches;
        this.autoplay = this.dataset.autoplay === 'true' && this.count > 1 && !this.reduced;
        this.interval = Math.max(1000, Number(this.dataset.interval) || 5000);
        this.transitionMs = Math.max(300, (Number(this.dataset.transition) || 2.5) * 1000);
        this.effect = this.dataset.effect || 'glass';
        this.textAnimation = this.reduced || !canAnimate ? 'none' : this.dataset.textAnimation || 'varied';
        this.fadeMs = this.reduced ? 300 : this.effect === 'fade' ? this.transitionMs : Math.min(this.transitionMs, 1200);
        this.style.setProperty('--lumina-fade', this.fadeMs + 'ms');

        this.panels.forEach((panel) => this.splitTitle(panel));

        if (!this.bound) {
          this.bound = true;
          this.navItems.forEach((item, i) => item.addEventListener('click', () => this.goTo(i)));
          if (this.navList) this.navList.addEventListener('keydown', this.onNavKeydown);
          if (this.pauseBtn) this.pauseBtn.addEventListener('click', this.togglePause);
          this.addEventListener('pointerenter', this.onPointerEnter);
          this.addEventListener('pointerleave', this.onPointerLeave);
          this.addEventListener('focusin', this.onFocusIn);
          this.addEventListener('focusout', this.onFocusOut);
        }

        document.addEventListener('visibilitychange', this.onVisibility);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        document.addEventListener('shopify:block:deselect', this.onBlockDeselect);

        // Wait until the section is on screen before playing anything.
        this.pauses.add('offscreen');
        if (this.textAnimation !== 'none' && !this.introDone) this.classList.add('is-intro-pending');

        this.io = new IntersectionObserver(this.onIntersect, { threshold: 0.15 });
        this.io.observe(this);
        if (window.ResizeObserver && this.mediaWrap) {
          this.ro = new ResizeObserver(this.onResize);
          this.ro.observe(this.mediaWrap);
        }

        this.updateUI();
        this.updatePauseButton();
        this.updateRunning();
      }

      disconnectedCallback() {
        this.disconnected = true;
        this.stopTicker();
        this.timers.forEach(clearTimeout);
        this.timers.clear();
        if (this.io) this.io.disconnect();
        if (this.ro) this.ro.disconnect();
        document.removeEventListener('visibilitychange', this.onVisibility);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
        this.teardownGL();
      }

      /* Split the title into characters for the animation; screen readers get the plain text. */
      splitTitle(panel) {
        const title = panel.querySelector('.lumina__title');
        if (!title || title.dataset.split) return;
        const text = title.textContent.replace(/\s+/g, ' ').trim();
        title.dataset.split = 'true';
        title.textContent = '';

        const sr = document.createElement('span');
        sr.className = 'lumina__sr';
        sr.textContent = text;

        const visual = document.createElement('span');
        visual.setAttribute('aria-hidden', 'true');
        const words = text.split(' ');
        words.forEach((word, i) => {
          const w = document.createElement('span');
          w.className = 'lumina__word';
          for (const ch of word) {
            const c = document.createElement('span');
            c.className = 'lumina__char';
            c.textContent = ch;
            w.appendChild(c);
          }
          visual.appendChild(w);
          if (i < words.length - 1) visual.appendChild(document.createTextNode(' '));
        });

        title.append(sr, visual);
      }

      variantFor(index) {
        return this.textAnimation === 'varied' ? ORDER[index % ORDER.length] : this.textAnimation;
      }

      animateIn(panel, name, baseDelay = 0) {
        const v = VARIANTS[name] || VARIANTS.rise;
        const chars = panel.querySelectorAll('.lumina__char');
        const stagger = Math.min(v.stagger || 0, 900 / Math.max(chars.length, 1));
        chars.forEach((c, i) => {
          cancelAnims(c);
          const delay = baseDelay + (v.random ? Math.random() * v.random : i * stagger);
          c.animate([v.from, v.to], { duration: v.duration, delay, easing: v.easing, fill: 'both' });
        });
        panel.querySelectorAll('.lumina__desc, .lumina__actions').forEach((el, i) => {
          cancelAnims(el);
          el.animate(
            [{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 800, delay: baseDelay + 200 + i * 120, easing: EASE.power3Out, fill: 'both' }
          );
        });
      }

      animateOut(panel) {
        const chars = panel.querySelectorAll('.lumina__char');
        const stagger = Math.min(20, 150 / Math.max(chars.length, 1));
        chars.forEach((c, i) => {
          cancelAnims(c);
          c.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-20px)' }],
            { duration: 350, delay: i * stagger, easing: EASE.power2In, fill: 'both' }
          );
        });
        panel.querySelectorAll('.lumina__desc, .lumina__actions').forEach((el) => {
          cancelAnims(el);
          el.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-10px)' }],
            { duration: 400, easing: EASE.power2In, fill: 'both' }
          );
        });
      }

      resetPanel(panel) {
        panel.querySelectorAll('.lumina__char, .lumina__desc, .lumina__actions').forEach(cancelAnims);
      }

      playIntro() {
        if (this.textAnimation !== 'none') {
          const name = this.textAnimation === 'varied' ? 'rise' : this.textAnimation;
          this.animateIn(this.panels[this.current], name, 300);
        }
        this.classList.remove('is-intro-pending');
      }

      swapText(from, to) {
        const out = this.panels[from];
        const incoming = this.panels[to];
        if (this.textAnimation === 'none') {
          out.hidden = true;
          incoming.hidden = false;
          return;
        }
        this.animateOut(out);
        this.later(() => {
          this.resetPanel(out);
          out.hidden = true;
          incoming.hidden = false;
          this.animateIn(incoming, this.variantFor(to));
        }, 500);
      }

      goTo(target) {
        if (this.count < 2) return;
        const to = ((target % this.count) + this.count) % this.count;
        if (to === this.current) return;
        if (this.busy) {
          this.pending = to;
          return;
        }

        if (!this.introDone) {
          this.introDone = true;
          this.classList.remove('is-intro-pending');
        }

        const from = this.current;
        this.busy = true;
        this.current = to;
        this.elapsed = 0;
        this.stopTicker();

        const outMedia = this.slidesMedia[from];
        const inMedia = this.slidesMedia[to];
        if (outMedia) {
          outMedia.classList.add('is-leaving');
          outMedia.classList.remove('is-active');
        }
        if (inMedia) inMedia.classList.add('is-active');

        this.updateUI();
        this.swapText(from, to);

        const finish = () => {
          this.slidesMedia.forEach((m) => m.classList.remove('is-leaving'));
          this.busy = false;
          if (this.disconnected) return;
          if (this.pendingUpgrade) {
            this.pendingUpgrade = false;
            this.upgrade();
          }
          if (this.pending !== null) {
            const next = this.pending;
            this.pending = null;
            if (next !== this.current) {
              this.goTo(next);
              return;
            }
          }
          this.updateRunning();
        };

        if (this.glReady && this.gl) {
          this.gl.transition(from, to, this.transitionMs, finish);
        } else {
          const minimum = this.textAnimation === 'none' ? 0 : 600;
          this.later(finish, Math.max(this.fadeMs, minimum));
        }
      }

      updateUI() {
        this.navItems.forEach((item, i) => {
          const active = i === this.current;
          item.classList.toggle('is-active', active);
          if (active) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        });

        this.fills.forEach((fill, i) => {
          if (!fill) return;
          if (i !== this.current) fill.style.transform = 'scaleX(0)';
          else fill.style.transform = `scaleX(${this.autoplay ? Math.min(this.elapsed / this.interval, 1) : 1})`;
        });

        if (this.counterEl) this.counterEl.textContent = pad(this.current + 1);

        const activeItem = this.navItems[this.current];
        if (this.navList && activeItem && this.navList.scrollWidth > this.navList.clientWidth) {
          this.navList.scrollTo({ left: activeItem.offsetLeft - 6, behavior: this.reduced ? 'auto' : 'smooth' });
        }
      }

      /* ---------- Autoplay ---------- */
      canRun() {
        return this.autoplay && !this.disconnected && !this.busy && this.pauses.size === 0;
      }

      updateRunning() {
        if (this.canRun()) this.startTicker();
        else this.stopTicker();
        if (this.contentWrap) {
          this.contentWrap.setAttribute('aria-live', this.autoplay && !this.pauses.has('user') ? 'off' : 'polite');
        }
      }

      startTicker() {
        if (this.raf) return;
        this.last = performance.now();
        this.raf = requestAnimationFrame(this.tick);
      }

      stopTicker() {
        if (this.raf) cancelAnimationFrame(this.raf);
        this.raf = null;
      }

      tick = (now) => {
        this.raf = null;
        if (!this.canRun()) return;
        this.elapsed += Math.min(now - this.last, 100);
        this.last = now;
        const progress = Math.min(this.elapsed / this.interval, 1);
        const fill = this.fills[this.current];
        if (fill) fill.style.transform = `scaleX(${progress})`;
        if (progress >= 1) {
          this.goTo(this.current + 1);
          return;
        }
        this.raf = requestAnimationFrame(this.tick);
      };

      togglePause = () => {
        if (this.pauses.has('user')) this.pauses.delete('user');
        else this.pauses.add('user');
        this.updatePauseButton();
        this.updateRunning();
      };

      updatePauseButton() {
        if (!this.pauseBtn) return;
        if (!this.autoplay) {
          this.pauseBtn.hidden = true;
          return;
        }
        const paused = this.pauses.has('user');
        this.pauseBtn.dataset.paused = String(paused);
        this.pauseBtn.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      }

      /* ---------- Events ---------- */
      onIntersect = (entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        if (visible) {
          this.pauses.delete('offscreen');
          if (!this.introDone) {
            this.introDone = true;
            this.playIntro();
          }
          this.maybeStartWebGL();
        } else {
          this.pauses.add('offscreen');
        }
        this.updateRunning();
      };

      onResize = (entries) => {
        const rect = entries[0].contentRect;
        if (this.gl) this.gl.setSize(rect.width, rect.height);
      };

      onVisibility = () => {
        if (document.hidden) this.pauses.add('hidden');
        else this.pauses.delete('hidden');
        this.updateRunning();
      };

      onPointerEnter = (event) => {
        if (event.pointerType !== 'mouse' || this.dataset.pauseHover !== 'true') return;
        this.pauses.add('hover');
        this.updateRunning();
      };

      onPointerLeave = (event) => {
        if (event.pointerType !== 'mouse') return;
        this.pauses.delete('hover');
        this.updateRunning();
      };

      onFocusIn = (event) => {
        let keyboard = false;
        try {
          keyboard = event.target.matches(':focus-visible');
        } catch (e) {}
        if (!keyboard) return;
        this.pauses.add('focus');
        this.updateRunning();
      };

      onFocusOut = (event) => {
        if (this.contains(event.relatedTarget)) return;
        this.pauses.delete('focus');
        this.updateRunning();
      };

      onNavKeydown = (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const step = event.key === 'ArrowRight' ? 1 : -1;
        const next = (this.current + step + this.count) % this.count;
        this.goTo(next);
        if (this.navItems[next]) this.navItems[next].focus();
      };

      onBlockSelect = (event) => {
        if (!this.contains(event.target)) return;
        const panel = event.target.closest('.lumina__panel');
        const index = this.panels.indexOf(panel);
        if (index < 0) return;
        this.pauses.add('editor');
        this.goTo(index);
        this.updateRunning();
      };

      onBlockDeselect = (event) => {
        if (!this.contains(event.target)) return;
        this.pauses.delete('editor');
        this.updateRunning();
      };

      /* ---------- WebGL ---------- */
      maybeStartWebGL() {
        if (this.glTried) return;
        this.glTried = true;
        if (this.effect !== 'glass' || this.count < 2 || this.reduced || !this.canvas || !webglSupported()) return;

        const mobile = window.matchMedia('(max-width: 749px)').matches;
        const urls = this.slidesMedia.map((m) => {
          let url = (mobile && m.dataset.textureMobile) || m.dataset.texture || '';
          if (url.startsWith('//')) url = window.location.protocol + url;
          return url;
        });
        if (urls.some((url) => !url)) return; // a slide without an image: keep the crossfade

        const gl = new GlassRenderer(this.canvas, {
          preset: this.dataset.glassPreset,
          intensity: Number(this.dataset.intensity) || 1
        });
        this.gl = gl;
        this.canvas.addEventListener('webglcontextlost', this.onContextLost);

        gl.init(urls)
          .then(() => {
            if (this.gl !== gl) return;
            const rect = this.mediaWrap.getBoundingClientRect();
            gl.setSize(rect.width, rect.height);
            if (this.busy) this.pendingUpgrade = true;
            else this.upgrade();
          })
          .catch((error) => {
            console.warn('[Lumina slideshow] Glass effect unavailable, using crossfade.', error);
            if (this.gl === gl) this.teardownGL();
          });
      }

      upgrade() {
        if (!this.gl) return;
        this.gl.show(this.current);
        this.glReady = true;
        this.classList.add('is-webgl');
      }

      onContextLost = (event) => {
        event.preventDefault();
        this.teardownGL();
      };

      teardownGL() {
        if (!this.gl) return;
        const gl = this.gl;
        this.gl = null;
        this.glReady = false;
        this.classList.remove('is-webgl');
        if (this.canvas) this.canvas.removeEventListener('webglcontextlost', this.onContextLost);
        gl.dispose();
      }
    }

    customElements.define('lumina-slider', LuminaSlider);
  })();
</script>

