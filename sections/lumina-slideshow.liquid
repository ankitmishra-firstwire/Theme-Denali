{%- comment -%}
  Luxe Reel slideshow
  ---------------------------------------------------------------------------
  Shopify port of the React "lumina-interactive-list" component:
  full-width image slideshow with a WebGL "glass ripple" transition,
  animated titles (six reveal styles), a numbered counter and a progress
  rail that fills while each slide plays.

  - All class names use the "luxe-reel" namespace (BEM), so they can't
    clash with theme styles. CSS variables use the "--luxe-" prefix.
  - Glass transition uses three.js r128, loaded from cdnjs only when the
    section scrolls into view. Title animations use the browser's built-in
    Web Animations API (no GSAP).
  - If the glass effect can't run, slides crossfade instead. In the theme
    editor a small label in the top-left corner says which transition is
    running and why.
  - Typography: no font-family, font-style or font-weight is set. Titles use
    the theme's heading font, everything else the body font.

  File: sections/lumina-slideshow.liquid
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign slide_count = section.blocks.size

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_rgba = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  assign overlay_clear = section.settings.overlay_color | color_modify: 'alpha', 0
  case section.settings.overlay_style
    when 'solid'
      assign overlay_bg = overlay_rgba
    when 'gradient-bottom'
      assign overlay_bg = 'linear-gradient(to top, ' | append: overlay_rgba | append: ' 0%, ' | append: overlay_clear | append: ' 70%)'
    when 'gradient-left'
      assign overlay_bg = 'linear-gradient(to right, ' | append: overlay_rgba | append: ' 0%, ' | append: overlay_clear | append: ' 75%)'
    else
      assign overlay_bg = 'none'
  endcase

  assign desc_alpha = section.settings.description_opacity | divided_by: 100.0
  assign desc_color = section.settings.text_color | color_modify: 'alpha', desc_alpha
  assign rail_dim = section.settings.nav_color | color_modify: 'alpha', 0.5
  assign rail_track = section.settings.nav_color | color_modify: 'alpha', 0.25

  assign title_lh = section.settings.title_line_height | divided_by: 100.0
  assign title_ls = section.settings.title_letter_spacing | divided_by: 100.0
  assign intensity = section.settings.effect_intensity | divided_by: 100.0
  assign interval_ms = section.settings.slide_duration | times: 1000

  assign has_rail = false
  if section.settings.show_navigation and slide_count > 1
    assign has_rail = true
  endif
-%}

{% style %}
  .luxe-reel--{{ sid }} {
    --luxe-h: {{ section.settings.height_desktop }};
    --luxe-h-m: {{ section.settings.height_mobile }};
    --luxe-pad-x-d: {{ section.settings.padding_x }}px;
    --luxe-pad-x-m: {{ section.settings.padding_x_mobile }}px;
    --luxe-pad-y-d: {{ section.settings.padding_y }}px;
    --luxe-pad-y-m: {{ section.settings.padding_y_mobile }}px;
    --luxe-content-w: {{ section.settings.content_width }}px;
    --luxe-gap: {{ section.settings.content_spacing }}px;

    --luxe-headline-fs-d: {{ section.settings.title_size }}px;
    --luxe-headline-fs-m: {{ section.settings.title_size_mobile }}px;
    --luxe-headline-lh: {{ title_lh }};
    --luxe-headline-ls: {{ title_ls }}em;
    --luxe-blurb-fs-d: {{ section.settings.description_size }}px;
    --luxe-blurb-fs-m: {{ section.settings.description_size_mobile }}px;
    --luxe-rail-fs: {{ section.settings.nav_size }}px;
    --luxe-cta-fs: {{ section.settings.button_size }}px;
    --luxe-cta-radius: {{ section.settings.button_radius }}px;

    --luxe-bg: {{ section.settings.background }};
    --luxe-text: {{ section.settings.text_color }};
    --luxe-blurb: {{ desc_color }};
    --luxe-rail: {{ section.settings.nav_color }};
    --luxe-rail-dim: {{ rail_dim }};
    --luxe-track: {{ rail_track }};
    --luxe-meter: {{ section.settings.progress_color }};
    --luxe-cta-bg: {{ section.settings.button_background }};
    --luxe-cta-text: {{ section.settings.button_text }};
    --luxe-veil: {{ overlay_bg }};
  }
{% endstyle %}

{%- if slide_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="luxe-reel-empty">Add a slide to start building your slideshow.</div>
  {%- endif -%}
{%- else -%}
<luxe-reel
  class="luxe-reel luxe-reel--{{ sid }}{% if has_rail %} luxe-reel--has-rail{% endif %}"
  data-position="{{ section.settings.content_position }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ interval_ms }}"
  data-transition="{{ section.settings.transition_duration }}"
  data-effect="{{ section.settings.effect }}"
  data-glass-preset="{{ section.settings.glass_preset }}"
  data-intensity="{{ intensity }}"
  data-text-animation="{{ section.settings.text_animation }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-reduced-mode="{{ section.settings.reduced_motion_mode }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessible_label | escape }}"
>
  {%- comment -%} ===== Photos (crossfade layer + texture sources for the glass effect) ===== {%- endcomment -%}
  <div class="luxe-reel__media">
    {%- for block in section.blocks -%}
      {%- liquid
        assign img = block.settings.image
        assign img_m = block.settings.mobile_image
        assign tex = ''
        assign tex_m = ''
        if img != blank
          assign tex = img | image_url: width: 2000
        elsif block.settings.image_url != blank
          assign tex = block.settings.image_url
        endif
        if img_m != blank
          assign tex_m = img_m | image_url: width: 1200
        endif
        assign alt = block.settings.image_alt | default: img.alt | default: block.settings.title
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        else
          assign loading = 'lazy'
          assign priority = 'auto'
        endif
      -%}
      <div class="luxe-reel__frame{% if forloop.first %} luxe-reel__frame--current{% endif %}" data-texture="{{ tex | escape }}" data-texture-mobile="{{ tex_m | escape }}">
        {%- if img != blank -%}
          {%- assign focal = 'object-position: ' | append: img.presentation.focal_point -%}
          <picture>
            {%- if img_m != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w, {{ img_m | image_url: width: 1500 }} 1500w"
                sizes="100vw"
              >
            {%- endif -%}
            {{ img | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2500, 3000', sizes: '100vw', class: 'luxe-reel__photo', loading: loading, fetchpriority: priority, alt: alt, style: focal }}
          </picture>
        {%- elsif block.settings.image_url != blank -%}
          <img class="luxe-reel__photo" src="{{ block.settings.image_url | escape }}" alt="{{ alt | escape }}" loading="{{ loading }}" fetchpriority="{{ priority }}">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'luxe-reel__photo luxe-reel__photo--placeholder' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
    <canvas class="luxe-reel__glass" aria-hidden="true"></canvas>
    <div class="luxe-reel__veil"></div>
  </div>

  {%- comment -%} ===== Theme editor only: which transition is running ===== {%- endcomment -%}
  {%- if request.design_mode -%}
    <div class="luxe-reel__badge" data-luxe-status data-state="pending">Checking transition…</div>
  {%- endif -%}

  {%- comment -%} ===== Counter + pause button ===== {%- endcomment -%}
  {%- if slide_count > 1 -%}
    {%- if section.settings.show_counter or section.settings.autoplay -%}
      <div class="luxe-reel__hud">
        {%- if section.settings.show_counter -%}
          <div class="luxe-reel__count" aria-hidden="true">
            <span data-luxe-count>01</span>
            <span class="luxe-reel__count-rule"></span>
            <span>{% if slide_count < 10 %}0{% endif %}{{ slide_count }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.autoplay -%}
          <button type="button" class="luxe-reel__toggle" data-paused="false" aria-label="Pause slideshow">
            <svg data-icon="pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
            <svg data-icon="play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ===== Slide text ===== {%- endcomment -%}
  <div class="luxe-reel__stage" aria-live="off">
    <div class="luxe-reel__captions">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = section.settings.title_tag
          if tag == 'h1' and forloop.first == false
            assign tag = 'h2'
          endif
        -%}
        <div
          class="luxe-reel__caption"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          {{ block.shopify_attributes }}
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if block.settings.title != blank -%}
            <{{ tag }} class="luxe-reel__headline">{{ block.settings.title | escape }}</{{ tag }}>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="luxe-reel__blurb">{{ block.settings.description | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <div class="luxe-reel__cta-row">
              <a class="luxe-reel__cta luxe-reel__cta--{{ section.settings.button_style }}" href="{{ block.settings.button_link | default: '/collections/all' }}">
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===== Progress rail ===== {%- endcomment -%}
  {%- if has_rail -%}
    <div class="luxe-reel__rail" role="group" aria-label="Choose a slide">
      {%- for block in section.blocks -%}
        {%- assign tab_label = block.settings.nav_label | default: block.settings.title | default: 'Slide' -%}
        <button
          type="button"
          class="luxe-reel__tab{% if forloop.first %} luxe-reel__tab--current{% endif %}"
          aria-label="{{ tab_label | escape }}, slide {{ forloop.index }} of {{ forloop.length }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        >
          <span class="luxe-reel__track"><span class="luxe-reel__meter"></span></span>
          <span class="luxe-reel__tab-label">{{ tab_label | escape }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</luxe-reel>
{%- endif -%}

{% stylesheet %}
  /* No font-family, font-style or font-weight is defined in this section.
     Buttons use "font: inherit" only so they pick up the theme font instead
     of the browser's default button font. */

  .luxe-reel-empty {
    padding: 48px 20px;
    text-align: center;
    opacity: 0.7;
  }

  luxe-reel {
    display: block;
  }

  .luxe-reel {
    --luxe-pad-x: var(--luxe-pad-x-m);
    --luxe-pad-y: var(--luxe-pad-y-m);
    --luxe-headline-fs: var(--luxe-headline-fs-m);
    --luxe-blurb-fs: var(--luxe-blurb-fs-m);
    --luxe-hud-space: 52px;
    --luxe-rail-space: 0px;

    position: relative;
    overflow: hidden;
    isolation: isolate;
    height: calc(var(--luxe-h-m) * 1vh);
    height: calc(var(--luxe-h-m) * 1svh);
    min-height: 480px;
    background: var(--luxe-bg);
    color: var(--luxe-text);
  }

  .luxe-reel--has-rail {
    --luxe-rail-space: calc(var(--luxe-rail-fs) * 1.3 + 40px);
  }

  @media screen and (min-width: 750px) {
    .luxe-reel {
      --luxe-pad-x: var(--luxe-pad-x-d);
      --luxe-pad-y: var(--luxe-pad-y-d);
      --luxe-headline-fs: var(--luxe-headline-fs-d);
      --luxe-blurb-fs: var(--luxe-blurb-fs-d);
      height: calc(var(--luxe-h) * 1vh);
      height: calc(var(--luxe-h) * 1svh);
      min-height: 520px;
    }
  }

  .luxe-reel__sr {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Photos ---------- */
  .luxe-reel__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .luxe-reel__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--luxe-fade, 1000ms) ease;
  }

  .luxe-reel__frame--leaving {
    z-index: 1;
    opacity: 1;
    transition: none;
  }

  .luxe-reel__frame--current {
    z-index: 2;
    opacity: 1;
  }

  .luxe-reel__frame picture,
  .luxe-reel__photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .luxe-reel__photo {
    object-fit: cover;
  }

  .luxe-reel__photo--placeholder {
    background: rgba(255, 255, 255, 0.06);
    fill: rgba(255, 255, 255, 0.25);
  }

  .luxe-reel__glass {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .luxe-reel--glass-ready .luxe-reel__glass {
    opacity: 1;
  }

  .luxe-reel__veil {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: var(--luxe-veil);
    pointer-events: none;
  }

  /* ---------- Theme editor status label ---------- */
  .luxe-reel__badge {
    position: absolute;
    top: var(--luxe-pad-y);
    left: var(--luxe-pad-x);
    z-index: 5;
    max-width: min(420px, calc(100% - 2 * var(--luxe-pad-x) - 140px));
    padding: 6px 10px;
    font-size: 12px;
    line-height: 1.35;
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    pointer-events: none;
  }

  .luxe-reel__badge[data-state='ok'] {
    background: rgba(22, 101, 52, 0.85);
  }

  .luxe-reel__badge[data-state='fallback'] {
    background: rgba(146, 64, 14, 0.9);
  }

  /* ---------- Text ---------- */
  .luxe-reel__stage {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding:
      calc(var(--luxe-pad-y) + var(--luxe-hud-space))
      var(--luxe-pad-x)
      calc(var(--luxe-pad-y) + var(--luxe-rail-space));
    text-align: left;
    pointer-events: none;
  }

  .luxe-reel[data-position='bottom-center'] .luxe-reel__stage {
    justify-content: center;
    text-align: center;
  }

  .luxe-reel[data-position='middle-left'] .luxe-reel__stage {
    align-items: center;
  }

  .luxe-reel[data-position='middle-center'] .luxe-reel__stage {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .luxe-reel__captions {
    width: 100%;
    max-width: var(--luxe-content-w);
    pointer-events: auto;
  }

  .luxe-reel__caption[hidden] {
    display: none;
  }

  .luxe-reel .luxe-reel__headline {
    margin: 0;
    font-size: var(--luxe-headline-fs);
    line-height: var(--luxe-headline-lh);
    letter-spacing: var(--luxe-headline-ls);
    color: var(--luxe-text);
    text-wrap: balance;
  }

  .luxe-reel__word {
    display: inline-block;
    white-space: nowrap;
    perspective: 600px;
  }

  .luxe-reel__glyph {
    display: inline-block;
  }

  .luxe-reel .luxe-reel__blurb {
    margin: var(--luxe-gap) 0 0;
    max-width: 46ch;
    font-size: var(--luxe-blurb-fs);
    line-height: 1.5;
    color: var(--luxe-blurb);
  }

  .luxe-reel[data-position$='center'] .luxe-reel__blurb {
    margin-left: auto;
    margin-right: auto;
  }

  .luxe-reel__cta-row {
    margin-top: calc(var(--luxe-gap) * 1.5);
  }

  .luxe-reel__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.85em 1.75em;
    font-size: var(--luxe-cta-fs);
    line-height: 1.2;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--luxe-cta-radius);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .luxe-reel__cta--solid {
    background: var(--luxe-cta-bg);
    color: var(--luxe-cta-text);
  }

  .luxe-reel__cta--solid:hover {
    opacity: 0.85;
  }

  .luxe-reel__cta--outline {
    background: transparent;
    color: var(--luxe-text);
    border-color: var(--luxe-text);
  }

  .luxe-reel__cta--outline:hover {
    background: var(--luxe-text);
    color: var(--luxe-bg);
  }

  .luxe-reel__cta--link {
    min-height: 0;
    padding: 0;
    color: var(--luxe-text);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .luxe-reel__cta:focus-visible {
    outline: 2px solid var(--luxe-text);
    outline-offset: 3px;
  }

  /* Hide the first slide's text until its intro animation starts (JS only) */
  .luxe-reel--intro-pending .luxe-reel__caption:not([hidden]) .luxe-reel__glyph,
  .luxe-reel--intro-pending .luxe-reel__caption:not([hidden]) .luxe-reel__blurb,
  .luxe-reel--intro-pending .luxe-reel__caption:not([hidden]) .luxe-reel__cta-row {
    opacity: 0;
  }

  /* ---------- Counter + pause ---------- */
  .luxe-reel__hud {
    position: absolute;
    top: var(--luxe-pad-y);
    right: var(--luxe-pad-x);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--luxe-rail);
    font-size: var(--luxe-rail-fs);
    line-height: 1;
  }

  .luxe-reel__count {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .luxe-reel__count-rule {
    width: 28px;
    height: 1px;
    background: var(--luxe-track);
  }

  .luxe-reel__toggle {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    margin: 0;
    color: inherit;
    background: transparent;
    border: 1px solid var(--luxe-track);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .luxe-reel__toggle:hover {
    border-color: var(--luxe-rail);
  }

  .luxe-reel__toggle:focus-visible {
    outline: 2px solid var(--luxe-rail);
    outline-offset: 3px;
  }

  .luxe-reel__toggle[hidden] {
    display: none;
  }

  .luxe-reel__toggle svg {
    width: 14px;
    height: 14px;
  }

  .luxe-reel__toggle [data-icon='play'],
  .luxe-reel__toggle[data-paused='true'] [data-icon='pause'] {
    display: none;
  }

  .luxe-reel__toggle[data-paused='true'] [data-icon='play'] {
    display: block;
  }

  /* ---------- Progress rail ---------- */
  .luxe-reel__rail {
    position: absolute;
    left: var(--luxe-pad-x);
    right: var(--luxe-pad-x);
    bottom: var(--luxe-pad-y);
    z-index: 3;
    display: flex;
    gap: 16px;
    padding: 6px;
    margin: -6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .luxe-reel__rail::-webkit-scrollbar {
    display: none;
  }

  .luxe-reel__tab {
    appearance: none;
    flex: 1 0 120px;
    display: block;
    min-width: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--luxe-rail);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    .luxe-reel__rail {
      gap: 24px;
    }

    .luxe-reel__tab {
      flex: 1 1 0;
    }
  }

  .luxe-reel__track {
    display: block;
    height: 2px;
    overflow: hidden;
    background: var(--luxe-track);
    border-radius: 2px;
  }

  .luxe-reel__meter {
    display: block;
    height: 100%;
    background: var(--luxe-meter);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s ease;
  }

  .luxe-reel__tab--current .luxe-reel__meter {
    transition: none;
  }

  .luxe-reel__tab-label {
    display: block;
    margin-top: 10px;
    overflow: hidden;
    font-size: var(--luxe-rail-fs);
    line-height: 1.3;
    color: var(--luxe-rail-dim);
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }

  .luxe-reel__tab:hover .luxe-reel__tab-label,
  .luxe-reel__tab--current .luxe-reel__tab-label {
    color: var(--luxe-rail);
  }

  .luxe-reel__tab:focus-visible {
    outline: 2px solid var(--luxe-rail);
    outline-offset: 4px;
    border-radius: 2px;
  }
{% endstylesheet %}

{%- comment -%}
  The script sits right after the markup (not in a javascript tag) so the
  slideshow is set up before the first paint and the title never flashes.
{%- endcomment -%}
<script>
  (() => {
    if (customElements.get('luxe-reel')) return;

    const THREE_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canAnimate = typeof Element !== 'undefined' && typeof Element.prototype.animate === 'function';

    /* ---------- three.js loader (shared by every slideshow on the page) ---------- */
    const loadThree = () => {
      if (window.THREE) return Promise.resolve(window.THREE);
      if (!window.__luxeReelThree) {
        window.__luxeReelThree = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = THREE_SRC;
          script.async = true;
          script.onload = () => (window.THREE ? resolve(window.THREE) : reject(new Error('three.js loaded but is not available')));
          script.onerror = () => {
            window.__luxeReelThree = null;
            const error = new Error('three.js could not load from cdnjs.cloudflare.com');
            error.luxeReason = 'three.js could not load (blocked or offline)';
            reject(error);
          };
          document.head.appendChild(script);
        });
      }
      return window.__luxeReelThree;
    };

    const webglSupported = () => {
      try {
        const canvas = document.createElement('canvas');
        const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (!gl) return false;
        const lose = gl.getExtension('WEBGL_lose_context');
        if (lose) lose.loseContext();
        return true;
      } catch (e) {
        return false;
      }
    };

    /* ---------- Glass transition (from the original shader) ---------- */
    const GLASS_PRESETS = {
      subtle: { refraction: 0.6, chromatic: 0.5, clarity: 1.3, edgeGlow: 0.7, liquidFlow: 0.8 },
      default: { refraction: 1.0, chromatic: 1.0, clarity: 1.0, edgeGlow: 1.0, liquidFlow: 1.0 },
      crystal: { refraction: 1.5, chromatic: 1.8, clarity: 0.7, edgeGlow: 1.4, liquidFlow: 0.5 },
      liquid: { refraction: 0.8, chromatic: 0.4, clarity: 1.2, edgeGlow: 0.8, liquidFlow: 1.8 }
    };

    const VERTEX_SHADER = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;

    const FRAGMENT_SHADER = `
      uniform sampler2D uTexture1;
      uniform sampler2D uTexture2;
      uniform float uProgress;
      uniform vec2 uResolution;
      uniform vec2 uTexture1Size;
      uniform vec2 uTexture2Size;
      uniform float uIntensity;
      uniform float uRefraction;
      uniform float uChromatic;
      uniform float uClarity;
      uniform float uEdgeGlow;
      uniform float uLiquidFlow;
      varying vec2 vUv;

      vec2 coverUV(vec2 uv, vec2 size) {
        vec2 s = uResolution / size;
        float scale = max(s.x, s.y);
        vec2 scaled = size * scale;
        vec2 offset = (uResolution - scaled) * 0.5;
        return (uv * uResolution - offset) / scaled;
      }

      void main() {
        float progress = uProgress;
        float time = progress * 5.0;
        vec2 uv1 = coverUV(vUv, uTexture1Size);
        vec2 uv2 = coverUV(vUv, uTexture2Size);
        float maxR = length(uResolution) * 0.85;
        float br = progress * maxR;
        vec2 p = vUv * uResolution;
        vec2 c = uResolution * 0.5;
        float d = length(p - c);
        float nd = d / max(br, 0.001);
        float inside = 1.0 - smoothstep(br - 3.0, br + 3.0, d);

        vec4 nextImg = texture2D(uTexture2, uv2);
        vec4 img = nextImg;
        if (inside > 0.0) {
          float ro = 0.08 * uRefraction * uIntensity * pow(smoothstep(0.3 * uClarity, 1.0, nd), 1.5);
          vec2 dir = d > 0.0 ? (p - c) / d : vec2(0.0);
          vec2 duv = uv2 - dir * ro;
          duv += vec2(sin(time + nd * 10.0), cos(time * 0.8 + nd * 8.0)) * 0.015 * uLiquidFlow * nd * inside;
          float ca = 0.02 * uChromatic * uIntensity * pow(smoothstep(0.3, 1.0, nd), 1.2);
          img = vec4(
            texture2D(uTexture2, duv + dir * ca * 1.2).r,
            texture2D(uTexture2, duv + dir * ca * 0.2).g,
            texture2D(uTexture2, duv - dir * ca * 0.8).b,
            1.0
          );
          float rim = smoothstep(0.95, 1.0, nd) * (1.0 - smoothstep(1.0, 1.01, nd));
          img.rgb += rim * 0.08 * uEdgeGlow * uIntensity;
        }
        if (progress > 0.95) img = mix(img, nextImg, (progress - 0.95) / 0.05);
        gl_FragColor = mix(texture2D(uTexture1, uv1), img, inside);
      }
    `;

    class LuxeGlassRenderer {
      constructor(canvas, { preset, intensity }) {
        this.canvas = canvas;
        this.preset = GLASS_PRESETS[preset] || GLASS_PRESETS.default;
        this.intensity = intensity;
        this.textures = [];
        this.raf = null;
        this.doneCb = null;
        this.disposed = false;
      }

      async init(urls) {
        const THREE = await loadThree();
        if (this.disposed) throw new Error('Slideshow removed');

        const loader = new THREE.TextureLoader();
        loader.setCrossOrigin('anonymous');
        const load = (url) =>
          new Promise((resolve, reject) => {
            loader.load(
              url,
              (texture) => {
                texture.minFilter = THREE.LinearFilter;
                texture.magFilter = THREE.LinearFilter;
                texture.generateMipmaps = false;
                const image = texture.image;
                texture.userData = {
                  size: new THREE.Vector2(image.naturalWidth || image.width, image.naturalHeight || image.height)
                };
                resolve(texture);
              },
              undefined,
              () => {
                const error = new Error('Image could not be used for the glass effect: ' + url);
                error.luxeReason = 'an image host blocks cross-origin use (' + new URL(url, location.href).hostname + ')';
                reject(error);
              }
            );
          });

        this.textures = await Promise.all(urls.map(load));
        if (this.disposed) {
          this.textures.forEach((t) => t.dispose());
          throw new Error('Slideshow removed');
        }

        this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, antialias: false, alpha: false, powerPreference: 'high-performance' });
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.scene = new THREE.Scene();
        this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        const first = this.textures[0];
        this.uniforms = {
          uTexture1: { value: first },
          uTexture2: { value: first },
          uProgress: { value: 0 },
          uResolution: { value: new THREE.Vector2(1, 1) },
          uTexture1Size: { value: first.userData.size },
          uTexture2Size: { value: first.userData.size },
          uIntensity: { value: this.intensity },
          uRefraction: { value: this.preset.refraction },
          uChromatic: { value: this.preset.chromatic },
          uClarity: { value: this.preset.clarity },
          uEdgeGlow: { value: this.preset.edgeGlow },
          uLiquidFlow: { value: this.preset.liquidFlow }
        };
        this.geometry = new THREE.PlaneGeometry(2, 2);
        this.material = new THREE.ShaderMaterial({ uniforms: this.uniforms, vertexShader: VERTEX_SHADER, fragmentShader: FRAGMENT_SHADER });
        this.scene.add(new THREE.Mesh(this.geometry, this.material));
      }

      setSize(width, height) {
        if (!this.renderer || this.disposed || !width || !height) return;
        this.renderer.setSize(width, height, false);
        this.uniforms.uResolution.value.set(width, height);
        this.render();
      }

      show(index) {
        if (!this.renderer || this.disposed) return;
        const texture = this.textures[index];
        const u = this.uniforms;
        u.uTexture1.value = texture;
        u.uTexture2.value = texture;
        u.uTexture1Size.value = texture.userData.size;
        u.uTexture2Size.value = texture.userData.size;
        u.uProgress.value = 0;
        this.render();
      }

      transition(from, to, duration, done) {
        if (this.raf) cancelAnimationFrame(this.raf);
        const u = this.uniforms;
        const a = this.textures[from];
        const b = this.textures[to];
        u.uTexture1.value = a;
        u.uTexture1Size.value = a.userData.size;
        u.uTexture2.value = b;
        u.uTexture2Size.value = b.userData.size;
        u.uProgress.value = 0;
        this.doneCb = done;

        const start = performance.now();
        const step = (now) => {
          if (this.disposed) return;
          const t = Math.min((now - start) / duration, 1);
          u.uProgress.value = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; // power2.inOut
          this.render();
          if (t < 1) {
            this.raf = requestAnimationFrame(step);
          } else {
            this.raf = null;
            this.show(to);
            const cb = this.doneCb;
            this.doneCb = null;
            if (cb) cb();
          }
        };
        this.raf = requestAnimationFrame(step);
      }

      render() {
        if (this.renderer && !this.disposed) this.renderer.render(this.scene, this.camera);
      }

      dispose() {
        if (this.disposed) return;
        this.disposed = true;
        if (this.raf) cancelAnimationFrame(this.raf);
        this.raf = null;
        this.textures.forEach((t) => t.dispose());
        if (this.material) this.material.dispose();
        if (this.geometry) this.geometry.dispose();
        if (this.renderer) {
          this.renderer.dispose();
          this.renderer.forceContextLoss();
        }
        const cb = this.doneCb;
        this.doneCb = null;
        if (cb) cb();
      }
    }

    /* ---------- Title animations (match the original GSAP versions) ---------- */
    const EASE = {
      power3Out: 'cubic-bezier(0.215, 0.61, 0.355, 1)',
      power2Out: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
      power2In: 'cubic-bezier(0.55, 0.085, 0.68, 0.53)',
      back17: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
      back15: 'cubic-bezier(0.34, 1.45, 0.64, 1)'
    };

    const VARIANTS = {
      rise: { from: { opacity: 0, transform: 'translateY(20px)' }, to: { opacity: 1, transform: 'translateY(0)' }, duration: 800, stagger: 30, easing: EASE.power3Out },
      drop: { from: { opacity: 0, transform: 'translateY(-20px)' }, to: { opacity: 1, transform: 'translateY(0)' }, duration: 800, stagger: 30, easing: EASE.back17 },
      blur: { from: { opacity: 0, transform: 'scale(1.5)', filter: 'blur(10px)' }, to: { opacity: 1, transform: 'scale(1)', filter: 'blur(0px)' }, duration: 1000, random: 500, easing: EASE.power2Out },
      scale: { from: { opacity: 0, transform: 'scale(0)' }, to: { opacity: 1, transform: 'scale(1)' }, duration: 600, stagger: 50, easing: EASE.back15 },
      flip: { from: { opacity: 0, transform: 'rotateX(90deg)' }, to: { opacity: 1, transform: 'rotateX(0deg)' }, duration: 800, stagger: 40, easing: EASE.power2Out },
      slide: { from: { opacity: 0, transform: 'translateX(30px)' }, to: { opacity: 1, transform: 'translateX(0)' }, duration: 800, stagger: 30, easing: EASE.power3Out }
    };
    const ORDER = ['rise', 'drop', 'blur', 'scale', 'flip', 'slide'];

    const cancelAnims = (el) => {
      if (el.getAnimations) el.getAnimations().forEach((a) => a.cancel());
    };
    const pad = (n) => String(n).padStart(2, '0');

    /* ---------- Slideshow element ---------- */
    class LuxeReel extends HTMLElement {
      constructor() {
        super();
        this.pauses = new Set();
        this.timers = new Set();
        this.raf = null;
        this.bound = false;
      }

      later(fn, ms) {
        const id = setTimeout(() => {
          this.timers.delete(id);
          fn();
        }, ms);
        this.timers.add(id);
        return id;
      }

      connectedCallback() {
        this.captions = Array.from(this.querySelectorAll('.luxe-reel__caption'));
        this.count = this.captions.length;
        if (!this.count) return;

        this.disconnected = false;
        this.frames = Array.from(this.querySelectorAll('.luxe-reel__frame'));
        this.mediaWrap = this.querySelector('.luxe-reel__media');
        this.canvas = this.querySelector('.luxe-reel__glass');
        this.rail = this.querySelector('.luxe-reel__rail');
        this.tabs = Array.from(this.querySelectorAll('.luxe-reel__tab'));
        this.meters = this.tabs.map((tab) => tab.querySelector('.luxe-reel__meter'));
        this.countEl = this.querySelector('[data-luxe-count]');
        this.toggleBtn = this.querySelector('.luxe-reel__toggle');
        this.stage = this.querySelector('.luxe-reel__stage');
        this.statusEl = this.querySelector('[data-luxe-status]');

        const visible = this.captions.findIndex((c) => !c.hidden);
        this.current = visible < 0 ? 0 : visible;
        this.busy = false;
        this.elapsed = 0;
        this.pending = null;
        this.pendingUpgrade = false;
        this.gl = null;
        this.glReady = false;
        this.glTried = false;

        // Reduced motion: simplify unless the merchant chose full animation for everyone.
        this.systemReduced = reduceMotionQuery.matches;
        this.reduced = this.systemReduced && this.dataset.reducedMode !== 'full';

        this.autoplay = this.dataset.autoplay === 'true' && this.count > 1;
        this.interval = Math.max(1000, Number(this.dataset.interval) || 5000);
        this.transitionMs = Math.max(300, (Number(this.dataset.transition) || 2.5) * 1000);
        this.effect = this.dataset.effect || 'glass';
        this.textAnimation = this.reduced || !canAnimate ? 'none' : this.dataset.textAnimation || 'varied';
        this.fadeMs = this.reduced ? 400 : this.effect === 'fade' ? this.transitionMs : Math.min(this.transitionMs, 1200);
        this.style.setProperty('--luxe-fade', this.fadeMs + 'ms');

        this.captions.forEach((caption) => this.splitHeadline(caption));

        if (!this.bound) {
          this.bound = true;
          this.tabs.forEach((tab, i) => tab.addEventListener('click', () => this.goTo(i)));
          if (this.rail) this.rail.addEventListener('keydown', this.onRailKeydown);
          if (this.toggleBtn) this.toggleBtn.addEventListener('click', this.togglePause);

          // Hover pause only over the text, rail and counter, not the whole picture,
          // so a resting mouse on a full-screen slideshow doesn't stop it.
          const hoverZones = [this.querySelector('.luxe-reel__captions'), this.rail, this.querySelector('.luxe-reel__hud')].filter(Boolean);
          hoverZones.forEach((zone) => {
            zone.addEventListener('pointerenter', this.onPointerEnter);
            zone.addEventListener('pointerleave', this.onPointerLeave);
          });

          this.addEventListener('focusin', this.onFocusIn);
          this.addEventListener('focusout', this.onFocusOut);
        }

        document.addEventListener('visibilitychange', this.onVisibility);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        document.addEventListener('shopify:block:deselect', this.onBlockDeselect);

        // Wait until the section is on screen before playing anything.
        this.pauses.add('offscreen');
        if (this.textAnimation !== 'none' && !this.introDone) this.classList.add('luxe-reel--intro-pending');

        this.reportInitialStatus();

        this.io = new IntersectionObserver(this.onIntersect, { threshold: 0.15 });
        this.io.observe(this);
        if (window.ResizeObserver && this.mediaWrap) {
          this.ro = new ResizeObserver(this.onResize);
          this.ro.observe(this.mediaWrap);
        }

        this.updateUI();
        this.updateToggle();
        this.updateRunning();
      }

      disconnectedCallback() {
        this.disconnected = true;
        this.stopTicker();
        this.timers.forEach(clearTimeout);
        this.timers.clear();
        if (this.io) this.io.disconnect();
        if (this.ro) this.ro.disconnect();
        document.removeEventListener('visibilitychange', this.onVisibility);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
        this.teardownGL();
      }

      /* ---------- Status (theme editor label + console) ---------- */
      setStatus(text, state) {
        if (this.statusEl) {
          this.statusEl.textContent = text;
          this.statusEl.dataset.state = state;
        }
        if (state === 'fallback' && this.lastStatus !== text) console.warn('[Luxe reel] ' + text);
        this.lastStatus = text;
      }

      reportInitialStatus() {
        if (this.count < 2) return this.setStatus('Add a second slide to see transitions', 'fallback');
        if (this.effect !== 'glass') return this.setStatus('Transition: crossfade (chosen in settings)', 'ok');
        if (this.reduced) {
          return this.setStatus('Crossfade: this device has reduced motion turned on. Change "Reduced motion" in settings to show the full animation.', 'fallback');
        }
        this.setStatus('Glass ripple: waiting for the section to come into view…', 'pending');
      }

      /* Split the headline into glyphs for the animation; screen readers get the plain text. */
      splitHeadline(caption) {
        const headline = caption.querySelector('.luxe-reel__headline');
        if (!headline || headline.dataset.split) return;
        const text = headline.textContent.replace(/\s+/g, ' ').trim();
        headline.dataset.split = 'true';
        headline.textContent = '';

        const sr = document.createElement('span');
        sr.className = 'luxe-reel__sr';
        sr.textContent = text;

        const visual = document.createElement('span');
        visual.setAttribute('aria-hidden', 'true');
        const words = text.split(' ');
        words.forEach((word, i) => {
          const w = document.createElement('span');
          w.className = 'luxe-reel__word';
          for (const ch of word) {
            const g = document.createElement('span');
            g.className = 'luxe-reel__glyph';
            g.textContent = ch;
            w.appendChild(g);
          }
          visual.appendChild(w);
          if (i < words.length - 1) visual.appendChild(document.createTextNode(' '));
        });

        headline.append(sr, visual);
      }

      variantFor(index) {
        return this.textAnimation === 'varied' ? ORDER[index % ORDER.length] : this.textAnimation;
      }

      animateIn(caption, name, baseDelay = 0) {
        const v = VARIANTS[name] || VARIANTS.rise;
        const glyphs = caption.querySelectorAll('.luxe-reel__glyph');
        const stagger = Math.min(v.stagger || 0, 900 / Math.max(glyphs.length, 1));
        glyphs.forEach((g, i) => {
          cancelAnims(g);
          const delay = baseDelay + (v.random ? Math.random() * v.random : i * stagger);
          g.animate([v.from, v.to], { duration: v.duration, delay, easing: v.easing, fill: 'both' });
        });
        caption.querySelectorAll('.luxe-reel__blurb, .luxe-reel__cta-row').forEach((el, i) => {
          cancelAnims(el);
          el.animate(
            [{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 800, delay: baseDelay + 200 + i * 120, easing: EASE.power3Out, fill: 'both' }
          );
        });
      }

      animateOut(caption) {
        const glyphs = caption.querySelectorAll('.luxe-reel__glyph');
        const stagger = Math.min(20, 150 / Math.max(glyphs.length, 1));
        glyphs.forEach((g, i) => {
          cancelAnims(g);
          g.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-20px)' }],
            { duration: 350, delay: i * stagger, easing: EASE.power2In, fill: 'both' }
          );
        });
        caption.querySelectorAll('.luxe-reel__blurb, .luxe-reel__cta-row').forEach((el) => {
          cancelAnims(el);
          el.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-10px)' }],
            { duration: 400, easing: EASE.power2In, fill: 'both' }
          );
        });
      }

      resetCaption(caption) {
        caption.querySelectorAll('.luxe-reel__glyph, .luxe-reel__blurb, .luxe-reel__cta-row').forEach(cancelAnims);
      }

      playIntro() {
        if (this.textAnimation !== 'none') {
          const name = this.textAnimation === 'varied' ? 'rise' : this.textAnimation;
          this.animateIn(this.captions[this.current], name, 300);
        }
        this.classList.remove('luxe-reel--intro-pending');
      }

      swapText(from, to) {
        const out = this.captions[from];
        const incoming = this.captions[to];
        if (this.textAnimation === 'none') {
          out.hidden = true;
          incoming.hidden = false;
          return;
        }
        this.animateOut(out);
        this.later(() => {
          this.resetCaption(out);
          out.hidden = true;
          incoming.hidden = false;
          this.animateIn(incoming, this.variantFor(to));
        }, 500);
      }

      goTo(target) {
        if (this.count < 2) return;
        const to = ((target % this.count) + this.count) % this.count;
        if (to === this.current) return;
        if (this.busy) {
          this.pending = to;
          return;
        }

        if (!this.introDone) {
          this.introDone = true;
          this.classList.remove('luxe-reel--intro-pending');
        }

        const from = this.current;
        this.busy = true;
        this.current = to;
        this.elapsed = 0;
        this.stopTicker();

        const outFrame = this.frames[from];
        const inFrame = this.frames[to];
        if (outFrame) {
          outFrame.classList.add('luxe-reel__frame--leaving');
          outFrame.classList.remove('luxe-reel__frame--current');
        }
        if (inFrame) inFrame.classList.add('luxe-reel__frame--current');

        this.updateUI();
        this.swapText(from, to);

        const finish = () => {
          this.frames.forEach((f) => f.classList.remove('luxe-reel__frame--leaving'));
          this.busy = false;
          if (this.disconnected) return;
          if (this.pendingUpgrade) {
            this.pendingUpgrade = false;
            this.upgrade();
          }
          if (this.pending !== null) {
            const next = this.pending;
            this.pending = null;
            if (next !== this.current) {
              this.goTo(next);
              return;
            }
          }
          this.updateRunning();
        };

        if (this.glReady && this.gl) {
          this.gl.transition(from, to, this.transitionMs, finish);
        } else {
          const minimum = this.textAnimation === 'none' ? 0 : 600;
          this.later(finish, Math.max(this.fadeMs, minimum));
        }
      }

      updateUI() {
        this.tabs.forEach((tab, i) => {
          const active = i === this.current;
          tab.classList.toggle('luxe-reel__tab--current', active);
          if (active) tab.setAttribute('aria-current', 'true');
          else tab.removeAttribute('aria-current');
        });

        this.meters.forEach((meter, i) => {
          if (!meter) return;
          if (i !== this.current) meter.style.transform = 'scaleX(0)';
          else meter.style.transform = `scaleX(${this.autoplay ? Math.min(this.elapsed / this.interval, 1) : 1})`;
        });

        if (this.countEl) this.countEl.textContent = pad(this.current + 1);

        const activeTab = this.tabs[this.current];
        if (this.rail && activeTab && this.rail.scrollWidth > this.rail.clientWidth) {
          this.rail.scrollTo({ left: activeTab.offsetLeft - 6, behavior: this.reduced ? 'auto' : 'smooth' });
        }
      }

      /* ---------- Autoplay ---------- */
      canRun() {
        return this.autoplay && !this.disconnected && !this.busy && this.pauses.size === 0;
      }

      updateRunning() {
        if (this.canRun()) this.startTicker();
        else this.stopTicker();
        if (this.stage) {
          this.stage.setAttribute('aria-live', this.autoplay && !this.pauses.has('user') ? 'off' : 'polite');
        }
      }

      startTicker() {
        if (this.raf) return;
        this.last = performance.now();
        this.raf = requestAnimationFrame(this.tick);
      }

      stopTicker() {
        if (this.raf) cancelAnimationFrame(this.raf);
        this.raf = null;
      }

      tick = (now) => {
        this.raf = null;
        if (!this.canRun()) return;
        this.elapsed += Math.min(now - this.last, 100);
        this.last = now;
        const progress = Math.min(this.elapsed / this.interval, 1);
        const meter = this.meters[this.current];
        if (meter) meter.style.transform = `scaleX(${progress})`;
        if (progress >= 1) {
          this.goTo(this.current + 1);
          return;
        }
        this.raf = requestAnimationFrame(this.tick);
      };

      togglePause = () => {
        if (this.pauses.has('user')) this.pauses.delete('user');
        else this.pauses.add('user');
        this.updateToggle();
        this.updateRunning();
      };

      updateToggle() {
        if (!this.toggleBtn) return;
        if (!this.autoplay) {
          this.toggleBtn.hidden = true;
          return;
        }
        const paused = this.pauses.has('user');
        this.toggleBtn.dataset.paused = String(paused);
        this.toggleBtn.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      }

      /* ---------- Events ---------- */
      onIntersect = (entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        if (visible) {
          this.pauses.delete('offscreen');
          if (!this.introDone) {
            this.introDone = true;
            this.playIntro();
          }
          this.maybeStartGlass();
        } else {
          this.pauses.add('offscreen');
        }
        this.updateRunning();
      };

      onResize = (entries) => {
        const rect = entries[0].contentRect;
        if (this.gl) this.gl.setSize(rect.width, rect.height);
      };

      onVisibility = () => {
        if (document.hidden) this.pauses.add('hidden');
        else this.pauses.delete('hidden');
        this.updateRunning();
      };

      onPointerEnter = (event) => {
        if (event.pointerType !== 'mouse' || this.dataset.pauseHover !== 'true') return;
        this.pauses.add('hover');
        this.updateRunning();
      };

      onPointerLeave = (event) => {
        if (event.pointerType !== 'mouse') return;
        this.pauses.delete('hover');
        this.updateRunning();
      };

      onFocusIn = (event) => {
        let keyboard = false;
        try {
          keyboard = event.target.matches(':focus-visible');
        } catch (e) {}
        if (!keyboard) return;
        this.pauses.add('focus');
        this.updateRunning();
      };

      onFocusOut = (event) => {
        if (this.contains(event.relatedTarget)) return;
        this.pauses.delete('focus');
        this.updateRunning();
      };

      onRailKeydown = (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const step = event.key === 'ArrowRight' ? 1 : -1;
        const next = (this.current + step + this.count) % this.count;
        this.goTo(next);
        if (this.tabs[next]) this.tabs[next].focus();
      };

      onBlockSelect = (event) => {
        if (!this.contains(event.target)) return;
        const caption = event.target.closest('.luxe-reel__caption');
        const index = this.captions.indexOf(caption);
        if (index < 0) return;
        this.pauses.add('editor');
        this.goTo(index);
        this.updateRunning();
      };

      onBlockDeselect = (event) => {
        if (!this.contains(event.target)) return;
        this.pauses.delete('editor');
        this.updateRunning();
      };

      /* ---------- Glass (WebGL) ---------- */
      maybeStartGlass() {
        if (this.glTried) return;
        this.glTried = true;
        if (this.effect !== 'glass' || this.count < 2 || this.reduced || !this.canvas) return;

        if (!webglSupported()) {
          this.setStatus('Crossfade: WebGL is not available in this browser.', 'fallback');
          return;
        }

        const mobile = window.matchMedia('(max-width: 749px)').matches;
        const urls = this.frames.map((frame) => {
          let url = (mobile && frame.dataset.textureMobile) || frame.dataset.texture || '';
          if (url.startsWith('//')) url = window.location.protocol + url;
          return url;
        });
        const missing = urls.findIndex((url) => !url);
        if (missing >= 0) {
          this.setStatus(`Crossfade: slide ${missing + 1} has no image. Add an image to every slide for the glass effect.`, 'fallback');
          return;
        }

        this.setStatus('Glass ripple: loading images…', 'pending');

        const gl = new LuxeGlassRenderer(this.canvas, {
          preset: this.dataset.glassPreset,
          intensity: Number(this.dataset.intensity) || 1
        });
        this.gl = gl;
        this.canvas.addEventListener('webglcontextlost', this.onContextLost);

        gl.init(urls)
          .then(() => {
            if (this.gl !== gl) return;
            const rect = this.mediaWrap.getBoundingClientRect();
            gl.setSize(rect.width, rect.height);
            if (this.busy) this.pendingUpgrade = true;
            else this.upgrade();
          })
          .catch((error) => {
            if (this.gl !== gl) return;
            this.teardownGL();
            const reason = error.luxeReason || error.message;
            this.setStatus('Crossfade: glass effect unavailable because ' + reason + '.', 'fallback');
          });
      }

      upgrade() {
        if (!this.gl) return;
        this.gl.show(this.current);
        this.glReady = true;
        this.classList.add('luxe-reel--glass-ready');
        this.setStatus('Transition: glass ripple is active', 'ok');
      }

      onContextLost = (event) => {
        event.preventDefault();
        this.teardownGL();
        this.setStatus('Crossfade: the browser reset WebGL.', 'fallback');
      };

      teardownGL() {
        if (!this.gl) return;
        const gl = this.gl;
        this.gl = null;
        this.glReady = false;
        this.classList.remove('luxe-reel--glass-ready');
        if (this.canvas) this.canvas.removeEventListener('webglcontextlost', this.onContextLost);
        gl.dispose();
      }
    }

    customElements.define('luxe-reel', LuxeReel);
  })();
</script>

