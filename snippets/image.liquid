{%- doc -%}
  Renders a responsive image that respects the merchant's focal point.
  Optionally wraps the image in a link.

  @param {image} image - The image to render
  @param {string} [url] - Optional destination URL
  @param {string} [class] - Optional class for the wrapper
  @param {string} [image_class] - Optional class for the img element
  @param {number} [width] - Largest width to request (defaults to 1500)
  @param {string} [widths] - Comma-separated srcset widths
  @param {string} [sizes] - The sizes attribute
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [alt] - Alternative text override
  @param {boolean} [priority] - When true, sets fetchpriority="high" and eager loading

  @example
  {% render 'image', image: product.featured_media.preview_image, sizes: '50vw' %}
{%- enddoc -%}
{%- liquid
  assign max_width = width | default: 1500
  assign loading_attr = loading | default: 'lazy'
  assign fetch_priority = 'auto'
  if priority
    assign loading_attr = 'eager'
    assign fetch_priority = 'high'
  endif
  assign srcset_widths = widths | default: '360, 540, 720, 900, 1080, 1296, 1512'
  assign image_sizes = sizes | default: '100vw'
  assign alt_text = alt | default: image.alt
  assign focal_style = 'object-position: ' | append: image.presentation.focal_point | append: ';'
  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
-%}
{%- if image != blank -%}
  <{{ wrapper }} class="image {{ class }}"{% if url %} href="{{ url }}"{% endif %}>
    {{-
      image
      | image_url: width: max_width
      | image_tag:
        widths: srcset_widths,
        sizes: image_sizes,
        loading: loading_attr,
        fetchpriority: fetch_priority,
        alt: alt_text,
        class: image_class,
        style: focal_style
    -}}
  </{{ wrapper }}>
{%- endif -%}
