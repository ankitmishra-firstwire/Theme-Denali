        "default": "tight"
      },
      {
        "type": "select",
        "id": "heading_text_case",
        "label": "Text case",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
