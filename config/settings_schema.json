          {
            "value": "zoom",
            "label": "Image zoom"
          },
          {
            "value": "lift",
            "label": "Lift"
          }
        ],
        "default": "zoom",
        "info": "Applies to product, collection and blog cards."
      },
      {
        "type": "paragraph",
        "content": "Animations are turned off automatically for customers who have enabled reduced motion on their device."
      }
