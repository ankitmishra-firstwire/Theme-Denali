        "default": "none"
      },
      {
        "type": "header",
        "content": "Subheadings"
      },
      {
        "type": "select",
        "id": "subheading_text_case",
        "label": "Text case",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "default": "uppercase"
