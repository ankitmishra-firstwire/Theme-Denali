[
  {
    "name": "theme_info",
    "theme_name": "Denali",
    "theme_version": "1.0.0",
    "theme_author": "Denali Themes",
    "theme_documentation_url": "https://example.com/denali/docs",
    "theme_support_url": "https://example.com/denali/support"
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Desktop logo width",
        "info": "Portrait logos are also limited by the header height.",
        "default": 140
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 40,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Mobile logo width",
        "default": 100
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Displayed at 32 × 32 px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the background color when set."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#1E2A26"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#2F5D50"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Primary button background",
            "default": "#2F5D50"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Primary button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button label",
            "default": "#2F5D50"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders",
            "default": "#D9DED9"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      },
      {
        "type": "header",
        "content": "Status colors"
      },
      {
        "type": "color",
        "id": "sale_badge_background",
        "label": "Sale badge background",
        "default": "#A33131"
      },
      {
        "type": "color",
        "id": "sale_badge_text",
        "label": "Sale badge text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "sold_out_badge_background",
        "label": "Sold out badge background",
        "default": "#1E2A26"
      },
      {
        "type": "color",
        "id": "sold_out_badge_text",
        "label": "Sold out badge text",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Font",
        "default": "work_sans_n6"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Font size scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Font size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "1200px", "label": "Narrow" },
          { "value": "1440px", "label": "Standard" },
          { "value": "1680px", "label": "Wide" }
        ],
        "default": "1440px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Page margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section spacing on desktop",
        "info": "Automatically reduced on mobile.",
        "default": 72
      }
    ]
  },
  {
    "name": "Buttons and inputs",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 2
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "adapt", "label": "Adapt to image" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "square", "label": "Square" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_badges",
        "label": "Show sale and sold out badges",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable search suggestions",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "label": "Show product price in suggestions",
        "default": true
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "paragraph",
        "content": "Cart and checkout prices always show currency codes."
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "placeholder": "https://facebook.com/shopify" },
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "placeholder": "https://instagram.com/shopify" },
      { "type": "text", "id": "social_pinterest_link", "label": "Pinterest", "placeholder": "https://pinterest.com/shopify" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok", "placeholder": "https://tiktok.com/@shopify" },
      { "type": "text", "id": "social_twitter_link", "label": "X (Twitter)", "placeholder": "https://x.com/shopify" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube", "placeholder": "https://youtube.com/shopify" }
    ]
  }
]
